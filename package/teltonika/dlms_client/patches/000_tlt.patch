-    struct hostent* phe;
-    char ac[80];
-    if ((ret = gethostname(ac, sizeof(ac))) != -1)
-    {
-        phe = gethostbyname(ac);
-        if (phe == 0)
-        {
-            ret = 0;
-        }
-        else
-        {
-            struct in_addr* addr = (struct in_addr*)phe->h_addr_list[0];
-#if defined(_WIN32) || defined(_WIN64)//If Windows
-            return addr->S_un.S_addr;
-#else //or Linux
-            return addr->s_addr;
-#endif
-        }
-    }
-#else
-    //If no OS get IP.
-#endif
-    return ret;
-}
