-	                                                                    ? 9                                                                                                                                                                                                                                                                                                                        \
-	                                                                    : ((u) & (1ul << 21))                                                                                                                                                                                                                                                                                                      \
-	                                                                          ? 10                                                                                                                                                                                                                                                                                                                 \
