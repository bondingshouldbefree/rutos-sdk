-            if ((ret = bb_getUInt8(&data->data, &ch)) != 0)
-            {
-                break;
-            }
-            if (ch != 0)
-            {
-                ret = ch;
-            }
-        }
-    }
-    else
-    {
-        //Invalid data type.
-        ret = DLMS_ERROR_CODE_INVALID_PARAMETER;
-    }
-    return ret;
