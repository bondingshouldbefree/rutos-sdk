-    settings->defaultClock = NULL;
-#endif //DLMS_IGNORE_CLOCK
-    settings->dataReceived = 0;
-    settings->frameReceived = 0;
-    resetFrameSequence(&settings->base);
-    settings->pushClientAddress = 0;
