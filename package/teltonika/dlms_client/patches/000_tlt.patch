+static int cfg_pick_unique_config_id(cfgx_context_t *ctx)
+{
+	int id = 1;
+
+	while (true) {
+		if (id == INT_MAX) {
+			return -1;
+		}
+
+		char id_str[16] = { 0 };
+		snprintf(id_str, sizeof(id_str), "%d", id);
+		if (cfgx_context_find_by_id(ctx, id_str) == NULL) {
+			break;
+		}
+		id += 1;
+	}
+
+	return id;
+}
