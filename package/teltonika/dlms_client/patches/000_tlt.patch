+static connection_params_cfg *cfg_read_connection(cfgx_context_t *ctx, struct cfgx_section *section)
+{
+	SEPARATOR;
+	connection_params_cfg *connection_params = NULL;
+
+	connection_params = calloc(1, sizeof(connection_params_cfg));
+	if (!connection_params) {
+		ERROR("Unable to allocate memory");
+		goto err;
+	}
+
+	if (!section->id) {
+		log(L_ERROR, "Failed to find section name");
+		goto err;
+	}
+
+	log(L_NOTICE, "Reading connection ('%s')", section->id);
+
+	connection_params->id = strtol(section->id, NULL, 10);
+	if (!connection_params->id) {
+		log(L_ERROR, "Section ID can not be 0");
+		goto err;
+	}
+
+	connection_params->enabled = cfgx_section_get_i64(ctx, section, "enabled", 0, 1, 0);
+
+	connection_params->name = cfgx_section_get_string(ctx, section, "name");
+
+	int64_t connection_type = cfgx_section_get_i64(ctx, section, "connection_type", 0, 1, -1);
+	if (connection_type == -1) {
+		log(L_ERROR, "Option 'connection_type' is outside range [0;1]");
+		goto err;
+	}
+	connection_params->type = connection_type;
+
+	if (connection_params->type == TCP_CFG) {
+		char *host = cfgx_section_get_string(ctx, section, "address");
+		if (!host) {
+			log(L_ERROR, "Option 'address' cannot be empty");
+			goto err;
+		}
+		connection_params->parameters.tcp.host = host;
+
+		int64_t port = cfgx_section_get_i64(ctx, section, "port", 1, 65535, -1);
+		if (port == -1) {
+			log(L_ERROR, "Option 'port' cannot be empty [1;65535]");
+			goto err;
+		}
+		connection_params->parameters.tcp.port = port;
+
+		int persistent = cfgx_section_get_i64(ctx, section, "persistent", 0, 1, -1);
+		if (persistent == -1) {
+			log(L_ERROR, "Option 'persistent' (%d) is outside range [0;1]", persistent);
+			goto err;
+		}
+		connection_params->parameters.tcp.persistent = persistent;
+	} else if (connection_params->type == SERIAL_CFG) {
+		struct libtlt_termios_settings *s = &connection_params->parameters.serial;
+		if (ltermios_read_settings_cfgx(s, ctx, section)) {
+			log(L_ERROR, "ltermios_read_settings error: %s\n", s->error);
+			goto err;
+		}
+	}
+
+	connection_params->timeout = cfgx_section_get_i64(ctx, section, "timeout", 0, INT32_MAX, DEFAULT_CONNECTION_TIMEOUT_MS);
+	connection_params->wait_time = 5000;
+
+	connection_params->inter_request_delay_ms = cfgx_section_get_i64(ctx, section, "delay", 0, INT32_MAX, 0);
+	connection_params->disconnect_delay_ms = cfgx_section_get_i64(ctx, section, "disconnect_delay", 0, INT32_MAX, 0);
+
+	log(L_NOTICE, "Connection ('%s', '%s') successfully added", section->id, UTL_SAFE_STR(connection_params->name));
+	return connection_params;
+err:
+	log(L_NOTICE, "Failed to add connection ('%s', '%s')", section->id, UTL_SAFE_STR(connection_params->name));
+	cfg_free_connection_cfg(connection_params);
+	return NULL;
+}
+
+static physical_device_cfg *cfg_read_physical_device(cfgx_context_t *ctx, struct cfgx_section *section)
+{
+	SEPARATOR;
+	physical_device_cfg *dev = NULL;
+
+	dev = calloc(1, sizeof(physical_device_cfg));
+	if (!dev) {
+		ERROR("Unable to allocate memory");
+		goto err;
+	}
+
+	if (!section->id) {
+		log(L_ERROR, "Failed to find section name");
+		goto err;
+	}
+
+	log(L_NOTICE, "Reading physical device ('%s')", section->id);
+
+	dev->id = strtol(section->id, NULL, 10);
+	if (!dev->id) {
+		log(L_ERROR, "Section ID can not be 0");
+		goto err;
+	}
+
+	dev->enabled = cfgx_section_get_i64(ctx, section, "enabled", 0, 1, 0);
+
+	dev->name = cfgx_section_get_string(ctx, section, "name");
+	if (!dev->name) {
+		log(L_ERROR, "Option 'name' is missing");
+		goto err;
+	}
+
+	dev->server_address = cfgx_section_get_i64(ctx, section, "server_addr", 0, INT32_MAX, -1);
+	if (dev->server_address < 0) {
+		log(L_ERROR, "Option 'server_addr' cannot be < 0");
+		goto err;
+	}
+
+	dev->server_address_type = cfgx_section_get_i64(ctx, section, "server_addr_type", 0, INT32_MAX, 0);
+	dev->logical_server_address = cfgx_section_get_i64(ctx, section, "log_server_addr", 0, INT32_MAX, -1);
+	if (dev->logical_server_address < 0) {
+		log(L_ERROR, "Option 'log_server_addr' cannot be < 0");
+		goto err;
+	}
+
+	dev->client_address = cfgx_section_get_i64(ctx, section, "client_addr", 0, INT32_MAX, -1);
+	if (dev->client_address < 0) {
+		log(L_ERROR, "Option 'client_addr' cannot be < 0");
+		goto err;
+	}
+
+	dev->logical_name_ref = cfgx_section_get_i64(ctx, section, "use_ln_ref", 0, 1, 1);
+
+	dev->connection = cfgx_section_get_i64(ctx, section, "connection", 1, INT32_MAX, 0);
+	if (!dev->connection) {
+		log(L_ERROR, "Option 'connection' can not be 0");
+		goto err;
+	}
+
+	dev->interface_type = cfgx_section_get_i64(ctx, section, "interface", 0, INT32_MAX, -1);
+	if (dev->interface_type == -1) {
+		log(L_NOTICE, "Option 'interface_type' is empty");
+		goto err;
+	}
+
+	dev->access_security = cfgx_section_get_i64(ctx, section, "access_security", 0, INT32_MAX, -1);
+	if (dev->access_security == -1) {
+		log(L_NOTICE, "Option 'access_security'is empty");
+		goto err;
+	}
+
+	if (dev->access_security > DLMS_AUTHENTICATION_NONE && dev->access_security <= DLMS_AUTHENTICATION_HIGH_SHA256 && dev->access_security != DLMS_AUTHENTICATION_HIGH_GMAC) {
+		dev->password = cfgx_section_get_string(ctx, section, "password");
+		if (!dev->password) {
+			log(L_NOTICE, "Option 'password' invalid");
+			goto err;
+		}
+	}
+
+	dev->transport_security = cfgx_section_get_i64(ctx, section, "transport_security", 0, INT32_MAX, -1);
+	if (dev->transport_security == -1) {
+		log(L_NOTICE, "Option 'transport_security' is NONE");
+		goto err;
+	}
+
+	if (dev->transport_security > 0) {
+		dev->authentication_key = cfgx_section_get_string(ctx, section, "authentication_key");
+		if (!dev->authentication_key || utl_validate_key(dev->authentication_key, KEY_SIZE)) {
+			log(L_NOTICE, "Option 'authentication_key' is empty or value is invalid");
+		}
+
+		dev->block_cipher_key = cfgx_section_get_string(ctx, section, "block_cipher_key");
+		if (!dev->block_cipher_key || utl_validate_key(dev->block_cipher_key, KEY_SIZE)) {
+			log(L_NOTICE, "Option 'block_cipher_key' is empty or value is invalid");
+		}
+
+		dev->dedicated_key = cfgx_section_get_string(ctx, section, "dedicated_key");
+		if (!dev->dedicated_key || utl_validate_key(dev->dedicated_key, KEY_SIZE)) {
+			log(L_NOTICE, "Option 'dedicated_key' is empty or value is invalid");
+		}
+
+		dev->invocation_counter = cfgx_section_get_string(ctx, section, "invocation_counter");
+		if (!dev->invocation_counter) {
+			log(L_NOTICE, "Option 'invocation_counter' is invalid");
+			goto err;
+		}
+	}
+
+	log(L_NOTICE, "Physical device ('%s', '%s') is successfully added", section->id, UTL_SAFE_STR(dev->name));
+	return dev;
+err:
+	log(L_NOTICE, "Failed to add physical device ('%s', '%s')", section->id, UTL_SAFE_STR(dev->name));
+	cfg_free_physical_device_cfg(dev);
+	return NULL;
+}
+
+static cosem_object_cfg *cfg_read_cosem_object(cfgx_context_t *ctx, struct cfgx_section *section)
+{
+	SEPARATOR;
+	cosem_object_cfg *cosem = NULL;
+
+	cosem = calloc(1, sizeof(cosem_object_cfg));
+	if (!cosem) {
+		ERROR("Unable to allocate memory");
+		goto err;
+	}
+
+	if (!section->id) {
+		log(L_ERROR, "Failed to find section name");
+		goto err;
+	}
+
+	log(L_NOTICE, "Reading COSEM object ('%s')", section->id);
+
+	cosem->id = strtol(section->id, NULL, 10);
+	if (!cosem->id) {
+		log(L_ERROR, "Section ID can not be 0");
+		goto err;
+	}
+
+	cosem->enabled = cfgx_section_get_i64(ctx, section, "enabled", 0, 1, 0);
+	if (!cosem->enabled) {
+		log(L_ERROR, "COSEM object ('%d') is disabled", cosem->id);
+		goto err;
+	}
+
+	cosem->name = cfgx_section_get_string(ctx, section, "name");
+	if (!cosem->name) {
+		log(L_ERROR, "COSEM object ('%d') is missing name", cosem->id);
+		goto err;
+	}
+
+	char *logical_name = cfgx_section_get_string(ctx, section, "logical_name");
+	if (logical_name != NULL) {
+		int parse_error = hlp_setLogicalName(cosem->logical_name, logical_name);
+		free(logical_name);
+
+		if (parse_error != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to parse option 'logical_name'");
+			goto err;
+		}
+		cosem->has_logical_name = true;
+	}
+
+	int64_t short_name = cfgx_section_get_i64(ctx, section, "short_name", 0, UINT16_MAX, -1);
+	if (short_name != -1) {
+		cosem->short_name = short_name;
+		cosem->has_short_name = true;
+	}
+
+	if (!cosem->has_short_name && !cosem->has_logical_name) {
+		log(L_ERROR, "Option 'logical_name' or 'short_name' must be defined");
+		goto err;
+	}
+
+	cosem->cosem_id = cfgx_section_get_i64(ctx, section, "cosem_id", 0, 72, -1);
+	if (cosem->cosem_id == -1) {
+		log(L_ERROR, "Option 'cosem_id' is not supported");
+		goto err;
+	}
+
+	if (cosem_getObjectSize(cosem->cosem_id) == 0) {
+		log(L_ERROR, "Option 'cosem_id' is not supported");
+		goto err;
+	}
+
+	if (cosem->cosem_id == DLMS_OBJECT_TYPE_PROFILE_GENERIC) {
+		cosem->entries = cfgx_section_get_i64(ctx, section, "entries", 1, INT32_MAX, 0);
+		if (cosem->entries < 1) {
+			log(L_ERROR, "Option 'entries' (%d) can not be < 1", cosem->entries);
+			goto err;
+		}
+	}
+
+	if (cfgx_section_get_string_list(ctx, section, "physical_device", &cosem->physical_devices) || cosem->physical_devices.len == 0) {
+		log(L_ERROR, "Option 'physical_device' can not be empty");
+		goto err;
+	}
+
+	cosem->attributes = cfgx_section_get_string(ctx, section, "attributes");
+	if (!cosem->attributes) {
+		log(L_WARNING, "Option 'attributes' is empty, reading all attributes");
+	}
+
+	cosem->cosem_group = cfgx_section_get_i64(ctx, section, "cosem_group", 1, INT32_MAX, 0);
+	if (!cosem->cosem_group) {
+		log(L_ERROR, "Option 'cosem_group' can not be 0");
+		goto err;
+	}
+
+	log(L_NOTICE, "COSEM object ('%s', '%s') successfully added", section->id, UTL_SAFE_STR(cosem->name));
+	return cosem;
+err:
+	log(L_NOTICE, "Failed to add COSEM object ('%s', '%s')", section->id, UTL_SAFE_STR(cosem->name));
+	cfg_free_cosem_object_cfg(cosem);
+	return NULL;
+}
+
+static cosem_group_cfg *cfg_read_cosem_group(cfgx_context_t *ctx, struct cfgx_section *section)
+{
+	SEPARATOR;
+	cosem_group_cfg *cosem_group = NULL;
+
+	cosem_group = calloc(1, sizeof(cosem_group_cfg));
+	if (!cosem_group) {
+		log(L_ERROR, "Failed to allocate memory for cosem_group struct");
+		return NULL;
+	}
+
+	if (!section->id) {
+		log(L_ERROR, "Failed to find section name");
+		goto err;
+	}
+
+	log(L_NOTICE, "Reading COSEM group ('%s')", section->id);
+
+	cosem_group->id = strtol(section->id, NULL, 10);
+	if (!cosem_group->id) {
+		log(L_ERROR, "Section ID can not be 0");
+		goto err;
+	}
+
+	cosem_group->enabled = cfgx_section_get_i64(ctx, section, "enabled", 0, 1, 0);
+	if (!cosem_group->enabled) {
+		log(L_ERROR, "COSEM group ('%d') is disabled", cosem_group->id);
+		goto err;
+	}
+
+	cosem_group->name = cfgx_section_get_string(ctx, section, "name");
+
+	cosem_group->interval = cfgx_section_get_i64(ctx, section, "interval", 1, INT32_MAX, 60);
+
+	log(L_NOTICE, "COSEM group ('%s', '%s') is successfully added", section->id, UTL_SAFE_STR(cosem_group->name));
+	return cosem_group;
+err:
+	log(L_NOTICE, "Failed to add COSEM group ('%s', '%s')", section->id, UTL_SAFE_STR(cosem_group->name));
+	cfg_free_cosem_group_cfg(cosem_group);
+	return NULL;
+}
+
+static service *cfg_read_service(dlms_cfg *cfg, shared_memory_ctx *shared)
+{
+	service *s		  = NULL;
+	size_t connection_count	  = 0;
+	size_t physical_dev_count = 0;
+	size_t cosem_object_count = 0;
+	size_t cosem_group_count  = 0;
+
+	s = calloc(1, sizeof(service));
+	if (!s) {
+		log(L_ERROR, "Failed to allocate memory for main struct");
+		return NULL;
+	}
+
+	connection **connections = cfg_get_connections(cfg, &connection_count, shared);
+	if (!connections) {
+		log(L_ERROR, "Failed to transfer connections from dlms_cfg to main");
+		return NULL;
+	}
+
+	physical_device **physical_devices =
+		cfg_get_physical_devices(cfg, connections, connection_count, &physical_dev_count);
+	if (!physical_devices) {
+		log(L_ERROR, "Failed to transfer physical devices from dlms_cfg to main");
+		return NULL;
+	}
+
+	cosem_object **cosem_objects =
+		cfg_get_cosem_objects(cfg, physical_devices, physical_dev_count, &cosem_object_count);
+	cosem_group **cosem_groups =
+		cfg_get_cosem_groups(cfg, cosem_objects, cosem_object_count, &cosem_group_count);
+
+	s->connections	      = connections;
+	s->connection_count   = connection_count;
+
+	s->physical_devices   = physical_devices;
+	s->physical_dev_count = physical_dev_count;
+
+	s->cosem_groups	      = cosem_groups;
+	s->cosem_group_count  = cosem_group_count;
+
+	s->cosem_object_count = cosem_object_count;
+	s->cosem_objects      = cosem_objects;
+
+	return s;
+}
+
+static connection **cfg_get_connections(dlms_cfg *cfg, size_t *connection_count, shared_memory_ctx *shared)
+{
+	connection **connections = calloc(cfg->connection_cfg_count, sizeof(connection *));
+	if (!connections) {
+		log(L_ERROR, "Failed to allocate memory for connections struct");
+		return NULL;
+	}
+
+	for (size_t i = 0; i < cfg->connection_cfg_count; i++) {
+		connection *conn = cfg_get_connection(cfg->connections[i], shared);
+		if (conn) {
+			connections[(*connection_count)++] = conn;
+		}
+	}
+
+	if (!(*connection_count)) {
+		free(connections);
+		return NULL;
+	}
+
+	return connections;
+}
+
+static connection *cfg_get_connection(connection_params_cfg *cfg, shared_memory_ctx *shared)
+{
+	connection *conn = calloc(1, sizeof(connection));
+	if (!conn) {
+		ERROR("Failed to allocate memory for connection struct");
+		return NULL;
+	}
+
+	conn->type    = (int)cfg->type;
+	conn->id      = cfg->id;
+	conn->name    = strdup(UTL_SAFE_STR(cfg->name));
+	if (!conn->name) {
+		ERROR("Failed to duplicate a string: Out of memory");
+		goto err;
+	}
+
+	if (cfg->type == TCP_CFG) {
+		conn->parameters.tcp.persistent = cfg->parameters.tcp.persistent != 0;
+		conn->parameters.tcp.port = cfg->parameters.tcp.port;
+		conn->parameters.tcp.host = strdup(cfg->parameters.tcp.host);
+		if (!conn->parameters.tcp.host) {
+			ERROR("Failed to duplicate a string: Out of memory");
+			goto err;
+		}
+	} else if (cfg->type == SERIAL_CFG) {
+		conn->parameters.serial = cfg->parameters.serial;
+	} else {
+		ERROR("Connection ('%d', '%s') has invalid connection type", conn->id, UTL_SAFE_STR(conn->name));
+		goto err;
+	}
+
+	conn->socket	= -1;
+	conn->wait_time = cfg->wait_time;
+	conn->timeout	= cfg->timeout;
+	conn->inter_request_delay_ms = cfg->inter_request_delay_ms;
+	conn->disconnect_delay_ms = cfg->disconnect_delay_ms;
+
+	if (com_init(conn, shared)) {
+		ERROR("Failed to allocate byte buffer for connection");
+		goto err;
+	}
+
+	return conn;
+err:
+	cfg_free_connection(conn);
+	return NULL;
+}
+
+static physical_device **cfg_get_physical_devices(dlms_cfg *cfg, connection **connections, size_t connection_count, size_t *physical_dev_count)
+{
+	physical_device **devices = calloc(cfg->physical_device_cfg_count, sizeof(physical_device *));
+	if (!devices) {
+		log(L_ERROR, "Failed to allocate memory for devices struct");
+		return NULL;
+	}
+
+	for (size_t i = 0; i < cfg->physical_device_cfg_count; i++) {
+		physical_device_cfg *dev_cfg = cfg->physical_devices[i];
+		physical_device *dev = cfg_get_physical_device(dev_cfg);
+		if (dev) {
+			dev->connection = find_connection_by_id(dev_cfg->connection, connections, connection_count);
+			devices[(*physical_dev_count)++] = dev;
+		}
+	}
+
+	if (!(*physical_dev_count)) {
+		free(devices);
+		return NULL;
+	}
+
+	return devices;
+}
+
+static physical_device *cfg_get_physical_device(physical_device_cfg *cfg)
+{
+	physical_device *dev = calloc(1, sizeof(physical_device));
+	if (!dev) {
+		log(L_ERROR, "Failed to allocate memory for device struct");
+		return NULL;
+	}
+
+	dev->id	     = cfg->id;
+	dev->name    = strdup(UTL_SAFE_STR(cfg->name));
+	if (!dev->name) {
+		ERROR("Failed to duplicate a string: Out of memory");
+		goto err;
+	}
+
+	if (cfg->invocation_counter) {
+		dev->invocation_counter = strdup(cfg->invocation_counter);
+		if (!dev->invocation_counter) {
+			ERROR("Failed to duplicate a string: Out of memory");
+			goto err;
+		}
+	}
+
+	if (cfg->server_address_type == 0) {
+		cfg->server_address = cl_getServerAddress(cfg->logical_server_address, cfg->server_address, 0);
+	} else {
+		cfg->server_address = utl_get_server_address_from_serial_number(cfg->logical_server_address, cfg->server_address);
+	}
+
+	cl_init(&dev->settings, cfg->logical_name_ref, cfg->client_address, cfg->server_address,
+		cfg->access_security, cfg->password, cfg->interface_type);
+
+	dev->settings.cipher.security = cfg->transport_security;
+
+	if (cfg->authentication_key) {
+		bb_clear(&dev->settings.cipher.authenticationKey);
+		if (bb_addHexString(&dev->settings.cipher.authenticationKey, cfg->authentication_key)) {
+			ERROR("Failed to add hex string for authentication key");
+			goto err;
+		}
+	}
+
+	if (cfg->block_cipher_key) {
+		bb_clear(&dev->settings.cipher.blockCipherKey);
+		if (bb_addHexString(&dev->settings.cipher.blockCipherKey, cfg->block_cipher_key)) {
+			ERROR("Failed to add hex string for block cipher key");
+			goto err;
+		}
+	}
+
+	if (cfg->dedicated_key) {
+		dev->settings.cipher.dedicatedKey = (gxByteBuffer *)calloc(1, sizeof(gxByteBuffer));
+		if (!dev->settings.cipher.dedicatedKey) {
+			ERROR("Failed to allocate dedicated key");
+			goto err;
+		}
+
+		bb_init(dev->settings.cipher.dedicatedKey);
+		if (bb_addHexString(dev->settings.cipher.dedicatedKey, cfg->dedicated_key)) {
+			ERROR("Failed to add hex string for dedicated key");
+			goto err;
+		}
+	}
+
+	return dev;
+err:
+	cfg_free_physical_device(dev);
+	return NULL;
+}
+
+static connection *find_connection_by_id(int connection_id, connection **connections, size_t connection_count)
+{
+	for (size_t i = 0; i < connection_count; i++) {
+		if (connections[i]->id == connection_id) {
+			return connections[i];
+		}
+	}
+
+	return NULL;
+}
+
+static cosem_object **cfg_get_cosem_objects(dlms_cfg *cfg, physical_device **physical_devices, size_t physical_dev_count, size_t *cosem_object_count)
+{
+	cosem_object **cosem_objects = calloc(cfg->cosem_object_cfg_count, sizeof(cosem_object *));
+	if (!cosem_objects) {
+		log(L_ERROR, "Failed to allocate memory for COSEM objects struct");
+		return NULL;
+	}
+
+	for (size_t i = 0; i < cfg->cosem_object_cfg_count; i++) {
+		cosem_object *obj = cfg_get_cosem_object(cfg->cosem_objects[i], physical_devices, physical_dev_count);
+		if (obj) {
+			cosem_objects[(*cosem_object_count)++] = obj;
+		}
+	}
+
+	if (!(*cosem_object_count)) {
+		free(cosem_objects);
+		return NULL;
+	}
+
+	return cosem_objects;
+}
+
+static cosem_object *cfg_get_cosem_object(cosem_object_cfg *cfg, physical_device **physical_devices, size_t physical_dev_count)
+{
+	cosem_object *obj = calloc(1, sizeof(cosem_object));
+	if (!obj) {
+		ERROR("Failed to allocate memory for COSEM object struct");
+		return NULL;
+	}
+
+	obj->id	     = cfg->id;
+	obj->entries = cfg->entries;
+	obj->type    = cfg->cosem_id;
+	obj->name    = strdup(UTL_SAFE_STR(cfg->name));
+	if (!obj->name) {
+		ERROR("Failed to duplicate a string: Out of memory");
+		goto err;
+	}
+
+	obj->devices = calloc(cfg->physical_devices.len, sizeof(physical_device *));
+	if (!obj->devices) {
+		ERROR("Failed to allocate physical devices array");
+		goto err;
+	}
+
+	// find devices for COSEM object
+	for (size_t i = 0; i < cfg->physical_devices.len; i++) {
+		int physical_dev_id = strtol(cfg->physical_devices.strings[i], NULL, 10);
+		for (size_t j = 0; j < physical_dev_count; j++) {
+			if (physical_devices[j]->id == physical_dev_id) {
+				obj->devices[obj->device_count++] = physical_devices[j];
+				break;
+			}
+		}
+	}
+
+	if (obj->device_count == 0) {
+		ERROR("COSEM object ('%d', '%s') does not contain any physical devices", obj->id, UTL_SAFE_STR(obj->name));
+		goto err;
+	}
+
+	if (cfg->has_logical_name) {
+		obj->has_logical_name = true;
+
+		ASSERT(sizeof(obj->logical_name) == sizeof(cfg->logical_name));
+		memcpy(obj->logical_name, cfg->logical_name, sizeof(obj->logical_name));
+	}
+
+	if (cfg->has_short_name) {
+		obj->has_short_name = true;
+		obj->short_name = cfg->short_name;
+	}
+
+	utl_parse_attributes(cfg->attributes, obj);
+
+	return obj;
+err:
+	cfg_free_cosem_object(obj);
+	return NULL;
+}
+
+static cosem_group **cfg_get_cosem_groups(dlms_cfg *cfg, cosem_object **cosem_objects, size_t cosem_object_count, size_t *cosem_group_count)
+{
+	cosem_group **cosem_groups = calloc(cfg->cosem_group_cfg_count, sizeof(cosem_group *));
+	if (!cosem_groups) {
+		ERROR("Failed to allocate memory for COSEM groups struct");
+		return NULL;
+	}
+
+	for (size_t i = 0; i < cfg->cosem_group_cfg_count; i++) {
+		cosem_group *group = cfg_get_cosem_group(cfg, cfg->cosem_groups[i], cosem_objects, cosem_object_count);
+		if (group) {
+			cosem_groups[(*cosem_group_count)++] = group;
+		}
+	}
+
+	if (!(*cosem_group_count)) {
+		free(cosem_groups);
+		return NULL;
+	}
+
+	return cosem_groups;
+}
+
+static cosem_object_cfg *cfg_find_cosem_by_id(cosem_object_cfg **objects, size_t count, int id)
+{
+	for (size_t i = 0; i < count; i++) {
+		if (objects[i]->id == id) {
+			return objects[i];
+		}
+	}
+
+	return NULL;
+}
+
+static cosem_group *cfg_get_cosem_group(dlms_cfg *cfg, cosem_group_cfg *cosem_group_cfg,
+					cosem_object **cosem_objects, size_t cosem_object_count)
+{
+	cosem_group *group = calloc(1, sizeof(cosem_group));
+	if (!group) {
+		ERROR("Failed to allocate memory for COSEM group struct");
+		return NULL;
+	}
+
+	group->interval = cosem_group_cfg->interval;
+	group->id	= cosem_group_cfg->id;
+	group->name	= strdup(UTL_SAFE_STR(cosem_group_cfg->name));
+	if (!group->name) {
+		ERROR("Failed to duplicate a string: Out of memory");
+		goto err;
+	}
+
+	// find COSEM objects for cosem_group
+	for (size_t i = 0; i < cosem_object_count; i++) {
+		cosem_object *object = cosem_objects[i];
+		cosem_object_cfg *object_cfg = cfg_find_cosem_by_id(cfg->cosem_objects, cfg->cosem_object_cfg_count, object->id);
+		if (!object_cfg) {
+			continue;
+		}
+
+		if (object_cfg->cosem_group != group->id) {
+			continue;
+		}
+
+		cosem_object **larger_array = realloc(group->cosem_objects, (group->cosem_object_count + 1) * sizeof(cosem_object *));
+		if (!larger_array) {
+			ERROR("Failed to allocate larger array for physical devices");
+			goto err;
+		}
+
+		group->cosem_objects = larger_array;
+		group->cosem_objects[group->cosem_object_count++] = object;
+
+		if (group->cosem_object_count >= MAX_COSEM_OBJECTS_COUNT) {
+			log(L_NOTICE, "Reached COSEM object limit for a group ('%d'), breaking", group->id);
+			break;
+		}
+	}
+
+	if (!group->cosem_objects) {
+		log(L_ERROR, "COSEM group ('%d', '%s') does not contain any COSEM objects", group->id, UTL_SAFE_STR(group->name));
+		goto err;
+	}
+
+	return group;
+err:
+	cfg_free_cosem_group(group);
+	return NULL;
+}
+
+static void cfg_free_dlms_cfg(dlms_cfg *dlms)
+{
+	if (!dlms) {
+		return;
+	}
+
+	for (size_t i = 0; i < dlms->connection_cfg_count; i++) {
+		cfg_free_connection_cfg(dlms->connections[i]);
+	}
+
+	for (size_t i = 0; i < dlms->physical_device_cfg_count; i++) {
+		cfg_free_physical_device_cfg(dlms->physical_devices[i]);
+	}
+
+	for (size_t i = 0; i < dlms->cosem_object_cfg_count; i++) {
+		cfg_free_cosem_object_cfg(dlms->cosem_objects[i]);
+	}
+
+	for (size_t i = 0; i < dlms->cosem_group_cfg_count; i++) {
+		cfg_free_cosem_group_cfg(dlms->cosem_groups[i]);
+	}
+
+	free(dlms->connections);
+	free(dlms->physical_devices);
+	free(dlms->cosem_objects);
+	free(dlms->cosem_groups);
+	free(dlms);
+}
+
+static void cfg_free_connection_cfg(connection_params_cfg *c)
+{
+	if (!c) {
+		return;
+	}
+
+	free(c->name);
+
+	if (c->type == TCP_CFG) {
+		free(c->parameters.tcp.host);
+	}
+
+	free(c);
+}
+
+static void cfg_free_physical_device_cfg(physical_device_cfg *d)
+{
+	if (!d) {
+		return;
+	}
+
+	free(d->name);
+	free(d->password);
+	free(d->authentication_key);
+	free(d->block_cipher_key);
+	free(d->dedicated_key);
+	free(d->invocation_counter);
+	free(d);
+}
+
+static void cfg_free_cosem_object_cfg(cosem_object_cfg *o)
+{
+	if (!o) {
+		return;
+	}
+
+	free(o->name);
+	free(o->attributes);
+	cfgx_string_list_free(o->physical_devices);
+	free(o);
+}
+
+static void cfg_free_cosem_group_cfg(cosem_group_cfg *g)
+{
+	if (!g) {
+		return;
+	}
+
+	free(g->name);
+	free(g);
+}
+
+void cfg_free_service(service *m)
+{
+	if (!m) {
+		return;
+	}
+
+	for (size_t i = 0; i < m->physical_dev_count; i++) {
+		cfg_free_physical_device(m->physical_devices[i]);
+	}
+
+	for (size_t i = 0; i < m->connection_count; i++) {
+		cfg_free_connection(m->connections[i]);
+	}
+
+	for (size_t i = 0; i < m->cosem_object_count; i++) {
+		cfg_free_cosem_object(m->cosem_objects[i]);
+	}
+
+	for (size_t i = 0; i < m->cosem_group_count; i++) {
+		cfg_free_cosem_group(m->cosem_groups[i]);
+	}
+
+	free(m->connections);
+	free(m->physical_devices);
+	free(m->cosem_objects);
+	free(m->cosem_groups);
+	free(m);
+	m = NULL;
+}
+
+void cfg_free_connection(connection *c)
+{
+	if (!c) {
+		return;
+	}
+
+	com_deinit(c);
+
+	free(c->name);
+
+	if (c->type == TCP) {
+		free(c->parameters.tcp.host);
+	}
+
+	free(c);
+}
+
+void cfg_free_physical_device(physical_device *d)
+{
+	if (!d) {
+		return;
+	}
+
+	cip_clear(&d->settings.cipher);
+	cl_clear(&d->settings);
+
+	free(d->name);
+	free(d->invocation_counter);
+	free(d);
+}
+
+void cfg_free_cosem_object(cosem_object *o)
+{
+	if (!o) {
+		return;
+	}
+
+	free(o->name);
+	free(o->devices);
+	free(o);
+}
+
+void cfg_free_cosem_group(cosem_group *g)
+{
+	if (!g) {
+		return;
+	}
+
+	free(g->name);
+	free(g->cosem_objects);
+	free(g);
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/cosem_group.c src/src/cosem_group.c
--- upstream/src/cosem_group.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/cosem_group.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,500 @@
+#include "common.h"
+#include <sys/param.h>
+
+#define BUFFER_ATTRIBUTE_INDEX 2
+#define CAPTURE_OBJECTS_ATTRIBUTE_INDEX 3
+#define ENTRIES_IN_USE_ATTRIBUTE_INDEX 7
+
+static void cg_print_cosem_information(dlmsSettings *settings, gxObject *object);
+static int cg_read_profile_generic_data(physical_device *dev, gxProfileGeneric *pg, uint32_t obj_entries);
+static void cg_shutdown_connection(physical_device *dev);
+
+typedef struct {
+	gxObjectStorage object_storage;
+	uint32_t profile_entries;
+	attribute_index_list attributes;
+
+	int read_error;
+} cg_object_request;
+
+typedef struct {
+	physical_device *device;
+
+	cg_object_request *objects;
+	size_t object_count;
+
+	// 0 means no error occured
+	int connect_error;
+	bool scan_in_progress_error;
+} cg_device_request;
+
+typedef struct {
+	cg_device_request *items;
+	size_t count;
+} cg_device_request_list;
+
+static cg_device_request *cg_get_device_request(
+	cg_device_request_list *request_list,
+	physical_device *device
+) {
+	for (size_t i = 0; i < request_list->count; i++) {
+		cg_device_request *device_request = &request_list->items[i];
+		if (device_request->device == device) {
+			return device_request;
+		}
+	}
+
+	return NULL;
+}
+
+static cg_device_request *cg_get_or_add_device_request(
+	cg_device_request_list *request_list,
+	physical_device *device
+) {
+	cg_device_request *device_request = cg_get_device_request(request_list, device);
+	if (device_request != NULL) {
+		return device_request;
+	}
+
+	request_list->items = realloc(
+		request_list->items,
+		sizeof(*request_list->items) * (request_list->count + 1)
+	);
+	_check_alloc(request_list->items);
+
+	device_request = &request_list->items[request_list->count++];
+	*device_request = (cg_device_request){
+		.device = device
+	};
+
+	return device_request;
+}
+
+static cg_object_request *cg_get_object_request(
+	cg_device_request *device_request,
+	DLMS_OBJECT_TYPE type,
+	obis_code obis
+) {
+	for (size_t i = 0; i < device_request->object_count; i++) {
+		cg_object_request *object_request = &device_request->objects[i];
+		gxObject *object = (gxObject*)object_request->object_storage;
+
+		if (object->objectType != type) {
+			continue;
+		}
+
+		if (obis.use_logical_name) {
+			if (memcmp(object->logicalName, obis.logical_name, 6) != 0) {
+				continue;
+			}
+		} else {
+			if (object->shortName != obis.short_name) {
+				continue;
+			}
+		}
+
+		return object_request;
+	}
+
+	return NULL;
+}
+
+static cg_object_request *cg_get_or_add_object_request(
+	cg_device_request *device_request,
+	DLMS_OBJECT_TYPE type,
+	obis_code obis
+) {
+	cg_object_request *object_request = cg_get_object_request(device_request, type, obis);
+	if (object_request != NULL) {
+		return object_request;
+	}
+
+	device_request->objects = realloc(
+		device_request->objects,
+		sizeof(*device_request->objects) * (device_request->object_count + 1)
+	);
+	_check_alloc(device_request->objects);
+
+	object_request = &device_request->objects[device_request->object_count++];
+	*object_request = (cg_object_request){ 0 };
+
+	gxObject *object = (gxObject*)object_request->object_storage;
+	logical_name_t logical_name_stub = { 0 };
+	if (cosem_init2(object, type, logical_name_stub)) {
+		ERROR("Failed to initialize logical cosem object\n");
+		return NULL;
+	}
+
+	if (obis.use_logical_name) {
+		ASSERT(sizeof(object->logicalName) == sizeof(obis.logical_name));
+		memcpy(object->logicalName, obis.logical_name, sizeof(object->logicalName));
+	} else {
+		object->shortName = obis.short_name;
+	}
+
+	return object_request;
+}
+
+static void cg_free_device_requests(cg_device_request_list *device_requests)
+{
+	if (device_requests == NULL) {
+		return;
+	}
+
+	for (size_t i = 0; i < device_requests->count; i++) {
+		cg_device_request *device_request = &device_requests->items[i];
+		physical_device *dev = device_request->device;
+
+		for (size_t j = 0; j < device_request->object_count; j++) {
+			cg_object_request *object_request = &device_request->objects[j];
+			gxObject *object = (gxObject*)object_request->object_storage;
+			obj_clear(object);
+		}
+
+		free(device_request->objects);
+		oa_clear(&dev->settings.releasedObjects, 1);
+	}
+
+	free(device_requests->items);
+}
+
+static void cg_add_device_requests_from_group(cg_device_request_list *device_requests, cosem_group *group)
+{
+	for (size_t i = 0; i < group->cosem_object_count; i++) {
+		cosem_object *cosem_object = group->cosem_objects[i];
+
+		for (size_t j = 0; j < cosem_object->device_count; j++) {
+			physical_device *dev = cosem_object->devices[j];
+
+			cg_device_request *device_request = cg_get_or_add_device_request(device_requests, dev);
+			if (!device_request) {
+				ERROR("Failed to get or add device request");
+				continue;
+			}
+
+			obis_code obis = { 0 };
+			if (dev->settings.useLogicalNameReferencing) {
+				if (!cosem_object->has_logical_name) {
+					// Error will be reported in `cg_format_cosem_value`
+					continue;
+				}
+
+				obis.use_logical_name = true;
+				memcpy(obis.logical_name, cosem_object->logical_name, sizeof(obis.logical_name));
+			} else {
+				if (!cosem_object->has_short_name) {
+					// Error will be reported in `cg_format_cosem_value`
+					continue;
+				}
+
+				obis.use_logical_name = false;
+				obis.short_name = cosem_object->short_name;
+			}
+
+			cg_object_request *object_request = cg_get_or_add_object_request(
+				device_request,
+				cosem_object->type,
+				obis
+			);
+			if (object_request == NULL) {
+				ERROR("Failed to get or add an object request");
+				continue;
+			}
+
+			// If "Buffer" attribute is going read, then capture objects must be read before it.
+			// When decoding "Buffer" capture objects are used.
+			if (
+				cosem_object->type == DLMS_OBJECT_TYPE_PROFILE_GENERIC &&
+				utl_attributes_contain(&cosem_object->attributes, BUFFER_ATTRIBUTE_INDEX)
+			) {
+				utl_attributes_append(&object_request->attributes, CAPTURE_OBJECTS_ATTRIBUTE_INDEX);
+				utl_attributes_append(&object_request->attributes, ENTRIES_IN_USE_ATTRIBUTE_INDEX);
+				object_request->profile_entries = MAX(object_request->profile_entries, cosem_object->entries);
+			}
+
+			utl_attributes_append_many(&object_request->attributes, &cosem_object->attributes);
+		}
+	}
+}
+
+static int cg_read_object(cg_object_request *request, physical_device *dev)
+{
+	int err = DLMS_ERROR_CODE_UNKNOWN;
+	gxObject *object = (gxObject*)request->object_storage;
+	bool read_profile_generic_data = false;
+
+	gxByteBuffer attributes = { 0 };
+	bb_init(&attributes);
+
+	cg_print_cosem_information(&dev->settings, object);
+
+	if (obj_getAttributeIndexToRead(object, &attributes) != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to read object. Error: %s", hlp_getErrorMessage(err));
+		goto end;
+	}
+
+	for (size_t i = 0; i < attributes.size; i++) {
+		uint8_t attribute = 0;
+		if (bb_getUInt8ByIndex(&attributes, i, &attribute) != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to get uint by index %zu", i);
+			goto end;
+		}
+
+		if (!utl_attributes_contain(&request->attributes, attribute)) {
+			continue;
+		}
+
+		log(L_INFO, "Reading attribute: %d", attribute);
+
+		if (object->objectType == DLMS_OBJECT_TYPE_PROFILE_GENERIC && attribute == BUFFER_ATTRIBUTE_INDEX) {
+			read_profile_generic_data = true;
+			log(L_INFO, "Skipping profile generic 'buffer' attribute for later reading");
+			continue;
+		}
+
+		// TODO: Save error code for each attribute
+		// Because currently when at least one attribute fails, the whole object will fail
+		err = com_read(dev, object, attribute);
+		if (err == DLMS_ERROR_CODE_UNAVAILABLE_OBJECT) {
+			continue;
+		}
+
+		if (err != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to read object attribute, index: %d", attribute);
+
+			if (
+				(object->objectType == DLMS_OBJECT_TYPE_ASSOCIATION_LOGICAL_NAME) &&
+				(err == DLMS_ERROR_CODE_ACCESS_VIOLATED || err == DLMS_ERROR_CODE_OTHER_REASON)
+			) {
+				log(L_ERROR, "Device reports access violation, skipping...");
+				err = 0;
+				continue;
+			}
+
+			if (err != DLMS_ERROR_CODE_READ_WRITE_DENIED) {
+				goto end;
+			}
+		}
+	}
+
+	if (read_profile_generic_data) {
+		// TODO: Only try reading "Buffer" attribute if reading "Capture objects" and "Entries in use" was successful.
+		err = cg_read_profile_generic_data(dev, (gxProfileGeneric *)object, request->profile_entries);
+		if (err != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to read profile generic data");
+			goto end;
+		}
+	}
+
+	err = DLMS_ERROR_CODE_OK;
+end:
+	bb_clear(&attributes);
+	return err;
+}
+
+static void cg_read_device(cg_device_request *request, shared_memory_ctx *shared)
+{
+	physical_device *dev = request->device;
+	log(L_INFO, "Reading from device ('%d', '%s')", dev->id, UTL_SAFE_STR(dev->name));
+
+	if (shared_av_get_status(shared, dev->id) == SCAN_STATUS_IN_PROGRESS) {
+		request->scan_in_progress_error = true;
+		goto end;
+	}
+
+	int connect_err = com_open_connection(dev);
+	if (connect_err != DLMS_ERROR_CODE_OK) {
+		request->connect_error = connect_err;
+		log(L_ERROR, "Failed to make connection with device ('%d', '%s')", dev->id, dev->name);
+		goto end_shutdown_connection;
+	}
+
+	for (size_t i = 0; i < request->object_count; i++) {
+		cg_object_request *object_request = &request->objects[i];
+
+		int object_error = cg_read_object(object_request, dev);
+		if (object_error != DLMS_ERROR_CODE_OK) {
+			object_request->read_error = object_error;
+			log(L_ERROR, "Failed to read COSEM object: %s", hlp_getErrorMessage(object_error));
+			// Save error, continue reading other objects
+		}
+	}
+
+end_shutdown_connection:
+	cg_shutdown_connection(dev);
+end:
+	return;
+}
+
+static void cg_shutdown_connection(physical_device *dev)
+{
+	bool keep_socket_open = com_is_persistent(dev->connection);
+	com_close_connection(dev, keep_socket_open);
+}
+
+static void cg_print_cosem_information(dlmsSettings *settings, gxObject *object)
+{
+	if (settings->useLogicalNameReferencing) {
+		char LN[32] = { 0 };
+		hlp_getLogicalNameToString(object->logicalName, LN);
+		log(L_INFO, "Reading object: '%s', OBIS '%s'", obj_typeToString2(object->objectType), LN);
+	} else {
+		log(L_INFO, "Reading object: '%s', OBIS '%d'", obj_typeToString2(object->objectType), object->shortName);
+	}
+}
+
+static char *cg_format_cosem_value(cg_device_request_list *device_requests, cosem_object *cosem_object)
+{
+	char *data = NULL;
+
+	for (size_t i = 0; i < cosem_object->device_count; i++) {
+		physical_device *dev = cosem_object->devices[i];
+		cg_device_request *device_request = cg_get_device_request(device_requests, dev);
+		if (!device_request) {
+			continue;
+		}
+
+		if (device_request->scan_in_progress_error) {
+			utl_add_error_message(&data, dev->name, -1, "Physical device scan is in progress");
+			goto loop_end;
+		}
+
+		if (device_request->connect_error != 0) {
+			int err = device_request->connect_error;
+			utl_add_error_message(&data, dev->name, err, "Failed to make connection with device: %s", hlp_getErrorMessage(err));
+			goto loop_end;
+		}
+
+		obis_code obis = { 0 };
+		if (dev->settings.useLogicalNameReferencing) {
+			if (!cosem_object->has_logical_name) {
+				utl_add_error_message(&data, dev->name, -1, "Missing logical name");
+				continue;
+			}
+
+			obis.use_logical_name = true;
+			memcpy(obis.logical_name, cosem_object->logical_name, sizeof(obis.logical_name));
+		} else {
+			if (!cosem_object->has_short_name) {
+				utl_add_error_message(&data, dev->name, -1, "Missing short name");
+				continue;
+			}
+
+			obis.use_logical_name = false;
+			obis.short_name = cosem_object->short_name;
+		}
+
+		cg_object_request *object_request = cg_get_object_request(
+			device_request,
+			cosem_object->type,
+			obis
+		);
+		if (!object_request) {
+			continue;
+		}
+
+		if (object_request->read_error != 0) {
+			int err = object_request->read_error;
+			utl_add_error_message(&data, dev->name, err, "Failed to read COSEM object: %s", hlp_getErrorMessage(err));
+			goto loop_end;
+		}
+
+		gxObject *object = (gxObject*)object_request->object_storage;
+
+		attr_ctx ctx = { 0 };
+		attr_init(
+			&ctx,
+			object,
+			dev->settings.useLogicalNameReferencing,
+			cosem_object->entries
+		);
+
+		char *json = attr_object_to_json(&ctx, cosem_object->attributes);
+		if (!json) {
+			utl_add_error_message(&data, dev->name, -1, "Failed to format read attributes");
+			log(L_ERROR, "Failed to format read attributes\n");
+			goto loop_end;
+		}
+
+		utl_append_obj_name(&data, dev->name);
+		utl_append_to_str(&data, json);
+		free(json);
+
+	loop_end:
+		utl_append_if_needed(&data, i, cosem_object->device_count - 1, ",");
+	}
+
+	return data;
+}
+
+static int cg_read_profile_generic_data(physical_device *dev, gxProfileGeneric *pg, uint32_t obj_entries)
+{
+	log(L_DEBUG, "Entries in use: %d", pg->entriesInUse);
+	log(L_DEBUG, "Needed entries: %d", obj_entries);
+
+	uint32_t clamped_entries = MIN(obj_entries, pg->entriesInUse);
+	uint32_t index = pg->entriesInUse - clamped_entries + 1;
+	log(L_INFO, "Reading profile generic rows, from: %d, count: %d", index, clamped_entries);
+	return com_read_rows_by_entry(dev, pg, index, clamped_entries);
+}
+
+char *cg_read_cosem_group(cosem_group *group, int *rc, shared_memory_ctx *shared)
+{
+	*rc = 1;
+	char *data = NULL;
+
+	cg_device_request_list device_requests = { 0 };
+	cg_add_device_requests_from_group(&device_requests, group);
+
+	for (size_t i = 0; i < device_requests.count; i++) {
+		cg_device_request *device_request = &device_requests.items[i];
+
+		cg_read_device(device_request, shared);
+
+		if (device_request->connect_error != 0 || device_request->scan_in_progress_error) {
+			continue;
+		}
+
+		for (size_t j = 0; j < device_request->object_count; j++) {
+			cg_object_request *object_request = &device_request->objects[j];
+
+			if (object_request->read_error != 0) {
+				continue;
+			}
+
+			// TODO: Maybe change `rc` to indicate an error when any request fails
+			// Not how it currently indicates success when any requests succeeds
+			*rc = 0;
+		}
+	}
+
+	utl_append_to_str(&data, "{");
+	for (size_t i = 0; i < group->cosem_object_count; i++) {
+		cosem_object *cosem_object = group->cosem_objects[i];
+
+		utl_append_obj_name(&data, cosem_object->name);
+		utl_append_to_str(&data, "{");
+
+		char *cosem_data = cg_format_cosem_value(&device_requests, cosem_object);
+		utl_append_to_str(&data, cosem_data);
+		free(cosem_data);
+
+		utl_append_to_str(&data, "}");
+		utl_append_if_needed(&data, i, group->cosem_object_count - 1, ",");
+	}
+	utl_append_to_str(&data, "}");
+
+	cg_free_device_requests(&device_requests);
+	return data;
+}
+
+void print_cosem_information(dlmsSettings *settings, gxObject *object)
+{
+	if (settings->useLogicalNameReferencing) {
+		char LN[32] = { 0 };
+		hlp_getLogicalNameToString(object->logicalName, LN);
+		log(L_INFO, "Reading object: '%s', OBIS '%s'\n", obj_typeToString2(object->objectType), LN);
+	} else {
+		log(L_INFO, "Reading object: '%s', OBIS '%d'\n", obj_typeToString2(object->objectType), object->shortName);
+	}
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/db.c src/src/db.c
--- upstream/src/db.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/db.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,441 @@
+#include "common.h"
+
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+
+#define DB_MAX_PAGE_COUNT 1024 //!< Set maximum number of pages in database (each page is 4096B)
+#define DB_TIMEOUT        30000
+#define DB_TABLE          "dlms_data"
+#define DB_TABLE_AV       "association_view"
+#define DB_DELETE_COUNT   100
+
+#define DB_PATH "/var/run/dlms_client/dlms.db"
+
+#define ASSERT_SUCCESS(expr)                                                                  \
+	do {                                                                                      \
+		if (!(expr)) {                                                                        \
+			ERROR("[%d] Assert failed, expected command '%s' to succeed\n", __LINE__, #expr); \
+			exit(EXIT_FAILURE);                                                               \
+		}                                                                                     \
+	} while (0)
+
+static bool db_column_exists(database *db, const char *table_name, const char *column_name);
+static int db_init_data_table(database *db);
+static int db_create_file(const char *path, int mode);
+static int db_reinit(database *db);
+static int db_write_cosem_group_no_lock(database *db, database_cosem_group *cosem_group);
+
+int db_init(database *db)
+{
+	int rc = -1;
+
+	memset(db, 0, sizeof(*db));
+
+	if (!sqlite3_threadsafe()) {
+		ERROR("SQLite3 is not thread-safe!");
+		goto end;
+	}
+
+	if (db_create_file(DB_PATH, S_IRWXU | S_IRWXG)) {
+		ERROR("Failed to create database file '%s'", DB_PATH);
+		goto end;
+	}
+
+	if (sqlite3_open_v2(DB_PATH, &db->sqlite, SQLITE_OPEN_READWRITE, NULL) != SQLITE_OK) {
+		ERROR("Failed to open database ('%s')", DB_PATH);
+		goto end;
+	}
+
+	if (sqlite3_db_readonly(db->sqlite, NULL)) {
+		ERROR("Database is read-only");
+		goto end;
+	}
+
+	if (sqlite3_busy_timeout(db->sqlite, DB_TIMEOUT)) {
+		ERROR("Failed to set DB timeout: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	if (db_init_data_table(db)) {
+		ERROR("Failed to initialize data table");
+		goto end;
+	}
+
+	const char *query =
+		"CREATE TABLE IF NOT EXISTS sent_id_table ("
+			"id INTEGER PRIMARY KEY AUTOINCREMENT,"
+			"sender_id TEXT,"
+			"last_sent_id INT"
+		");";
+
+	if (sqlite3_exec(db->sqlite, query, NULL, NULL, NULL)) {
+		ERROR("Failed to CREATE TABLE sent_id_table: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	query =
+		"CREATE TABLE IF NOT EXISTS " DB_TABLE_AV " ("
+			"id INTEGER PRIMARY KEY AUTOINCREMENT,"
+			"physical_device_id TEXT,"
+			"cosem_class_id TEXT,"
+			"obis TEXT,"
+			"short_name TEXT"
+		");";
+	if (sqlite3_exec(db->sqlite, query, NULL, NULL, NULL)) {
+		ERROR("Failed to CREATE TABLE %s: %s", DB_TABLE_AV, sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	if (sqlite3_exec(db->sqlite, "PRAGMA max_page_count = " UTL_STR(DB_MAX_PAGE_COUNT), NULL, NULL, NULL)) {
+		ERROR("Failed to set max page count: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	const char *insert_query =
+		"INSERT INTO " DB_TABLE "("
+			"id,"
+			"time,"
+			"name,"
+			"size,"
+			"data,"
+			"group_id"
+		") VALUES (?, ?, ?, ?, ?, ?)";
+	if (sqlite3_prepare_v2(db->sqlite, insert_query, -1, &db->stmt_insert, NULL) != SQLITE_OK) {
+		ERROR("Failed to prepare SQL statement: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	const char *insert_query_av = "INSERT INTO " DB_TABLE_AV " VALUES (?, ?, ?, ?, ?)";
+	if (sqlite3_prepare_v2(db->sqlite, insert_query_av, -1, &db->stmt_insert_av, NULL) != SQLITE_OK) {
+		ERROR("Failed to prepare SQL statement: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	const char *delete_query_av = "DELETE FROM " DB_TABLE_AV " WHERE physical_device_id=?1";
+	if (sqlite3_prepare_v2(db->sqlite, delete_query_av, -1, &db->stmt_delete_av, NULL) != SQLITE_OK) {
+		ERROR("Failed to prepare SQL statement: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	db->sqlite_mutex = (pthread_mutex_t)PTHREAD_MUTEX_INITIALIZER;
+
+	rc = 0;
+end:
+	if (rc) {
+		db_deinit(db);
+	}
+	return rc;
+}
+
+static int db_init_data_table(database *db)
+{
+	int rc = -1;
+
+	const char *query = 
+		"CREATE TABLE IF NOT EXISTS " DB_TABLE " ("
+			"id INTEGER PRIMARY KEY AUTOINCREMENT,"
+			"time TIMESTAMP,"
+			"name TEXT,"
+			"size INT,"
+			"data TEXT,"
+			"group_id TEXT"
+		");";
+	if (sqlite3_exec(db->sqlite, query, NULL, NULL, NULL)) {
+		ERROR("Failed to CREATE TABLE dlms_data: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	bool group_id_exists = db_column_exists(db, DB_TABLE, "group_id");
+	if (!group_id_exists && sqlite3_exec(db->sqlite, "ALTER TABLE " DB_TABLE " ADD group_id TEXT;", NULL, NULL, NULL)) {
+		WARN("failed to add 'group_id' column to '" DB_TABLE "'");
+		goto end;
+	}
+
+	rc = 0;
+end:
+	return rc;
+}
+
+void db_deinit(database *db)
+{
+	sqlite3_finalize(db->stmt_insert);
+	db->stmt_insert = NULL;
+
+	sqlite3_finalize(db->stmt_insert_av);
+	db->stmt_insert_av = NULL;
+
+	sqlite3_finalize(db->stmt_delete_av);
+	db->stmt_delete_av = NULL;
+
+	sqlite3_close_v2(db->sqlite);
+	db->sqlite = NULL;
+}
+
+int db_write_cosem_group(database *db, database_cosem_group *cosem_group)
+{
+	int rc = -1;
+	ASSERT_SUCCESS(pthread_mutex_lock(&db->sqlite_mutex) == 0);
+
+	DEBUG("('%s') Writing to cosem group database: %s", UTL_SAFE_STR(cosem_group->name), cosem_group->result);
+
+	rc = db_write_cosem_group_no_lock(db, cosem_group);
+
+	// If the DB doesn't exist it will throw a SQLITE_READONLY error, if this happens
+	// recreate the db and retry inserting the cosem group
+	if (rc && sqlite3_errcode(db->sqlite) == SQLITE_READONLY) {
+		if (db_reinit(db)) {
+			goto end;
+		}
+
+		rc = db_write_cosem_group_no_lock(db, cosem_group);
+	}
+
+	rc = 0;
+end:
+	ASSERT_SUCCESS(pthread_mutex_unlock(&db->sqlite_mutex) == 0);
+	return rc;
+}
+
+int db_clear_association_view_objects(database *db, int device_id)
+{
+	ASSERT_SUCCESS(pthread_mutex_lock(&db->sqlite_mutex) == 0);
+	int rc = -1;
+
+	sqlite3_stmt *stmt_delete = db->stmt_delete_av;
+	if (!stmt_delete) {
+		goto end;
+	}
+
+	if (sqlite3_bind_int(stmt_delete, 1, device_id) != SQLITE_OK) {
+		ERROR("Failed to bind DB parameter: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	if (sqlite3_step(stmt_delete) != SQLITE_DONE) {
+		ERROR("DELETE failed: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	rc = 0;
+end:
+	sqlite3_reset(stmt_delete);
+	sqlite3_clear_bindings(stmt_delete);
+	ASSERT_SUCCESS(pthread_mutex_unlock(&db->sqlite_mutex) == 0);
+	return rc;
+}
+
+int db_write_association_view_object(database_av_transaction *transaction, int device_id, uint16_t class_id, const char *obis, uint16_t short_name)
+{
+	// This function intentionally does not lock `db->sqlite_mutex`,
+	// because when beginning a transaction it will be locked
+
+	int rc = -1;
+
+	database *db = transaction->db;
+	sqlite3_stmt *stmt_insert = db->stmt_insert_av;
+	if (!db || !stmt_insert) {
+		goto end;
+	}
+
+	char device_id_str[8] = { 0 };
+	if (device_id) {
+		snprintf(device_id_str, sizeof(device_id_str), "%d", device_id);
+	}
+
+	char class_id_str[8] = { 0 };
+	if (class_id) {
+		snprintf(class_id_str, sizeof(class_id_str), "%d", class_id);
+	}
+
+	char short_name_str[8] = { 0 };
+	if (short_name) {
+		snprintf(short_name_str, sizeof(short_name_str), "%d", short_name);
+	}
+
+	DEBUG("Writing to association view object to database: %s %s %s %s", device_id_str, class_id_str, obis, short_name_str);
+
+	uint8_t i = 1;
+	if (sqlite3_bind_null(stmt_insert, i++) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, device_id_str, strlen(device_id_str), SQLITE_STATIC) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, class_id_str, strlen(class_id_str), SQLITE_STATIC) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, obis, strlen(UTL_SAFE_STR(obis)), SQLITE_STATIC) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, short_name_str, strlen(short_name_str), SQLITE_STATIC) != SQLITE_OK) {
+		ERROR("Failed to bind DB parameter: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	if (sqlite3_step(stmt_insert) != SQLITE_DONE) {
+		ERROR("INSERT failed: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	rc = 0;
+end:
+	sqlite3_reset(stmt_insert);
+	sqlite3_clear_bindings(stmt_insert);
+	return rc;
+}
+
+int db_begin_transaction(database_av_transaction *transaction, database *db)
+{
+	ASSERT_SUCCESS(pthread_mutex_lock(&db->sqlite_mutex) == 0);
+
+	if (sqlite3_exec(db->sqlite, "BEGIN TRANSACTION", NULL, NULL, NULL)) {
+		ERROR("Failed to BEGIN TRANSACTION: %s", sqlite3_errmsg(db->sqlite));
+		ASSERT_SUCCESS(pthread_mutex_unlock(&db->sqlite_mutex) == 0);
+		return -1;
+	}
+
+	transaction->db = db;
+
+	return 0;
+}
+
+void db_end_transaction(database_av_transaction *transaction)
+{
+	database *db = transaction->db;
+	if (db == NULL) {
+		return;
+	}
+
+	if (sqlite3_exec(db->sqlite, "END TRANSACTION", NULL, NULL, NULL)) {
+		ERROR("Failed to END TRANSACTION: %s", sqlite3_errmsg(db->sqlite));
+	} else {
+		DEBUG("Batch of records added to the database successfully");
+	}
+
+	ASSERT_SUCCESS(pthread_mutex_unlock(&db->sqlite_mutex) == 0);
+
+	transaction->db = NULL;
+}
+
+static int db_create_file(const char *path, int mode)
+{
+	umask(0);
+
+	if (!access(path, F_OK)) {
+		if (access(path, R_OK | W_OK | X_OK)) {
+			DEBUG("permissions not available %s: %s", path, strerror(errno));
+			return -1;
+		}
+
+		return 0;
+	}
+
+	int fd = creat(path, mode);
+	if (fd < 0) {
+		DEBUG("Unable to create file '%s': %s\n", path, strerror(errno));
+		return -1;
+	}
+
+	close(fd);
+	return 0;
+}
+
+static int db_write_cosem_group_no_lock(database *db, database_cosem_group *cosem_group)
+{
+	int rc = -1;
+
+	sqlite3_stmt *stmt_insert = db->stmt_insert;
+	if (!stmt_insert) {
+		goto end;
+	}
+
+	char id_str[32] = { 0 };
+	snprintf(id_str, sizeof(id_str), "%d", cosem_group->id);
+
+	uint8_t i = 1;
+	if (sqlite3_bind_null(stmt_insert, i++) != SQLITE_OK ||
+	    sqlite3_bind_int64(stmt_insert, i++, time(NULL)) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, UTL_SAFE_STR(cosem_group->name), -1, SQLITE_STATIC) != SQLITE_OK ||
+	    sqlite3_bind_int(stmt_insert, i++, strlen(cosem_group->result)) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, cosem_group->result, -1, SQLITE_STATIC) != SQLITE_OK ||
+	    sqlite3_bind_text(stmt_insert, i++, id_str, -1, SQLITE_STATIC) != SQLITE_OK) {
+		ERROR("Failed to bind DB parameter: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	int step_err = sqlite3_step(stmt_insert);
+	if (step_err == SQLITE_FULL) {
+		const char *delete_query =
+			"DELETE FROM " DB_TABLE " "
+			"WHERE id IN ("
+				"SELECT id FROM " DB_TABLE " ORDER BY id ASC LIMIT " UTL_STR(DB_DELETE_COUNT)
+			")";
+		if (sqlite3_exec(db->sqlite, delete_query, NULL, NULL, NULL) != SQLITE_OK) {
+			ERROR("DELETE failed: %s", sqlite3_errmsg(db->sqlite));
+			goto end;
+		}
+
+		DEBUG("Repeat INSERT after DELETE");
+
+		if (sqlite3_step(stmt_insert) != SQLITE_DONE) {
+			ERROR("INSERT failed after DELETE: %s", sqlite3_errmsg(db->sqlite));
+			goto end;
+		}
+	} else if (step_err != SQLITE_DONE) {
+		int error_code = sqlite3_errcode(db->sqlite);
+		ERROR("INSERT failed (%d): %s", error_code, sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+	DEBUG("Record added to the database successfully");
+
+	rc = 0;
+end:
+	sqlite3_reset(stmt_insert);
+	sqlite3_clear_bindings(stmt_insert);
+	return rc;
+}
+
+static int db_reinit(database *db)
+{
+	int rc = -1;
+
+	database new_db = { 0 };
+	if (db_init(&new_db)) {
+		goto end;
+	}
+	new_db.sqlite_mutex = db->sqlite_mutex;
+
+	db_deinit(db);
+	*db = new_db;
+
+	rc = 0;
+end:
+	return rc;
+}
+
+static bool db_column_exists(database *db, const char *table_name, const char *column_name)
+{
+	bool result = false;
+
+	sqlite3_stmt *stmt = NULL;
+
+	if (sqlite3_prepare_v2(db->sqlite, "SELECT COUNT(*) FROM pragma_table_info(?) WHERE name = ?", -1, &stmt, NULL)) {
+		WARN("failed to prepare statement");
+		goto end;
+	}
+
+	if (sqlite3_bind_text(stmt, 1, table_name, strlen(table_name), SQLITE_STATIC) ||
+		sqlite3_bind_text(stmt, 2, column_name, strlen(column_name), SQLITE_STATIC)) {
+			WARN("sqlite3_bind failed: %s", sqlite3_errmsg(db->sqlite));
+			goto end;
+	}
+
+	int step_rc = sqlite3_step(stmt);
+	if (step_rc == SQLITE_ROW) {
+		int count = sqlite3_column_int(stmt, 0);
+		result = count != 0;
+
+		goto end;
+	} else if (step_rc != SQLITE_DONE) {
+		WARN("sqlite3_step failed: %s", sqlite3_errmsg(db->sqlite));
+		goto end;
+	}
+
+end:
+	sqlite3_finalize(stmt);
+	return result;
+}
