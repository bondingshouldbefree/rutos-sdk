-        mes_clear(&messages);
-        reply_clear(&reply);
-        if (ret == DLMS_ERROR_CODE_APPLICATION_CONTEXT_NAME_NOT_SUPPORTED)
-        {
-            return ret;
-        }
-        return ret;
-    }
-    mes_clear(&messages);
-    reply_clear(&reply);
-    // Get challenge Is HLS authentication is used.
