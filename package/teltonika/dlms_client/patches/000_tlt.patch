-#elif CONF_CPU_FREQUENCY < 10000000
-#define CPU_FREQ_POWER 7
-#elif CONF_CPU_FREQUENCY < 100000000
-#define CPU_FREQ_POWER 8
-#elif CONF_CPU_FREQUENCY < 1000000000
-#define CPU_FREQ_POWER 9
-#endif
