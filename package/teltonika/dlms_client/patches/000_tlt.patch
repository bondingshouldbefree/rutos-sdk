-    time_fromUnixTime2(epoch, &year, &month,
-        &day, &hour, &minute, &second, &dayOfWeek);
-    memset(time, 0, sizeof(struct tm));
-    time->tm_sec = second;
-    time->tm_min = minute;
-    time->tm_hour = hour;
-    time->tm_year = year - 1900;
-    time->tm_mon = month - 1;
-    time->tm_mday = day;
-    time->tm_wday = dayOfWeek;
-    return 0;
-}
