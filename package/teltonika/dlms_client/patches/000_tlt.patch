-    if (obj->objectType == DLMS_OBJECT_TYPE_DISCONNECT_CONTROL)
-    {
-        return getDisconnectControlAttributeAccess(settings, index);
-    }
-    if (obj->objectType == DLMS_OBJECT_TYPE_DISCONNECT_CONTROL)
-    {
-        return getDisconnectControlAttributeAccess(settings, index);
