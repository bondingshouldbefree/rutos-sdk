-	//Check server address using serial number.
-	if ((serverAddress & 0x3FFF) == SERIAL_NUMBER % 10000 + 1000)
-	{
-		return 1;
-	}
-	//Check server address with two bytes.
-	if ((serverAddress & 0xFFFF0000) == 0 && (serverAddress & 0x7FFF) == 1)
