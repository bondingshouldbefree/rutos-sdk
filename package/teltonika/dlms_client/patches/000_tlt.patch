-            bb_attach(&header, pduAttributes, 0, sizeof(pduAttributes));
-            h = &header;
-        }
-        else
-        {
-#ifdef DLMS_IGNORE_MALLOC
-            bb_attach(&header, pduAttributes, 0, sizeof(pduAttributes));
-            h = &header;
-#else
-            h = reply;
-#endif //DLMS_IGNORE_MALLOC
