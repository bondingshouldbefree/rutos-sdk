+		case DLMS_OBJECT_TYPE_PUSH_SETUP:
+			return attr_gx_push_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_TCP_UDP_SETUP:
+			return attr_gx_tcp_udp_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IP4_SETUP:
+			return attr_gx_ip4_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_MAC_ADDRESS_SETUP:
+			return attr_gx_mac_address_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_GPRS_SETUP:
+			return attr_gx_gprs_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_GSM_DIAGNOSTIC:
+			return attr_gx_gsm_diagnostic_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IP6_SETUP:
+			return attr_gx_ip6_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_COMPACT_DATA:
+			return attr_gx_compact_data_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_SECURITY_SETUP:
+			return attr_gx_security_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_ARBITRATOR:
+			return attr_gx_arbitrator_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_DISCONNECT_CONTROL:
+			return attr_gx_disconnect_control_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_LIMITER:
+			return attr_gx_limiter_to_string(ctx, attribute);
+		default: //Unknown type.
+			return NULL;
+	}
+}
+
+char *attr_object_to_json(attr_ctx *ctx, attribute_index_list attributes)
+{
+	char *result = NULL;
+
+	bool is_first_attribute = true;
+
+	utl_append_to_str(&result, "{");
+	for (size_t i = 0; i < attributes.count; i++) {
+		int attribute = attributes.items[i];
+		char *attribute_json = attr_object_attribute_to_string(ctx, attribute);
+		if (!attribute_json) {
+			ERROR("Failed to convert object attribute to json, index %d\n", attribute);
+			continue;
+		}
+
+		if (!is_first_attribute) {
+			utl_append_to_str(&result, ", ");
+		}
+		is_first_attribute = false;
+
+		char attr_no[16] = { 0 };
+		snprintf(attr_no, sizeof(attr_no), "\"%d\": ", attribute);
+		utl_append_to_str(&result, attr_no);
+
+		if (strstr(attribute_json, "Scaler") || strstr(attribute_json, "Cell ID")) {
+			utl_append_to_str(&result, "{");
+			utl_append_to_str(&result, attribute_json);
+			utl_append_to_str(&result, "}");
+		} else {
+			utl_append_to_str(&result, "\"");
+			utl_append_to_str(&result, attribute_json);
+			utl_append_to_str(&result, "\"");
+		}
+	}
+	utl_append_to_str(&result, "}");
+
+	return result;
+}
+
+void attr_init(attr_ctx *ctx, gxObject *object, bool use_ln_ref, uint32_t profile_entries)
+{
+	(*ctx) = (attr_ctx){
+		.object = object,
+		.use_ln_ref = use_ln_ref,
+		.profile_entries = profile_entries
+	};
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/communication.c src/src/communication.c
--- upstream/src/communication.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/communication.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,1209 @@
+#include "common.h"
+#include "app.h"
+
+/*
+	Original: https://github.com/Gurux/GuruxDLMS.c/blob/master/GuruxDLMSClientExample/src/communication.c
+	Heavily adjusted to our needs
+*/
+
+#include <netdb.h> //Add support for sockets
+#include <pthread.h>
+#include <sys/ioctl.h>
+#include <sys/param.h>
+#include <sys/file.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <termios.h>
+#include <poll.h>
+
+#define IO_TIMEOUT	    3 // timeout in seconds for reading/writing
+#define RETRY_COUNT	    3
+#define MODE_E_INIT_MESSAGE "/?!\r\n"
+
+// Thread-local storage for tracking if THIS thread holds the connection mutex.
+// This prevents double-unlock issues and ensures proper cleanup on thread exit.
+static __thread bool tls_connection_mutex_locked = false;
+
+typedef enum {
+	POLL_SUCCESS,
+	POLL_ERROR,
+	POLL_TIMEOUT,
+} poll_t;
+
+static poll_t check_poll_errors(int rc);
+
+static int com_read_data_block(physical_device *dev, message *m, gxReplyData *reply);
+static int read_data(connection *c);
+static int read_data_until(connection *c, char delimiter);
+static int send_data(connection *c, gxByteBuffer *data);
+
+static void print_tx(uint8_t *bytes, uint32_t count);
+static void print_rx(uint8_t *bytes, uint32_t count);
+
+//!< challenge can be NULL if request is not ciphered.
+static int com_send_aarq_request(physical_device *dev, message *m, gxReplyData *reply, gxByteBuffer *challenge);
+static int com_send_snrm_request(physical_device *dev, message *m, gxReplyData *reply, gxByteBuffer *challenge);
+
+// ---------- Connection open/close --------- //
+static int com_update_invocation_counter(physical_device *dev);
+static int com_initialize_connection(physical_device *dev);
+static int com_open_socket(connection *c);
+static void com_close_socket(connection *c);
+static int com_send_release_connection(physical_device *dev);
+static int com_send_disconnect_connection(physical_device *dev);
+static int com_check_if_connected_to_server(int fd);
+static int com_initialize_serial_settings(connection *c);
+static int com_initialize_mode_e(connection *c);
+
+// ---------- Connection init/deinit --------- //
+static uint8_t com_is_IPv6_address(const char *host);
+static int com_init_tcp(connection *conn);
+static int com_init_serial(connection *conn);
+
+bool com_is_persistent(connection *c)
+{
+	return c->type == TCP && c->parameters.tcp.persistent;
+}
+
+static int send_data(connection *c, gxByteBuffer *data)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	print_tx(data->data, data->size);
+
+	switch (c->type) {
+	case TCP:
+		if (send(c->socket, (const char *)data->data, data->size, 0) == -1) {
+			log(L_ERROR, "Failed to send data: %s", strerror(errno));
+			ret = DLMS_ERROR_TYPE_COMMUNICATION_ERROR;
+		}
+		break;
+	case SERIAL:
+		if (write(c->socket, data->data, data->size) != (ssize_t)data->size) {
+			log(L_ERROR, "Failed to write data: %s", strerror(errno));
+			ret = DLMS_ERROR_TYPE_COMMUNICATION_ERROR;
+		}
+		break;
+	default:
+		log(L_ERROR, "Invalid connection type");
+		ret = DLMS_ERROR_CODE_INVALID_PARAMETER;
+	}
+
+	return ret;
+}
+
+static uint64_t get_current_time_ms()
+{
+	struct timespec time;
+	clock_gettime(CLOCK_MONOTONIC_RAW, &time);
+	uint64_t current_time_ns = 1000000000 * time.tv_sec + time.tv_nsec;
+	return current_time_ns / 1000000;
+}
+
+static poll_t check_poll_errors(int rc)
+{
+	if (rc < 0 && errno != EINTR) {
+		log(L_ERROR, "Polling failed: %s", strerror(errno));
+		return POLL_ERROR;
+	}
+
+	if (rc == 0 || (rc < 0 && errno == EINTR)) {
+		errno = 0;
+		return POLL_TIMEOUT;
+	}
+
+	return POLL_SUCCESS;
+}
+
+static int read_data(connection *c)
+{
+	if (app_is_shutdown_requested()) {
+		return DLMS_ERROR_CODE_RECEIVE_FAILED;
+	}
+
+	uint32_t min_read_amount = 256;
+
+	uint32_t max_read_amount = c->data.capacity - c->data.size;
+	if (max_read_amount < min_read_amount) {
+		uint32_t new_capacity = c->data.capacity + min_read_amount;
+		if (new_capacity >= 0xFFFF) {
+			log(L_ERROR, "Max receive buffer size reached, ignoring read");
+			return DLMS_ERROR_CODE_OUTOFMEMORY;
+		}
+
+		if (bb_capacity(&c->data, new_capacity) != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to increase receive buffer size to %d", new_capacity);
+			return DLMS_ERROR_CODE_OUTOFMEMORY;
+		}
+		max_read_amount = c->data.capacity - c->data.size;
+	}
+
+	uint32_t read_amount = 0;
+	uint8_t *buffer = c->data.data + c->data.size;
+
+	if (c->type == SERIAL) {
+		struct pollfd fds[1] = {
+			{ .fd = c->socket, .events = POLLIN }
+		};
+		int ret = check_poll_errors(poll(fds, 1, c->timeout));
+		if (ret == POLL_ERROR) {
+			return DLMS_ERROR_CODE_RECEIVE_FAILED;
+		} else if (ret == POLL_TIMEOUT) {
+			log(L_ERROR, "No response, timeout");
+			return DLMS_ERROR_CODE_RECEIVE_FAILED;
+		}
+
+		ret = read(c->socket, buffer, max_read_amount); // nosemgrep
+		if (ret == -1) {
+			log(L_ERROR, "read() read failed: %s", strerror(errno));
+			return DLMS_ERROR_CODE_RECEIVE_FAILED;
+		}
+
+		read_amount = ret;
+
+	} else if (c->type == TCP) {
+		int ret = recv(c->socket, buffer, max_read_amount, 0);
+		if (ret == -1 || (ret == 0 && max_read_amount != 0)) {
+			log(L_ERROR, "read_data(): recv failure");
+			return DLMS_ERROR_CODE_RECEIVE_FAILED;
+		}
+
+		read_amount = ret;
+	}
+
+	if (read_amount > 0) {
+		c->data.size += read_amount;
+		print_rx(buffer, read_amount);
+	} else {
+		log(L_ERROR, "No data received");
+	}
+
+	return 0;
+}
+
+static int read_data_until(connection *c, char delimiter)
+{
+	uint32_t last_data_size = c->data.size;
+	uint64_t started_at = get_current_time_ms();
+
+	while (true) {
+		int ret = read_data(c);
+		if (ret != DLMS_ERROR_CODE_OK) {
+			return ret;
+		}
+
+		for (uint64_t i = last_data_size; i < c->data.size; i++) {
+			if (c->data.data[i] == delimiter) {
+				return DLMS_ERROR_CODE_OK;
+			}
+		}
+		last_data_size = c->data.size;
+
+		uint64_t duration = get_current_time_ms() - started_at;
+		if (c->type == SERIAL && duration >= (uint64_t)c->timeout) {
+			break;
+		}
+	}
+
+	return DLMS_ERROR_CODE_RECEIVE_FAILED;
+}
+
+static int reply_copy(gxReplyData *target, gxReplyData *source)
+{
+	gxByteBuffer data = { 0 };
+	dlmsVARIANT data_value = { 0 };
+
+	gxByteBuffer *data_source = &source->data;
+	if (bb_init(&data)) {
+		goto err;
+	}
+
+	if (bb_capacity(&data, data_source->capacity)) {
+		goto err;
+	}
+
+	if (bb_set(&data, data_source->data, data_source->size)) {
+		goto err;
+	}
+
+	data.position = data_source->position;
+
+	if (var_copy(&data_value, &source->dataValue)) {
+		goto err;
+	}
+
+	*target = *source;
+	target->data = data;
+	target->dataValue = data_value;
+
+	return 0;
+err:
+	var_clear(&data_value);
+	bb_clear(&data);
+	return -1;
+}
+
+int com_send_and_read_dlms_packet(physical_device *dev, gxByteBuffer *data, gxReplyData *reply)
+{
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+	gxReplyData initial_reply = { 0 };
+
+	dlmsSettings *s = &dev->settings;
+	connection *c = dev->connection;
+
+	if (data->size == 0) {
+		log(L_ERROR, "Message is empty");
+		return DLMS_ERROR_CODE_OK;
+	}
+
+	if (reply_copy(&initial_reply, reply)) {
+		goto err;
+	}
+
+	bool retry_sending_request = true;
+
+	int retries = 0;
+	while (true) {
+		if (app_is_shutdown_requested()) {
+			log(L_DEBUG, "Shutdown requested, aborting communication");
+			ret = DLMS_ERROR_CODE_RECEIVE_FAILED;
+			break;
+		}
+
+		if (retry_sending_request) {
+			retry_sending_request = false;
+			retries++;
+
+			if (retries > RETRY_COUNT) {
+				ret = DLMS_ERROR_CODE_RECEIVE_FAILED;
+				break;
+			}
+
+			// If we are retrying to send the request, drop all of the received bytes up until now.
+			// They won't be useful, because they belong to a previous request.
+			c->data.size = 0;
+
+			// Whatever was parsed up until now also doesn't matter.
+			// A new response will be coming and will need to be parsed from scratch.
+			reply_clear(reply);
+			reply_copy(reply, &initial_reply);
+
+			ret = send_data(c, data);
+			if (ret != DLMS_ERROR_CODE_OK) {
+				log(L_ERROR, "Failed to send data: %s", hlp_getErrorMessage(ret));
+				break;
+			}
+		}
+
+		ret = read_data(c);
+		if (ret != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to read data");
+			retry_sending_request = true;
+			continue;
+		}
+
+		if (c->data.size > 0) {
+			c->data.position = 0;
+
+			if (log_get_level() <= L_DEBUG) {
+				char *hex = hlp_bytesToHex(c->data.data, c->data.size);
+				log(L_DEBUG, "Try cl_getData with:\t%s", hex);
+				free(hex);
+			}
+
+			ret = cl_getData(s, &c->data, reply);
+			log(L_DEBUG, "cl_getData return: %d, reply->complete: %d", ret, reply->complete);
+			if (reply->complete == 1) {
+				bb_trim(&c->data);
+
+				// If server respons with "Frame reject", it means that it will be useless to
+				// retry sending the request.
+				//
+				// The receiver and sender sequence is now out of sync. A reconnect is required to
+				// go back to a valid state.
+				if (reply->command == DLMS_COMMAND_REJECTED) {
+					break;
+				}
+
+				// We don't care about notifications, so ignore them.
+				// Otherwise they will mess up response parsing.
+				if (reply->command == DLMS_COMMAND_DATA_NOTIFICATION) {
+					reply_clear(reply);
+					reply_copy(reply, &initial_reply);
+					continue;
+				}
+			}
+
+			// Packet couldn't be parsed for some reason. Retry sending request.
+			if (ret != DLMS_ERROR_CODE_OK && ret != DLMS_ERROR_CODE_FALSE) {
+				retry_sending_request = true;
+				continue;
+			}
+
+			// Response was successfully parsed, success!
+			if (ret == DLMS_ERROR_CODE_OK && reply->complete == 1) {
+				break;
+			}
+		}
+	}
+
+	ret = DLMS_ERROR_CODE_OK;
+err:
+	reply_clear(&initial_reply);
+	return ret;
+}
+
+static int com_read_data_block(physical_device *dev, message *m, gxReplyData *reply)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	if (m->size == 0) {
+		// log(L_ERROR, "There is no data to send");
+		return ret;
+	}
+
+	dlmsSettings *s = &dev->settings;
+
+	gxByteBuffer rr = { 0 };
+	for (int pos = 0; pos != m->size; ++pos) {
+		ret = com_send_and_read_dlms_packet(dev, m->data[pos], reply);
+		if (ret != DLMS_ERROR_CODE_OK) {
+			log(L_ERROR, "Failed to send_and_read_dlms_packet: %s", hlp_getErrorMessage(ret));
+			goto end;
+		}
+
+		while (reply_isMoreData(reply)) {
+			ret = cl_receiverReady(s, reply->moreData, &rr);
+			if (ret != DLMS_ERROR_CODE_OK) {
+				log(L_ERROR, "Failed to cl_receiverReady: %s", hlp_getErrorMessage(ret));
+				goto end;
+			}
+
+			ret = com_send_and_read_dlms_packet(dev, &rr, reply);
+			if (ret != DLMS_ERROR_CODE_OK) {
+				log(L_ERROR, "[while] Failed to send_and_read_dlms_packet: %s", hlp_getErrorMessage(ret));
+				goto end;
+			}
+			bb_clear(&rr);
+
+			if (dev->connection->inter_request_delay_ms > 0) {
+				log(L_DEBUG, "sleeping for %d ms (inter request delay)", dev->connection->inter_request_delay_ms);
+				usleep(dev->connection->inter_request_delay_ms * 1000);
+			}
+		}
+
+		if (dev->connection->inter_request_delay_ms > 0) {
+			log(L_DEBUG, "sleeping for %d ms (inter request delay)", dev->connection->inter_request_delay_ms);
+			usleep(dev->connection->inter_request_delay_ms * 1000);
+		}
+	}
+
+end:
+	bb_clear(&rr);
+	return ret;
+}
+
+int com_read(physical_device *dev, gxObject *object, unsigned char attributeOrdinal)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	message data = { 0 };
+	mes_init(&data);
+
+	gxReplyData reply = { 0 };
+	reply_init(&reply);
+
+	dlmsSettings *s = &dev->settings;
+
+	ret = cl_read(s, object, attributeOrdinal, &data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to read object: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_read_data_block(dev, &data, &reply);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to read COSEM object data block: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = cl_updateValue(s, object, attributeOrdinal, &reply.dataValue);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to update value: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+err:
+	mes_clear(&data);
+	reply_clear(&reply);
+	return ret;
+}
+
+int com_read_rows_by_entry(physical_device *dev, gxProfileGeneric *obj, uint32_t index, uint32_t count)
+{
+	int ret		  = DLMS_ERROR_CODE_OK;
+
+	message data = { 0 };
+	mes_init(&data);
+
+	gxReplyData reply = { 0 };
+	reply_init(&reply);
+
+	dlmsSettings *s = &dev->settings;
+
+	ret = cl_readRowsByEntry(s, obj, index, count, &data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to read rows by entry %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_read_data_block(dev, &data, &reply);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to read data block %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = cl_updateValue(s, (gxObject *)obj, 2, &reply.dataValue);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to update value %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+err:
+	mes_clear(&data);
+	reply_clear(&reply);
+	return ret;
+}
+
+static int com_send_snrm_request(physical_device *dev, message *m, gxReplyData *reply, gxByteBuffer *challenge)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	dlmsSettings *s = &dev->settings;
+
+	mes_init(m);
+	reply_init(reply);
+
+	ret = cl_snrmRequest(s, m);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to send SNRM request: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+	ret = com_read_data_block(dev, m, reply);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to read SNRM data block: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+	ret = cl_parseUAResponse(s, &reply->data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_DEBUG, "Failed to parse UA response: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+end:
+	mes_clear(m);
+	reply_clear(reply);
+	if (challenge) {
+		bb_clear(challenge);
+	}
+
+	return ret;
+}
+
+static int com_send_aarq_request(physical_device *dev, message *m, gxReplyData *reply, gxByteBuffer *challenge)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	dlmsSettings *s = &dev->settings;
+
+	ret = cl_aarqRequest(s, m);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to send AARQ request: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+	ret = com_read_data_block(dev, m, reply);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to read AARQ data block: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+	ret = cl_parseAAREResponse(s, &reply->data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to parse AARE response: %s", hlp_getErrorMessage(ret));
+		goto end;
+	}
+
+end:
+	mes_clear(m);
+	reply_clear(reply);
+	if (challenge) {
+		bb_clear(challenge);
+	}
+
+	return ret;
+}
