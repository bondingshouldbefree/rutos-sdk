diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/rpc/ubus.c src/src/rpc/ubus.c
--- upstream/src/rpc/ubus.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/rpc/ubus.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,167 @@
+#include "common.h"
+#include "rpc.h"
+
+#include <libubox/blobmsg_json.h>
+
+UBUS_METHOD_DECL(device_cb);
+
+UBUS_METHOD_DECL(cosem_group_cb);
+
+enum {
+	TEST_PHYSICAL_DEVICE_OPT_CONNECTION,
+	TEST_PHYSICAL_DEVICE_OPT_DEVICE
+};
+
+static struct blobmsg_policy physical_device_policy[] = {
+	[TEST_PHYSICAL_DEVICE_OPT_CONNECTION] = { .name = "connection", .type = BLOBMSG_TYPE_TABLE },
+	[TEST_PHYSICAL_DEVICE_OPT_DEVICE]     = { .name = "device", .type = BLOBMSG_TYPE_TABLE },
+};
+
+enum {
+	TEST_COSEM_GROUP_OPT_OBJECTS,
+	TEST_COSEM_GROUP_OPT_DEVICES,
+	TEST_COSEM_GROUP_OPT_CONNECTIONS
+};
+
+static struct blobmsg_policy cosem_group_policy[] = {
+	[TEST_COSEM_GROUP_OPT_OBJECTS] = { .name = "objects", .type = BLOBMSG_TYPE_ARRAY },
+	[TEST_COSEM_GROUP_OPT_DEVICES] = { .name = "devices", .type = BLOBMSG_TYPE_ARRAY },
+	[TEST_COSEM_GROUP_OPT_CONNECTIONS] = { .name = "connections", .type = BLOBMSG_TYPE_ARRAY },
+};
+
+static const struct ubus_method ubus_methods[] = {
+	UBUS_METHOD("test_device", device_cb, physical_device_policy),
+	UBUS_METHOD("test_cosem_group", cosem_group_cb, cosem_group_policy),
+
+	// Parameter scanning
+	UBUS_METHOD("scan_stop", scan_stop_cb, physical_device_id_policy),
+	UBUS_METHOD("scan_start", scan_start_cb, physical_device_id_policy),
+	UBUS_METHOD_NOARG("scan_status", scan_status_cb)
+};
+
+static struct ubus_object_type ubus_obj_type = UBUS_OBJECT_TYPE(UBUS_OBJ_NAME ".rpc", ubus_methods);
+
+enum ADDRESS_TYPE {
+	ADDRESS_TYPE_SERVER_ADDRESS,
+	ADDRESS_TYPE_SERIAL_NUMBER
+};
+
+struct ubus_object *rpc_ubus_initiate()
+{
+	struct ubus_object *obj = calloc(1, sizeof(*obj));
+	if (!obj) {
+		log(L_EMERG, "Failed to iniatate UBus");
+		return NULL;
+	}
+	obj->name = UBUS_OBJ_NAME ".rpc";
+	obj->type = &ubus_obj_type;
+	obj->methods = ubus_methods;
+	obj->n_methods = ARRAY_SIZE(ubus_methods);
+
+	return obj;
+}
+
+static void add_result(char *result, const char *format, ...)
+{
+	va_list args;
+	va_start(args, format);
+
+	vsnprintf(result, ERROR_LEN, format, args);
+
+	log(L_WARNING, "%s", result);
+
+	va_end(args);
+}
+
+// ----------------- Test device method -----------------
+
+UBUS_METHOD_DECL(device_cb)
+{
+	int rc = 1;
+	char result[ERROR_LEN] = "Unknown error";
+	physical_device *device = NULL;
+	shared_memory_ctx shared = { 0 };
+
+	if (cfg_read_rpc_main()) {
+		log(L_EMERG, "Failed to read main config");
+		goto end;
+	}
+
+	if (shared_init(&shared)) {
+		add_result(result, "Failed to initialize shared service state");
+		goto end;
+	}
+
+	device = cfg_get_physical_device_blobmsg(msg, &shared);
+	if (!device) {
+		add_result(result, "Failed to parse arguments");
+		goto end;
+	}
+
+	if (shared_av_get_status(&shared, device->id) == SCAN_STATUS_IN_PROGRESS) {
+		add_result(result, "Physical device scan is in progress");
+		goto end;
+	}
+
+	rc = com_open_connection(device);
+
+	if (rc != DLMS_ERROR_CODE_OK) {
+		add_result(result, "Failed to make connection with device: %s", hlp_getErrorMessage(rc));
+		goto end;
+	}
+
+	add_result(result, "OK");
+	rc = 0;
+end:
+	com_close_connection(device, false);
+	if (device && device->connection) {
+		cfg_free_connection(device->connection);
+	}
+	cfg_free_physical_device(device);
+	shared_deinit(&shared);
+	return utl_reply_string(ctx, req, rc, result);
+}
+
+// ----------------- Test cosem group method -----------------
+
+UBUS_METHOD_DECL(cosem_group_cb)
+{
+	int rc = 1;
+	char *cosem_group_result = NULL;
+	const char *result = "Unknown error";
+	service *service = NULL;
+	shared_memory_ctx shared = { 0 };
+
+	if (cfg_read_rpc_main()) {
+		log(L_EMERG, "Failed to read main config");
+		goto end;
+	}
+
+	if (shared_init(&shared)) {
+		result = "Failed to initialize shared service state";
+		goto end;
+	}
+
+	service = cfg_get_cosem_group_blobmsg(msg, &shared);
+	if (!service) {
+		result = "Failed to parse COSEM group parameters.";
+		goto end;
+	}
+
+	cosem_group *group = service->cosem_groups[0];
+
+	rc = DLMS_ERROR_CODE_UNKNOWN;
+	cosem_group_result = cg_read_cosem_group(group, &rc, &shared);
+	log(L_INFO, "Payload: %s", UTL_SAFE_STR(cosem_group_result));
+
+	result = cosem_group_result;
+	rc = 0;
+end:
+	cfg_free_service(service);
+	shared_deinit(&shared);
+
+	int reply_err = utl_reply_json(ctx, req, rc, result);
+	free(cosem_group_result);
+
+	return reply_err;
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/rpc/ubus_scan.c src/src/rpc/ubus_scan.c
--- upstream/src/rpc/ubus_scan.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/rpc/ubus_scan.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,367 @@
+#include "rpc.h"
+
+static void scan_process(shared_memory_ctx *shared, physical_device *device);
+
+static int parse_physical_device_id_args(struct blob_attr *msg)
+{
+	int result = -1;
+
+	if (!msg) {
+		ERROR("UBUS message is null");
+		goto end;
+	}
+
+	struct blob_attr *tb[ARRAY_SIZE(physical_device_id_policy)] = { 0 };
+	blobmsg_parse(
+		physical_device_id_policy,
+		ARRAY_SIZE(physical_device_id_policy),
+		tb,
+		blobmsg_data(msg),
+		blobmsg_len(msg)
+	);
+
+	if (!tb[TEST_PHYSICAL_DEVICE_ID]) {
+		ERROR("Option 'device_id' is not specified");
+		goto end;
+	}
+
+	char *device_id_str = blobmsg_get_string(tb[TEST_PHYSICAL_DEVICE_ID]);
+
+	errno	      = 0;
+	int device_id = strtol(device_id_str, NULL, 10);
+	if (errno) {
+		ERROR("Failed to parse device ID, not a number");
+		goto end;
+	}
+
+	if (device_id <= 0) {
+		ERROR("Device ID must be positive");
+		goto end;
+	}
+
+	result = device_id;
+end:
+	return result;
+}
+
+UBUS_METHOD_DECL(scan_stop_cb)
+{
+	int rc = DLMS_ERROR_CODE_UNKNOWN;
+	const char *error_msg = "Unknown error";
+
+	shared_memory_ctx shared = { 0 };
+
+	int device_id = parse_physical_device_id_args(msg);
+	if (device_id == -1) {
+		error_msg = "Failed to parse arguments";
+		goto end;
+	}
+
+	if (shared_init(&shared)) {
+		error_msg = "Failed to open shared service state";
+		goto end;
+	}
+
+	DEBUG("Physical device id: %d", device_id);
+	if (shared_av_stop(&shared, device_id)) {
+		error_msg = "Scan isn't running";
+		goto end;
+	}
+
+	rc = DLMS_ERROR_CODE_OK;
+end:
+	shared_deinit(&shared);
+	utl_reply_string(ctx, req, rc, rc ? error_msg : "OK");
+	return 0;
+}
+
+UBUS_METHOD_DECL(scan_start_cb)
+{
+	int rc		      = DLMS_ERROR_CODE_UNKNOWN;
+	const char *error_msg = "Unknown error";
+
+	shared_memory_ctx shared = { 0 };
+	physical_device *device = NULL;
+
+	int device_id = parse_physical_device_id_args(msg);
+	if (device_id == -1) {
+		error_msg = "Failed to parse arguments";
+		goto end;
+	}
+
+	DEBUG("Physical device id: %d", device_id);
+
+	if (shared_init(&shared)) {
+		error_msg = "Failed to open shared service state";
+		goto end;
+	}
+
+	char device_id_str[256] = { 0 };
+	snprintf(device_id_str, sizeof(device_id_str), "%d", device_id);
+	device = cfg_read_physical_device_by_id(device_id_str, &shared);
+	if (!device) {
+		ERROR("Failed to read device settings");
+		error_msg = "Physical device not found";
+		goto end;
+	}
+
+	enum scan_status status = shared_av_get_status(&shared, device_id);
+	if (status == SCAN_STATUS_IN_PROGRESS) {
+		error_msg = "Scan is already in progress";
+		goto end;
+	}
+
+	pid_t fork_result = fork();
+	if (fork_result == 0) {
+		scan_process(&shared, device);
+		exit(0);
+
+	} else if (fork_result < 0) {
+		ERROR("Failed to fork scanning process");
+		goto end;
+	}
+
+	rc = DLMS_ERROR_CODE_OK;
+end:
+	if (device && device->connection) {
+		cfg_free_connection(device->connection);
+	}
+	cfg_free_physical_device(device);
+	shared_deinit(&shared);
+	utl_reply_string(ctx, req, rc, rc ? error_msg : "OK");
+	return 0;
+}
+
+UBUS_METHOD_DECL(scan_status_cb)
+{
+	(void)msg;
+
+	int rc		     = 1;
+	struct blob_buf b    = { 0 };
+
+	shared_memory_ctx shared = { 0 };
+
+	if (blob_buf_init(&b, 0)) {
+		WARN("Failed to initiate blob buffer");
+		goto end;
+	}
+
+	if (shared_init(&shared)) {
+		ERROR("Failed to open shared service state");
+		goto end;
+	}
+
+	association_view_info av_infos[MAX_PHYSICAL_DEVICES_COUNT] = { 0 };
+	size_t av_infos_len = 0;
+
+	if (shared_av_copy_all(&shared, av_infos, &av_infos_len, ARRAY_SIZE(av_infos))) {
+		ERROR("Failed to copy association view info");
+		goto end;
+	}
+
+	struct blob_attr *status_attr = blobmsg_open_array(&b, "status");
+
+	for (size_t i = 0; i < av_infos_len; i++) {
+		association_view_info *av_info = &av_infos[i];
+
+		if (av_info->status == SCAN_STATUS_IDLE) {
+			continue;
+		}
+
+		struct blob_attr *device_attr = blobmsg_open_table(&b, NULL);
+
+		char device_id[16] = { 0 };
+		snprintf(device_id, sizeof(device_id), "%d", av_info->physical_device_id);
+
+		blobmsg_add_string(&b, "physical_device_id", device_id);
+		blobmsg_add_u32(&b, "progress", av_info->progress);
+		blobmsg_add_u32(&b, "status", av_info->status);
+		if (av_info->status == SCAN_STATUS_ERROR) {
+			blobmsg_add_string(&b, "error", av_info->error);
+		}
+
+		if (av_info->status == SCAN_STATUS_ERROR || av_info->status == SCAN_STATUS_COMPLETED) {
+			shared_av_clear(&shared, av_info->physical_device_id);
+		}
+
+		blobmsg_close_table(&b, device_attr);
+	}
+
+	blobmsg_close_table(&b, status_attr);
+
+	if (ubus_send_reply(ctx, req, b.head)) {
+		WARN("Failed to send UBUS reply");
+		goto end;
+	}
+
+	rc = 0;
+end:
+	shared_deinit(&shared);
+	blob_buf_free(&b);
+	return rc;
+}
+
+static int read_data_block_association_view(
+	shared_memory_ctx *shared,
+	physical_device *dev,
+	message *m,
+	gxReplyData *reply,
+	int device_id
+)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+	gxByteBuffer rr = { 0 };
+
+	if (m->size == 0) {
+		goto end;
+	}
+
+	dlmsSettings *s = &dev->settings;
+
+	for (int pos = 0; pos != m->size; ++pos) {
+		if (shared_av_should_stop(shared, device_id)) {
+			break;
+		}
+
+		ret = com_send_and_read_dlms_packet(dev, m->data[pos], reply);
+		if (ret != DLMS_ERROR_CODE_OK) {
+			ERROR("Failed to send_and_read_dlms_packet: %s", hlp_getErrorMessage(ret));
+			goto end;
+		}
+
+		while (reply_isMoreData(reply)) {
+			if (shared_av_should_stop(shared, device_id)) {
+				break;
+			}
+
+			ret = cl_receiverReady(s, reply->moreData, &rr);
+			if (ret != DLMS_ERROR_CODE_OK) {
+				ERROR("Failed to cl_receiverReady: %s", hlp_getErrorMessage(ret));
+				goto end;
+			}
+
+			ret = com_send_and_read_dlms_packet(dev, &rr, reply);
+			if (ret != DLMS_ERROR_CODE_OK) {
+				ERROR("[while] Failed to send_and_read_dlms_packet: %s", hlp_getErrorMessage(ret));
+				goto end;
+			}
+
+			shared_av_bump_progress(shared, device_id);
+			bb_clear(&rr);
+		}
+	}
+
+	ret = 0;
+end:
+	bb_clear(&rr);
+	return ret;
+}
+
+static int read_association_view(physical_device *d, database *db, shared_memory_ctx *shared)
+{
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+	dlmsSettings *s = &d->settings;
+
+	database_av_transaction transaction = { 0 };
+	gxReplyData reply = { 0 };
+	message data	  = { 0 };
+	mes_init(&data);
+	reply_init(&reply);
+
+	int device_id = d->id;
+
+	ret = cl_getObjectsRequest(s, &data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		ERROR("cl_getObjectsRequest failed: %s", hlp_getErrorMessage(ret));
+		return -1;
+	}
+
+	INFO("Starting association view reading");
+
+	ret = read_data_block_association_view(shared, d, &data, &reply, device_id);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		ERROR("com_read_data_block_association_view failed: %s", hlp_getErrorMessage(ret));
+		return ret;
+	}
+
+	if (shared_av_should_stop(shared, device_id)) {
+		return DLMS_ERROR_CODE_OK;
+	}
+
+	uint16_t count = 0;
+	ret = cl_parseObjectCount(&reply.data, &count);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		ERROR("cl_parseObjectCount failed: %s", hlp_getErrorMessage(ret));
+		return ret;
+	}
+
+	if (db_begin_transaction(&transaction, db)) {
+		goto end;
+	}
+
+	for (uint16_t pos = 0; pos != count; ++pos) {
+		if (shared_av_should_stop(shared, device_id)) {
+			break;
+		}
+
+		gxObject obj = { 0 };
+		ret = cl_parseNextObject(s, &reply.data, &obj);
+		if (ret != DLMS_ERROR_CODE_OK) {
+			break;
+		}
+
+		char obis[32] = { 0 };
+		hlp_getLogicalNameToString(obj.logicalName, obis);
+
+		db_write_association_view_object(&transaction, d->id, obj.objectType, obis, obj.shortName);
+		if (pos != 0 && pos % 50 == 0) { // reduce load for database
+			db_end_transaction(&transaction);
+			if (db_begin_transaction(&transaction, db)) {
+				goto end;
+			}
+		}
+	}
+
+	ret = DLMS_ERROR_CODE_OK;
+end:
+	db_end_transaction(&transaction);
+	return ret;
+}
+
+static void scan_process(shared_memory_ctx *shared, physical_device *device)
+{
+	database db = { 0 };
+	int device_id = device->id;
+
+	if (db_init(&db)) {
+		ERROR("Failed to initialize database");
+		goto end;
+	}
+
+	if (shared_av_start(shared, device_id, getpid())) {
+		ERROR("Failed to association view scan");
+		goto end;
+	}
+
+	int rc = com_open_connection(device);
+	if (rc != DLMS_ERROR_CODE_OK) {
+		shared_av_set_error_by_id(shared, device_id, "Failed to make connection with device");
+		goto end;
+	}
+
+	db_clear_association_view_objects(&db, device_id);
+
+	rc = read_association_view(device, &db, shared);
+	if (rc != DLMS_ERROR_CODE_OK) {
+		ERROR("Failed to read association view: %s", hlp_getErrorMessage(rc));
+		shared_av_set_error_by_id(shared, device_id, "Failed to read association view");
+		goto end;
+	}
+
+	shared_av_set_status(shared, device_id, SCAN_STATUS_COMPLETED);
+end:
+	com_close_connection(device, false);
+
+	shared_deinit(shared);
+	db_deinit(&db);
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/shared_memory.c src/src/shared_memory.c
--- upstream/src/shared_memory.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/shared_memory.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,515 @@
+#include "common.h"
+
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <sys/file.h>
+
+// When adding new public function to `shared_` namespace, make sure to use `utl_assert_mutex_lock` in
+// every function. Private/internal can omit the mutex lock if all places that call that function already
+// have the mutex locked.
+
+typedef struct {
+	// An ID of 0 is considered to be empty. That this mutex is not being used.
+	int id;
+
+	// Will be locked while that device is being used
+	struct ticket_mutex mutex;
+} shared_physical_device_mutex;
+
+typedef struct {
+	bool should_stop;
+	pid_t process;
+
+	association_view_info info;
+} shared_association_view;
+
+typedef struct shared_memory_block {
+	bool initialized;
+
+	// Will be locked whenever anything in `association_views` or `connections_locks` is being modified/read
+	pthread_mutex_t global_mutex;
+
+	// When directly accessing entry from `association_views`, the function `shared_av_check_errors` must
+	// be called on the gotten association view.
+	shared_association_view association_views[MAX_PHYSICAL_DEVICES_COUNT];
+	size_t association_views_len;
+
+	connection_lock connections_locks[MAX_CONNECTIONS_COUNT];
+} shared_memory_block;
+
+#define SHM_NAME "/dlms_shared_state"
+
+static int shared_shm_init(shared_memory_block *shm);
+static void shared_av_set_error(shared_association_view *av, const char *error);
+
+int shared_init(shared_memory_ctx *shared)
+{
+	int rc = -1;
+	int shm_fd = -1;
+	shared_memory_block *shm = NULL;
+
+	shm_fd = shm_open(SHM_NAME, O_CREAT | O_RDWR, S_IRUSR | S_IWUSR);
+	if (shm_fd == -1) {
+		ERROR("Failed to open shared memory file");
+		goto end;
+	}
+
+	if (ftruncate(shm_fd, sizeof(shared_memory_block))) {
+		ERROR("Failed to truncate shared memory file");
+		goto end;
+	}
+
+	shm = mmap(NULL, sizeof(shared_memory_block), PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);
+	if (shm == NULL) {
+		ERROR("Failed to map shared memory");
+		goto end;
+	}
+
+	if (!shm->initialized) {
+		bool failed_to_initialize = false;
+
+		if (flock(shm_fd, LOCK_EX)) {
+			ERROR("Failed to lock shared memory file: %s", strerror(errno));
+			goto end;
+		}
+
+		// Checking `!shm->initialized` a second time is required, because there is no guarentee
+		// that only one process will pass this `flock` section.
+		// Because there is a gap between the previous `if (!shm->initialized)` and `flock(shm_fd, LOCK_EX)`
+		if (!shm->initialized && shared_shm_init(shm)) {
+			failed_to_initialize = true;
+		}
+
+		if (flock(shm_fd, LOCK_UN)) {
+			ERROR("Failed to unlock shared memory file: %s", strerror(errno));
+			goto end;
+		}
+
+		if (failed_to_initialize) {
+			ERROR("Failed to initialize strcutres in shared memory");
+			goto end;
+		}
+	}
+
+	shared->shm_fd = shm_fd;
+	shared->shm = shm;
+
+	rc = 0;
+end:
+	if (rc) {
+		munmap(shm, sizeof(shared_memory_block));
+		close(shm_fd);
+	}
+	return rc;
+}
+
+static int shared_shm_init(shared_memory_block *shm)
+{
+	memset(shm, 0, sizeof(*shm));
+	int rc = -1;
+
+	for (size_t i = 0; i < ARRAY_SIZE(shm->connections_locks); i++) {
+		connection_lock *lock = &shm->connections_locks[i];
+		memset(lock, 0, sizeof(*lock));
+
+		struct ticket_mutex_options options = {
+			.process_shared = true,
+			.robust = true
+		};
+		if (ticket_mutex_init(&lock->mutex, options)) {
+			ERROR("Failed to initialize connection mutex");
+			goto end;
+		}
+	}
+
+	shm->initialized = true;
+
+	rc = 0;
+end:
+	return rc;
+}
+
+void shared_clear_all()
+{
+	shm_unlink(SHM_NAME);
+}
+
+void shared_deinit(shared_memory_ctx *shared)
+{
+	munmap(shared->shm, sizeof(shared_memory_block));
+	shared->shm = NULL;
+
+	close(shared->shm_fd);
+	shared->shm_fd = -1;
+}
+
+static void shared_av_init(shared_association_view *av, int device_id)
+{
+	memset(av, 0, sizeof(*av));
+	av->info.physical_device_id = device_id;
+}
+
+static int shared_av_find_index_by_device_id(shared_memory_ctx *shared, int device_id)
+{
+	for (size_t i = 0; i < shared->shm->association_views_len; i++) {
+		shared_association_view *av = &shared->shm->association_views[i];
+		if (av->info.physical_device_id == device_id) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+static int shared_av_remove_by_device_id(shared_memory_ctx *shared, int device_id)
+{
+	int av_index = shared_av_find_index_by_device_id(shared, device_id);
+	if (av_index == -1) {
+		return -1;
+	}
+
+	shared_association_view *avs = shared->shm->association_views;
+	size_t *avs_len = &shared->shm->association_views_len;
+
+	// Swap remove
+	if ((*avs_len) > 1 && (size_t)av_index < (*avs_len) - 1) {
+		avs[av_index] = avs[(*avs_len) - 1];
+	}
+	(*avs_len)--;
+	return 0;
+}
+
+static bool shared_av_is_scan_running(enum scan_status status)
+{
+	return status == SCAN_STATUS_STOPPING || status == SCAN_STATUS_IN_PROGRESS;
+}
+
+static void shared_av_check_errors(shared_association_view *av)
+{
+	// If scan is still marked as running, but the process doesn't exist.
+	// Then mark that an error occured
+	if (shared_av_is_scan_running(av->info.status)) {
+		bool is_process_running = kill(av->process, 0) == 0;
+		if (!is_process_running) {
+			shared_av_set_error(av, "Scan crashed");
+		}
+	}
+}
+
+static shared_association_view *shared_av_get_by_device_id(shared_memory_ctx *shared, int device_id)
+{
+	int av_index = shared_av_find_index_by_device_id(shared, device_id);
+	if (av_index == -1) {
+		return NULL;
+	}
+
+	shared_association_view *av = &shared->shm->association_views[av_index];
+	shared_av_check_errors(av);
+
+	return av;
+}
+
+static shared_association_view *shared_av_add_by_device_id(shared_memory_ctx *shared, int device_id)
+{
+	shared_association_view *avs = shared->shm->association_views;
+	size_t *avs_len = &shared->shm->association_views_len;
+
+	if (*avs_len == ARRAY_SIZE(shared->shm->association_views)) {
+		ERROR("Maximum number of association view scans reached");
+		return NULL;
+	}
+
+	shared_association_view *av = &avs[(*avs_len)++];
+	shared_av_init(av, device_id);
+
+	return av;
+}
+
+enum scan_status shared_av_get_status(shared_memory_ctx *shared, int device_id)
+{
+	enum scan_status result = SCAN_STATUS_IDLE;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av != NULL) {
+		result = av->info.status;
+	}
+
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return result;
+}
+
+int shared_av_start(shared_memory_ctx *shared, int device_id, pid_t process)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av != NULL) {
+		if (shared_av_is_scan_running(av->info.status)) {
+			goto end;
+		}
+
+		shared_av_init(av, device_id);
+	} else {
+		av = shared_av_add_by_device_id(shared, device_id);
+		if (!av) {
+			goto end;
+		}
+	}
+
+	av->process = process;
+	av->info.status = SCAN_STATUS_IN_PROGRESS;
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+int shared_av_stop(shared_memory_ctx *shared, int device_id)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av == NULL) {
+		goto end;
+	}
+
+	if (!shared_av_is_scan_running(av->info.status)) {
+		goto end;
+	}
+
+	av->should_stop = true;
+	av->info.status = SCAN_STATUS_STOPPING;
+
+	while (true) {
+		utl_assert_mutex_unlock(&shared->shm->global_mutex);
+		sleep(1);
+		utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+		shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+		if (av == NULL) {
+			break;
+		}
+
+		if (!shared_av_is_scan_running(av->info.status)) {
+			break;
+		}
+	}
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+bool shared_av_should_stop(shared_memory_ctx *shared, int device_id)
+{
+	bool result = false;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av == NULL) {
+		goto end;
+	}
+
+	result = av->should_stop; 
+
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return result;
+}
+
+int shared_av_copy_all(shared_memory_ctx *shared, association_view_info *av_infos, size_t *count, size_t capacity)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	if (shared->shm->association_views_len > capacity) {
+		goto end;
+	}
+
+	for (size_t i = 0; i < shared->shm->association_views_len; i++) {
+		shared_association_view *av = &shared->shm->association_views[i];
+		shared_av_check_errors(av);
+
+		av_infos[i] = av->info;
+	}
+
+	*count = shared->shm->association_views_len;
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+int shared_av_set_status(shared_memory_ctx *shared, int device_id, enum scan_status status)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av == NULL) {
+		goto end;
+	}
+
+	av->info.status = status;
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+int shared_av_bump_progress(shared_memory_ctx *shared, int device_id)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av == NULL) {
+		goto end;
+	}
+
+	av->info.progress++;
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+static void shared_av_set_error(shared_association_view *av, const char *error)
+{
+	av->info.status = SCAN_STATUS_ERROR;
+	strlcpy(av->info.error, error, sizeof(av->info.error));
+	ERROR("Association view error: %s", error);
+}
+
+int shared_av_set_error_by_id(shared_memory_ctx *shared, int device_id, const char *error)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	shared_association_view *av = shared_av_get_by_device_id(shared, device_id);
+	if (av == NULL) {
+		goto end;
+	}
+
+	shared_av_set_error(av, error);
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+int shared_av_clear(shared_memory_ctx *shared, int device_id)
+{
+	int rc = -1;
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+
+	if (shared_av_remove_by_device_id(shared, device_id)) {
+		goto end;
+	}
+
+	rc = 0;
+end:
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	return rc;
+}
+
+// ------------------------------- Connections locks ------------------------------- //
+
+// BE CAREFUL! This function doesn't lock `shared->shm->global_mutex`.
+// It is expected that it will be locked by the caller
+static connection_lock *shared_connection_lock_acquire_unused(shared_memory_ctx *shared)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(shared->shm->connections_locks); i++) {
+		connection_lock *lock = &shared->shm->connections_locks[i];
+		if (lock->ref_count == 0) {
+			lock->ref_count += 1;
+			return lock;
+		}
+	}
+
+	log(L_WARNING, "Failed to find unused connection lock, all locks are in use");
+	return NULL;
+}
+
+connection_lock *shared_connection_lock_acquire_tcp(shared_memory_ctx *shared, struct sockaddr *addr)
+{
+	connection_lock *result = NULL;
+
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+	for (size_t i = 0; i < ARRAY_SIZE(shared->shm->connections_locks); i++) {
+		connection_lock *lock = &shared->shm->connections_locks[i];
+		if (lock->ref_count > 0 && lock->is_tcp && utl_sockaddr_eql((struct sockaddr *)&lock->tcp, addr)) {
+			lock->ref_count += 1;
+			result = lock;
+			break;
+		}
+	}
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+
+	if (result == NULL) {
+		utl_assert_mutex_lock(&shared->shm->global_mutex);
+		result = shared_connection_lock_acquire_unused(shared);
+		if (result != NULL) {
+			result->is_tcp = true;
+			if (addr->sa_family == AF_INET) {
+				memcpy(&result->tcp, addr, sizeof(struct sockaddr_in));
+			} else if (addr->sa_family == AF_INET6) {
+				memcpy(&result->tcp, addr, sizeof(struct sockaddr_in6));
+			} else {
+				assert(false); // This should never be reached
+			}
+		}
+		utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	}
+
+
+	return result;
+}
+
+connection_lock *shared_connection_lock_acquire_serial(shared_memory_ctx *shared, const char *device)
+{
+	connection_lock *result = NULL;
+
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+	for (size_t i = 0; i < ARRAY_SIZE(shared->shm->connections_locks); i++) {
+		connection_lock *lock = &shared->shm->connections_locks[i];
+		if (lock->ref_count > 0 && !lock->is_tcp && !strncmp(lock->serial, device, sizeof(lock->serial))) {
+			lock->ref_count += 1;
+			result = lock;
+			break;
+		}
+	}
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+
+	if (result == NULL) {
+		utl_assert_mutex_lock(&shared->shm->global_mutex);
+		result = shared_connection_lock_acquire_unused(shared);
+		if (result != NULL) {
+			result->is_tcp = false;
+			strlcpy(result->serial, device, sizeof(result->serial));
+		}
+		utl_assert_mutex_unlock(&shared->shm->global_mutex);
+	}
+
+	return result;
+}
+
+void shared_connection_lock_release(shared_memory_ctx *shared, connection_lock *lock)
+{
+	if (lock == NULL) {
+		return;
+	}
+
+	utl_assert_mutex_lock(&shared->shm->global_mutex);
+	assert(lock->ref_count > 0);
+	lock->ref_count -= 1;
+	utl_assert_mutex_unlock(&shared->shm->global_mutex);
+}
