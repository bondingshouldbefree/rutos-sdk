-
-#ifdef DLMS_IGNORE_MALLOC
-    arr = &settings->transaction.targets;
-    if (arr->capacity == 0)
-    {
-        return DLMS_ERROR_CODE_INVALID_PARAMETER;
-    }
-    e = &arr->data[0];
-    ve_clear(e);
