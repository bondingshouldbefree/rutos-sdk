-void GXTRACE(const char* str, const char* data)
-{
-  //Send trace to the serial port in test mode.
-  if (GX_GET_BOOL(testMode.value))
-  {
-    byte c;
-    Serial1.write("\t:", 2);
-    while ((c = pgm_read_byte(str++)) != 0)
-    {
-      Serial1.write(c);
-    }
-    if (data != NULL)
-    {
-      Serial1.write(data, strlen(data));
-    }
-    Serial1.write("\0", 1);
