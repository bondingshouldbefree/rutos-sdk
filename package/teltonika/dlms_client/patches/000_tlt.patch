diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/Makefile src/Makefile
--- upstream/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ src/Makefile	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,28 @@
+SOURCES_COMMON = $(wildcard src/*.c)
+DEPENDS_COMMON = $(wildcard include/*.h)
+
+SOURCES_APP = $(wildcard src/app/*.c)
+SOURCES_RPC = $(wildcard src/rpc/*.c)
+
+TARGET_APP = dlms_client
+TARGET_RPC = dlms_client.so
+
+LDLIBS += -lubus -lubox -lsqlite3 -ltlt_logger -lcfgx -lsqlite3 -ltlt_uci
+LDLIBS += -luci -lblobmsg_json -ltlt_termios -lgurux_dlms_c -lticket_mutex -latomic
+LDLIBS_APP = -lpthread 
+
+CFLAGS += -D_GNU_SOURCE -DCONFIG_MACHINE_$(TLT_PLATFORM_NAME) -Iinclude
+CFLAGS += -Wall -Wextra -Werror -pedantic -fno-common -ffunction-sections -fdata-sections -Wundef
+
+all: $(TARGET_APP) $(TARGET_RPC)
+
+$(TARGET_APP): $(SOURCES_COMMON) $(SOURCES_APP) $(DEPENDS_COMMON)
+	$(CC) $(CFLAGS) -o $@ $(LDFLAGS) $(SOURCES_COMMON) $(SOURCES_APP) $(LDLIBS) $(LDLIBS_APP)
+
+$(TARGET_RPC): $(SOURCES_COMMON) $(SOURCES_RPC) $(DEPENDS_COMMON)
+	$(CC) -o $@ -fPIC $(CFLAGS) -shared $(LDFLAGS) $(SOURCES_COMMON) $(SOURCES_RPC) $(LDLIBS)
+
+clean:
+	rm -f $(TARGET_APP) $(TARGET_RPC)
+
+.PHONY: all, clean
