-            else
-            {
-                type = DLMS_DATA_TYPE_NONE;
-                size = 0;
-            }
-        }
-        if (dataTypes != NULL)
-        {
-            dataTypes[pos] = type;
-        }
-        if (columnSizes != NULL)
-        {
-            columnSizes[pos] = (uint8_t)size;
-        }
-        *rowSize += (uint16_t)size;
-        ve_clear(&e);
-    }
