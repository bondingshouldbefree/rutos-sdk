-  gxValueEventCollection * args)
-{
-  gxValueEventArg* e;
-  int ret, pos;
-  for (pos = 0; pos != args->size; ++pos)
-  {
-    if ((ret = vec_getByIndex(args, pos, &e)) != 0)
-    {
-      return;
-    }
-  }
-}
-
-void svr_postGet(
-  dlmsSettings * settings,
-  gxValueEventCollection * args)
-{
-
-}
-
