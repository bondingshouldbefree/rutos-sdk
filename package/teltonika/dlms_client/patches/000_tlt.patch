-        return ret;
-    }
-    // Get invoke ID and priority.
-    if ((ret = bb_getUInt8(data, &invokeId)) != 0)
-    {
-        return ret;
-    }
-    updateInvokeId(settings, invokeId);
-    // CI
-    if ((ret = bb_getUInt16(data, &tmp)) != 0)
