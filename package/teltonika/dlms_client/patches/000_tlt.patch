+	char str[1028] 	 = { 0 };
+
+	va_list args;
+	va_start(args, format);
+	vsnprintf(result, 512, format, args);
+	va_end(args);
+
+	utl_append_obj_name(data, device_name);
+	snprintf(str, sizeof(str), "{\"error\": %d, \"result\": \"%s\"}", err_num, result);
+	utl_append_to_str(data, str);
+}
+
+void utl_smart_sleep(time_t *t0, time_t *tn, unsigned p)
+{
+	++*tn;
+
+	time_t target = *t0 + *tn * p;
+	time_t now    = time(NULL);
+
+	if (target > now) {
+		sleep(target - now);
+	}
+
+	if (llabs(target - now) > p * 2) {
+		*t0 = now;
+		*tn = 0;
+	}
+}
