-static inline int uart_traceWrite(const char* data)
-{
-#ifdef UBRR1H	
-	if (data != NULL)
-	{		
-		int pos, len = strlen(data);
-		for(pos = 0; pos < len; ++pos)
-		{
-			uart_putTraceChar(data[pos]);
-		}
-	}
-#endif //UBRR1H
-	return 0;
-}
