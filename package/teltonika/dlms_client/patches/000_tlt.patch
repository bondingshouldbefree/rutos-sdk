-        }
-        if (p->command == DLMS_COMMAND_EVENT_NOTIFICATION ||
-            p->command == DLMS_COMMAND_DATA_NOTIFICATION ||
-            p->command == DLMS_COMMAND_ACCESS_REQUEST ||
