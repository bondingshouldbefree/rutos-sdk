+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	size_t offset = 0;
+	if (rows->size > entries) {
+		offset = rows->size - entries;
+	}
+
+	bb_addString(&bb, "[");
+	for (size_t r = offset; r != rows->size; ++r) {
+		variantArray *va = NULL;
+		if (arr_getByIndex(rows, r, (void **)&va)) {
+			goto end;
+		}
+
+		for (size_t c = 0; c != va->size; ++c) {
+			if (c != 0) {
+				bb_addString(&bb, ",");
+			}
+
+			dlmsVARIANT *tmp = NULL;
+			if (va_getByIndex(va, c, &tmp)) {
+				goto end;
+			}
+
+			if (var_toString(tmp, &bb)) {
+				goto end;
+			}
+		}
+		bb_addString(&bb, ";");
+	}
+	bb_addString(&bb, "]");
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
