-	if ((ret = cosem_init2(&clock1.base, DLMS_OBJECT_TYPE_CLOCK, ln)) != 0)
-	{
-		return ret;
-	}
-	time_init3(&clock1.begin, -1, 9, 1, -1, -1, -1, -1);
-	time_init3(&clock1.end, -1, 3, 1, -1, -1, -1, -1);
-	return 0;
-}
