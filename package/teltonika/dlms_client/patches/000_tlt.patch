-/**
- * \brief The array of interrupt handlers
- */
-struct _irq_descriptor *_irq_table[PERIPH_COUNT_IRQn];
-
-/**
- * \brief Reset MCU
- */
-void _reset_mcu(void)
-{
-	NVIC_SystemReset();
-}
