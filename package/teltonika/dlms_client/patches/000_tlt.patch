-        frame = getNextSend(&settings->base, 0);
-        break;
-    default:
-        //Invalid command.
-#ifdef DLMS_DEBUG
-        svr_notifyTrace("Unknown command. ", cmd);
-#endif //DLMS_DEBUG
-        ret = DLMS_ERROR_CODE_INVALID_COMMAND;
-    }
-    if (ret == DLMS_ERROR_CODE_INVALID_COMMAND)
-    {
-        bb_clear(data);
