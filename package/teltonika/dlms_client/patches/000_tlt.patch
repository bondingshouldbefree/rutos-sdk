- */
-static int32_t _spi_async_enable(void *const hw)
-{
-	_spi_sync_enable(hw);
-	uint8_t irq = _sercom_get_irq_num(hw);
-	for (uint32_t i = 0; i < 4; i++) {
-		NVIC_EnableIRQ((IRQn_Type)irq++);
-	}
-
-	return ERR_NONE;
-}
