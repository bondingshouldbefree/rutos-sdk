-{
-#ifdef __AVR__
-	while (data->position < data->size)
-	{
-		uart_putchar(data->data[data->position]);
-		++data->position;
-	}
-#endif //__AVR__
-#ifdef __ASF__
-	int ret;
-	while (bb_available(data) > 0)
-	{
-		ret = io_write(io, data->data + data->position, bb_available(data));
-		if (ret > 0)
-		{			
-			data->position += ret;
-		}
-	}
-#endif //__ASF__
