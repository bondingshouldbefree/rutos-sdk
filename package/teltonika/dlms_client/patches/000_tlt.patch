-                    return ret;
-                }
-                bb_clear(&bb);
-                if (list->size - pos < count)
-                {
-                    hlp_setObjectCount(list->size - pos, &bb);
-                }
-                else
-                {
-                    hlp_setObjectCount(count, &bb);
-                }
-            }
