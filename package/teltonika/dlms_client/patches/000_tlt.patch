--- upstream/files/migrations/7.21/01-migrate_obis_option	1970-01-01 00:00:00.000000000 +0000
+++ src/files/migrations/7.21/01-migrate_obis_option	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,25 @@
+#!/bin/sh
+
+. /lib/functions.sh
+
+CONFIG=dlms_client
+
+migrate_cosem_obis_option() {
+	local section="$1"
+	local obis
+
+	config_get "obis" "$section" obis
+	if echo "$obis" | grep -qE '^\d+\.\d+\.\d+\.\d+\.\d+\.\d+$'; then
+		uci_set "$CONFIG" "$section" "logical_name" "$obis"
+	elif echo "$obis" | grep -qE '^\d+$'; then
+		uci_set "$CONFIG" "$section" "short_name" "$obis"
+	fi
+	uci_set "$CONFIG" "$section" "obis" ""
+}
+
+config_load "$CONFIG" || exit 0
+config_foreach migrate_cosem_obis_option cosem
+
+uci_commit "dlms_client"
+
+exit 0
