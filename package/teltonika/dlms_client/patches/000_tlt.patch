+static dlms_cfg *cfg_read_dlms_cfg(cfgx_context_t *ctx)
+{
+	dlms_cfg *cfg = NULL;
+	dlms_cfg *result = NULL;
+
+	cfg = calloc(1, sizeof(dlms_cfg));
+	if (!cfg) {
+		ERROR("Unable to allocate memory");
+		goto end;
+	}
+
+	cfg->connections = cfg_read_connections(ctx, &cfg->connection_cfg_count);
+	if (!cfg->connections) {
+		ERROR("Failed to read connections");
+		goto end;
+	}
+
+	cfg->physical_devices = cfg_read_physical_devices(ctx, &cfg->physical_device_cfg_count);
+	if (!cfg->physical_devices) {
+		ERROR("Failed to read physical devices");
+		goto end;
+	}
+
+	cfg->cosem_objects = cfg_read_cosem_objects(ctx, &cfg->cosem_object_cfg_count);
+	if (!cfg->cosem_objects) {
+		ERROR("Failed to read cosem objects");
+		goto end;
+	}
+
+	cfg->cosem_groups = cfg_read_cosem_groups(ctx, &cfg->cosem_group_cfg_count);
+	if (!cfg->cosem_groups) {
+		ERROR("Failed to read cosem groups");
+		goto end;
+	}
+
+	result = cfg;
+end:
+	if (!result) {
+		cfg_free_dlms_cfg(cfg);
+	}
+	return result;
+}
