-        {
-        case 2:
-            //Secret.
-            ret = GET_ATTRIBUTE(7);
-            break;
-        case 3:
-        case 4:
-            //Object.
-            ret = GET_ATTRIBUTE(2);
-            break;
-        case 5:
-        case 6:
-            //User.
-            ret = GET_ATTRIBUTE(10);
-            break;
-        default:
-            break;
-        }
-        break;
-    case DLMS_OBJECT_TYPE_SECURITY_SETUP:
-        switch (methodIndex)
-        {
-        case 1:
-            //Activate Security policy.
-            ret = GET_ATTRIBUTE(2);
-            break;
-        case 2:
-            //Key transfer. TODO: Check this when SS 1 is released.
-            ret = GET_ATTRIBUTE(7);
