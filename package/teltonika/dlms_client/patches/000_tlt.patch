-	__DSB();
-	__WFI();
-}
-
-/**
- * \brief Retrieve current IRQ number
- */
-uint8_t _irq_get_current(void)
-{
-	return (uint8_t)__get_IPSR() - 16;
-}
-
-/**
- * \brief Disable the given IRQ
- */
-void _irq_disable(uint8_t n)
-{
-	NVIC_DisableIRQ((IRQn_Type)n);
-}
-
-/**
- * \brief Set the given IRQ
- */
