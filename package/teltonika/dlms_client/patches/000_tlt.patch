-                printf("Missing mandatory port option.\n");
-            }
-            else if (optarg[0] == 't')
-            {
-                printf("Missing mandatory trace option.\n");
-            }
-            else
-            {
-                showHelp();
-                return 1;
-            }
-        }
-        break;
-        default:
