+	if (attribute == 1) {
+		return attr_obis_to_string(&object->base, ctx->use_ln_ref);
+	} else if (attribute == 2) {
+		return attr_action_items_array_to_string(&object->actions);
+	} else if (attribute == 3) {
+		return attr_permissions_table_to_string(&object->permissionsTable);
+	} else {
+		return NULL;
+	}
+}
+
+// TODO: Update `attr_object_attribute_to_string` so that each attribute wouldn't need to be malloc'ed
+// Pass in a context where formatted attribute would be appended.
+// Instead of currently returning a malloc'ed string.
+char *attr_object_attribute_to_string(attr_ctx *ctx, int attribute)
+{
+	switch (ctx->object->objectType) {
+		case DLMS_OBJECT_TYPE_DATA:
+			return attr_gx_data_to_string(ctx, attribute);
