diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/app/main.c src/src/app/main.c
--- upstream/src/app/main.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/main.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,210 @@
+#include "app.h"
+
+#include "common.h"
+#include <signal.h>
+#include <stdatomic.h>
+
+service *g_service	   = NULL;
+database g_db		   = { 0 };
+shared_memory_ctx g_shared = { 0 };
+
+static pthread_t g_group_threads[MAX_COSEM_GROUPS_COUNT] = { 0 };
+static size_t g_group_thread_count			 = 0;
+static atomic_bool g_shutdown_requested			 = false;
+
+bool app_is_shutdown_requested(void)
+{
+	return atomic_load(&g_shutdown_requested);
+}
+
+static void signal_handler(int signum);
+static void set_signal_actions(void);
+static void shutdown_group_threads(void);
+static void *group_thread_routine_cb(void *p);
+static int initialize_cosem_groups();
+
+int main(int argc, char **argv)
+{
+	int rc = EXIT_FAILURE;
+	set_signal_actions();
+
+	if (utl_parse_debug_level(argc, argv)) {
+		fprintf(stderr, "Failed to parse arguments\n");
+		goto err;
+	}
+
+	if (shared_init(&g_shared)) {
+		log(L_EMERG, "Failed to initialize shared service state");
+		goto err;
+	}
+
+	g_service = cfg_get_service_uci(&g_shared);
+	if (!g_service) {
+		log(L_EMERG, "Failed to read configuration");
+		goto err_deinit_shared;
+	}
+
+	if (service_ubus_object_init()) {
+		log(L_ERROR, "Failed to initialize ubus object\n");
+		goto err_free_service;
+	}
+
+	// utl_debug_service(g_service);
+
+	if (db_init(&g_db)) {
+		log(L_EMERG, "Failed to create database");
+		goto err_free_service;
+	}
+
+	if (initialize_cosem_groups()) {
+		log(L_EMERG, "Failed to initialize COSEM groups");
+		goto err_deinit_db;
+	}
+
+	uloop_run();
+	uloop_done();
+
+	rc = 0;
+err_deinit_db:
+	db_deinit(&g_db);
+err_free_service:
+	cfg_free_service(g_service);
+err_deinit_shared:
+	shared_deinit(&g_shared);
+err:
+	return rc;
+}
+
+static int initialize_cosem_groups()
+{
+	service *s = g_service;
+
+	if (s->cosem_group_count == 0) {
+		return 0;
+	}
+
+	g_group_thread_count = s->cosem_group_count;
+
+	for (size_t i = 0; i < s->cosem_group_count; i++) {
+		if (pthread_create(&g_group_threads[i], NULL, group_thread_routine_cb, s->cosem_groups[i])) {
+			log(L_ERROR, "Failed to initialize COSEM group thread: %s",
+			    UTL_SAFE_STR(s->cosem_groups[i]->name));
+			return 1;
+		}
+	}
+
+	return 0;
+}
+
+static void thread_cleanup_handler(void *arg)
+{
+	cosem_group *group = (cosem_group *)arg;
+	log(L_DEBUG, "Cleanup handler called for group '%s'", UTL_SAFE_STR(group->name));
+
+	for (size_t i = 0; i < group->cosem_object_count; i++) {
+		cosem_object *obj = group->cosem_objects[i];
+		for (size_t j = 0; j < obj->device_count; j++) {
+			physical_device *dev = obj->devices[j];
+			if (dev && dev->connection) {
+				com_close_connection(dev, false);
+			}
+		}
+	}
+}
+
+static void *group_thread_routine_cb(void *p)
+{
+	cosem_group *group = (cosem_group *)p;
+	time_t t0	   = time(NULL);
+	time_t tn	   = 0;
+
+	pthread_cleanup_push(thread_cleanup_handler, group);
+
+	while (!atomic_load(&g_shutdown_requested)) {
+		int rc	   = 0;
+		char *data = cg_read_cosem_group(group, &rc, &g_shared);
+		if (rc || !data) {
+			const char *safe_group_name = UTL_SAFE_STR(group->name);
+			const char *safe_data	    = UTL_SAFE_STR(data);
+			ERROR("('%d', '%s') Not writing to the database: %s", group->id, safe_group_name,
+			      safe_data);
+			goto end;
+		}
+
+		database_cosem_group database_entry = {
+			.result = data,
+			.name	= group->name,
+			.id	= group->id,
+		};
+		db_write_cosem_group(&g_db, &database_entry);
+end:
+		free(data);
+		data = NULL;
+
+		if (atomic_load(&g_shutdown_requested)) {
+			break;
+		}
+
+		utl_smart_sleep(&t0, &tn, group->interval);
+	}
+
+	pthread_cleanup_pop(0);
+
+	log(L_INFO, "Thread for group '%s' exiting gracefully", UTL_SAFE_STR(group->name));
+	return NULL;
+}
+
+static void shutdown_group_threads(void)
+{
+	if (g_group_thread_count == 0) {
+		return;
+	}
+
+	log(L_INFO, "Signaling %zu group threads to shutdown", g_group_thread_count);
+	atomic_store(&g_shutdown_requested, true);
+
+	for (size_t i = 0; i < g_group_thread_count; i++) {
+		if (g_group_threads[i] != 0) {
+			log(L_DEBUG, "Canceling group thread %zu", i);
+			pthread_cancel(g_group_threads[i]);
+		}
+	}
+
+	for (size_t i = 0; i < g_group_thread_count; i++) {
+		if (g_group_threads[i] != 0) {
+			log(L_DEBUG, "Waiting for group thread %zu to exit", i);
+			int ret = pthread_join(g_group_threads[i], NULL);
+			if (ret) {
+				log(L_ERROR, "Failed to join group thread %zu: %d", i, ret);
+			} else {
+				log(L_DEBUG, "Group thread %zu exited", i);
+			}
+			g_group_threads[i] = 0;
+		}
+	}
+
+	g_group_thread_count = 0;
+	log(L_INFO, "All group threads have been shut down");
+}
+
+static void signal_handler(int signum)
+{
+	(void)signum;
+
+	signal(SIGINT, SIG_IGN);
+	signal(SIGTERM, SIG_IGN);
+	signal(SIGQUIT, SIG_IGN);
+
+	shutdown_group_threads();
+	db_deinit(&g_db);
+	cfg_free_service(g_service);
+	shared_deinit(&g_shared);
+	exit(0);
+}
+
+static void set_signal_actions(void)
+{
+	signal(SIGINT, signal_handler);
+	signal(SIGTERM, signal_handler);
+	signal(SIGQUIT, signal_handler);
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/app/ubus.c src/src/app/ubus.c
--- upstream/src/app/ubus.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/ubus.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,74 @@
+#include "app.h"
+
+static struct {
+	struct ubus_context ubus;
+	time_t started_at;
+} g_ubus_object = { 0 };
+
+static int ubus_status_cb(struct ubus_context *ctx, struct ubus_object *obj,
+			  struct ubus_request_data *req, const char *method, struct blob_attr *msg)
+{
+	(void)obj;
+	(void)method;
+	(void)msg;
+
+	int rc		  = UBUS_STATUS_UNKNOWN_ERROR;
+	struct blob_buf b = { 0 };
+
+	if (blob_buf_init(&b, 0)) {
+		log(L_ERROR, "blob_buf_init failure\n");
+		goto end;
+	}
+
+	if (blobmsg_add_u64(&b, "uptime", utl_time_monotonic_s() - g_ubus_object.started_at)) {
+		log(L_ERROR, "blobmsg_add_u64 failure\n");
+		goto end;
+	}
+
+	// TODO: Implement meaningfull statistics when #14928 is finished
+
+	if (ubus_send_reply(ctx, req, b.head)) {
+		log(L_ERROR, "ubus_send_reply failure\n");
+		goto end;
+	}
+
+	rc = UBUS_STATUS_OK;
+end:
+	blob_buf_free(&b);
+	return rc;
+}
+
+int service_ubus_object_init(void)
+{
+	int rc = -1;
+
+	static const struct ubus_method methods[] = {
+		UBUS_METHOD_NOARG("status", ubus_status_cb)
+	};
+
+	static struct ubus_object_type object_type = UBUS_OBJECT_TYPE(UBUS_OBJ_NAME ".app", methods);
+
+	static struct ubus_object service_ubus_object = {
+		.name	   = UBUS_OBJ_NAME ".app",
+		.type	   = &object_type,
+		.methods   = methods,
+		.n_methods = ARRAY_SIZE(methods),
+	};
+
+	if (ubus_connect_ctx(&g_ubus_object.ubus, NULL)) {
+		log(L_ERROR, "ubus_connect_ctx() failed\n");
+		goto end;
+	}
+
+	g_ubus_object.started_at = utl_time_monotonic_s();
+
+	if (ubus_add_object(&g_ubus_object.ubus, &service_ubus_object)) {
+		log(L_ERROR, "Failed to add UBUS object\n");
+		goto end;
+	}
+
+	ubus_add_uloop(&g_ubus_object.ubus);
+	rc = 0;
+end:
+	return rc;
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/src/attribute_converter.c src/src/attribute_converter.c
--- upstream/src/attribute_converter.c	1970-01-01 00:00:00.000000000 +0000
+++ src/src/attribute_converter.c	2026-01-23 11:55:51.000000000 +0000
@@ -0,0 +1,2253 @@
+#include "common.h"
+
+// Original: https://github.com/Gurux/GuruxDLMS.c/blob/master/development/src/converters.c
+// The current version has been HEAVILY refactored compared to the original, to fit our use case.
+//
+// The largest drawback of the original was that you couldn't format a single attribute from an object to a string.
+// You were required to format the whole object. 
+
+// Used this as a reference for checking what fields each object contains and what they mean
+// https://www.gurux.fi/Gurux.DLMS.Objects
+//
+// When looking at what attributes each data type has, the order of attribute won't be the same.
+// For example the webpage could describe attribute at index 5 being 'Current start time', but we are 
+// placing 'Capture time` at that index. This was probably a mistake, but now we need to keep it that way,
+// as to not break API.
+
+static char *attr_obis_to_string(gxObject *object, bool use_ln_ref)
+{
+	if (use_ln_ref) {
+		char *result = calloc(25, sizeof(char));
+		_check_alloc(result);
+		hlp_getLogicalNameToString(object->logicalName, result);
+		return result;
+	} else {
+		char *result = calloc(10, sizeof(char));
+		_check_alloc(result);
+		snprintf(result, 10, "%d", object->shortName);
+		return result;
+	}
+}
+
+static char *attr_variant_to_string(dlmsVARIANT *variant)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	if (var_toString(variant, &bb)) {
+		goto end;
+	}
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
+
+static char *attr_variant_array_to_string(variantArray *array, bool use_brackets)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	if (use_brackets) bb_addString(&bb, "[");
+
+	for (size_t pos = 0; pos != array->size; ++pos) {
+		dlmsVARIANT *tmp = NULL;
+		if (va_getByIndex(array, pos, &tmp)) {
+			goto end;
+		}
+
+		if (pos != 0) {
+			bb_addString(&bb, ", ");
+		}
+
+		if (var_toString(tmp, &bb)) {
+			goto end;
+		}
+	}
+
+	if (use_brackets) bb_addString(&bb, "]");
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
+
+static char *attr_int_to_string(int value)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	if (bb_addIntAsString(&bb, value)) {
+		goto end;
+	}
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
+
+static char *attr_time_to_string(const gxtime* time)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	if (time_toString(time, &bb)) {
+		goto end;
+	}
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
+
+// TODO: Why is doing an "attach" needed? Won't this just do a bunch a memcpy and nothing else?
+// Why is this needed? Investigate this.
+static char *attr_attach_string(gxByteBuffer *string_buffer)
+{
+	char *result = NULL; 
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	char *string = bb_toString(string_buffer);
+	if (!string) {
+		goto end;
+	}
+
+	// bb_attachString will always `string`, even on error.
+	if (bb_attachString(&bb, string)) {
+		goto end;
+	}
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
+
+static char *attr_season_profile_to_string(gxArray* arr)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	bb_addString(&bb, "[");
+	for (size_t pos = 0; pos != arr->size; ++pos) {
+		if (pos != 0) {
+			bb_addString(&bb, ", ");
+		}
+
+		gxSeasonProfile* it = NULL;
+		if (arr_getByIndex(arr, pos, (void**)&it)) {
+			goto end;
+		}
+
+		bb_addString(&bb, "{");
+		bb_attachString(&bb, bb_toHexString(&it->name));
+		bb_addString(&bb, ", ");
+		time_toString(&it->start, &bb);
+		bb_addString(&bb, ", ");
+		bb_attachString(&bb, bb_toHexString(&it->weekName));
+		bb_addString(&bb, "}");
+	}
