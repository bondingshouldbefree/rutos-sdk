-                while (reply_isMoreData(&reply))
-                {
-                    //NOTE! Set ignore value to true because list is parsed differently than normal read.
-                    reply.ignoreValue = 1;
-                    if ((ret = cl_receiverReady(&connection->settings, reply.moreData, &rr)) != DLMS_ERROR_CODE_OK ||
