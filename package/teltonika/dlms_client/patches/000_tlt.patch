-uint32_t svr_isChangedWithAction(DLMS_OBJECT_TYPE objectType, unsigned char methodIndex)
-{
-    uint32_t ret = 0;
-    switch (objectType)
-    {
-    case DLMS_OBJECT_TYPE_ASSOCIATION_LOGICAL_NAME:
