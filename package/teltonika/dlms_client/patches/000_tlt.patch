-            if (status == 0)
-            {
-                status = e->error;
-            }
-            if (status == 0)
-            {
-#ifdef DLMS_IGNORE_MALLOC
-                if (e->value.vt != DLMS_DATA_TYPE_OCTET_STRING)
-                {
-                    if ((ret = dlms_setData(data, e->value.vt, &e->value)) != 0)
-                    {
