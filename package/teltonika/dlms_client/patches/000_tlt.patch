-                    }
-#endif //DLMS_IGNORE_MALLOC
-                    settings->transaction.command = DLMS_COMMAND_SET_REQUEST;
-                }
-                if (ret == 0)
-                {
-                    if (e->error != 0)
-                    {
-                        bb_setUInt8ByIndex(&status, pos, e->error);
