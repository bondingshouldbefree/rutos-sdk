+}
+
+static struct cfgx_section *cfg_append_cosem_blobmsg(cfgx_context_t *ctx, struct blob_buf *buf, struct blob_attr *msg, int group_id)
+{
+	struct cfgx_section *result = NULL;
+
+	if (blobmsg_add_u8(buf, "enabled", true)) {
+		ERROR("Failed to append 'enabled' option");
+		goto end;
+	}
+
+	if (blobmsg_add_u32(buf, "cosem_group", group_id)) {
+		ERROR("Failed to append 'cosem_group' option");
+		goto end;
+	}
+
+	if (cfg_copy_blobmsg_fields(buf, msg)) {
+		ERROR("Failed to copy all fields from original blobmsg");
+		goto end;
+	}
+
+	struct cfgx_section *cosem_value = cfgx_context_append_section_blobmsg(ctx, buf->head);
+	if (!cosem_value) {
+		ERROR("Failed to append configuration section to context");
+		goto end;
+	}
+
+	cosem_value->type = strdup("cosem");
+	if (!cosem_value->type) {
+		ERROR("Failed to duplicate string: Out of memory");
+		goto end;
+	}
+
+	result = cosem_value;
+end:
+	return result;
+}
+
+physical_device *cfg_get_physical_device_blobmsg(struct blob_attr *msg, shared_memory_ctx *shared)
+{
+	enum {
+		DEVICE,
+		CONNECTION
+	};
+
+	struct blobmsg_policy physical_device_policy[] = {
+		[DEVICE] = { .name = "device", .type = BLOBMSG_TYPE_TABLE },
+		[CONNECTION] = { .name = "connection", .type = BLOBMSG_TYPE_TABLE },
+	};
+
+	physical_device *result = NULL;
+
+	cfgx_context_t *ctx = NULL;
+
+	struct blob_buf device_blobmsg = { 0 };
+	physical_device_cfg *device_cfg = NULL;
+	physical_device *device = NULL;
+
+	struct blob_buf connection_blobmsg = { 0 };
+	connection_params_cfg *connection_cfg = NULL;
+	connection *connection = NULL;
+
+	struct blob_attr *tb[ARRAY_SIZE(physical_device_policy)] = { 0 };
+	if (blobmsg_parse(physical_device_policy, ARRAY_SIZE(physical_device_policy), tb, blob_data(msg), blob_len(msg))) {
+		ERROR("Failed to parse physical device policy");
+		goto end;
+	}
+
+	ctx = cfgx_context_init_blobmsg();
+	if (!ctx) {
+		ERROR("Failed to create config context");
+		goto end;
+	}
+
+	int connection_id = 1;
+	int device_id = 2;
+
+	// Append, parse and initialize connection
+	{
+		struct cfgx_section *connection_section = cfg_append_connection_blobmsg(ctx, &connection_blobmsg, tb[CONNECTION]);
+		if (!connection_section) {
+			ERROR("Failed to append connection to context from blobmsg");
+			goto end;
+		}
+
+		connection_section->id = cfg_format_number(connection_id);
+		if (!connection_section->id) {
+			ERROR("Failed to format number to string: Out of memory");
+			goto end;
+		}
+
+		connection_cfg = cfg_read_connection(ctx, connection_section);
+		if (!connection_cfg) {
+			ERROR("Failed to parse connection");
+			goto end;
+		}
+
+		connection = cfg_get_connection(connection_cfg, shared);
+		if (!connection) {
+			ERROR("Failed to initialize connection");
+			goto end;
+		}
+	}
+
+	// Append, parse and initialize physical device
+	{
+		struct cfgx_section *device_section = cfg_append_physical_device_blobmsg(ctx, &device_blobmsg, tb[DEVICE], connection_id);
+		if (!device_section) {
+			ERROR("Failed to append physical device to context from blobmsg");
+			goto end;
+		}
+
+		device_section->id = cfg_format_number(device_id);
+		if (!device_section->id) {
+			ERROR("Failed to format number to string: Out of memory");
+			goto end;
+		}
+
+		device_cfg = cfg_read_physical_device(ctx, device_section);
+		if (!device_cfg) {
+			ERROR("Failed to parse physical device");
+			goto end;
+		}
+
+		device = cfg_get_physical_device(device_cfg);
+		if (!device) {
+			ERROR("Failed to initialize physical device");
+			goto end;
+		}
+		device->connection = connection;
+	}
+
+	result = device;
+end:
+	blob_buf_free(&connection_blobmsg);
+	blob_buf_free(&device_blobmsg);
+	cfg_free_physical_device_cfg(device_cfg);
+	cfg_free_connection_cfg(connection_cfg);
+	cfgx_context_free(ctx);
+	if (!result) {
+		cfg_free_physical_device(device);
+		cfg_free_connection(connection);
+	}
+	return result;
+}
+
+static struct blob_buf *cfg_append_blob_buf(struct blob_buf **list, size_t *len)
+{
+	struct blob_buf *larger_list = realloc(*list, (*len + 1) * sizeof(struct blob_buf));
+	if (!larger_list) {
+		return NULL;
+	}
+
+	*list = larger_list;
+
+	struct blob_buf *result = &larger_list[(*len)];
+	memset(result, 0, sizeof(struct blob_buf));
+	if (blob_buf_init(result, 0)) {
+		return NULL;
+	}
+
+	(*len)++;
+	return result;
+}
+
+service *cfg_get_cosem_group_blobmsg(struct blob_attr *msg, shared_memory_ctx *shared)
+{
+	enum {
+		OBJECTS,
+		DEVICES,
+		CONNECTIONS,
+	};
+
+	struct blobmsg_policy cosem_group_policy[] = {
+		[OBJECTS] = { .name = "objects", .type = BLOBMSG_TYPE_ARRAY },
+		[DEVICES] = { .name = "devices", .type = BLOBMSG_TYPE_ARRAY },
+		[CONNECTIONS] = { .name = "connections", .type = BLOBMSG_TYPE_ARRAY },
+	};
+
+	service *result = NULL;
+	service *s = NULL;
+	dlms_cfg *cfg = NULL;
+	cfgx_context_t *ctx = NULL;
+
+	struct blob_buf *blob_buff_list = NULL;
+	size_t blob_buff_list_len = 0;
+
+	int cosem_group_id = -1;
+
+	struct blob_attr *tb[ARRAY_SIZE(cosem_group_policy)] = { 0 };
+	if (blobmsg_parse(cosem_group_policy, ARRAY_SIZE(cosem_group_policy), tb, blob_data(msg), blob_len(msg))) {
+		ERROR("Failed to find required fields");
+		goto end;
+	}
+
+	ctx = cfgx_context_init_blobmsg();
+	if (!ctx) {
+		ERROR("Failed to create config context");
+		goto end;
+	}
+
+	struct blob_attr *pos = NULL;
+	int rem = 0;
+
+	// Append physical devices
+	blobmsg_for_each_attr(pos, tb[DEVICES], rem) {
+		struct blob_buf *device_buf = cfg_append_blob_buf(&blob_buff_list, &blob_buff_list_len);
+		if (!device_buf) {
+			ERROR("Failed to allocate a blob_buf: Out of memory");
+			goto end;
+		}
+
+		struct cfgx_section *device = cfg_append_physical_device_blobmsg(ctx, device_buf, pos, -1);
+		if (!device) {
+			ERROR("Failed to append physical device to context");
+			goto end;
+		}
+
+		device->id = cfgx_section_get_string(ctx, device, "id");
+		if (!device->id) {
+			ERROR("Failed to find option 'id' for physical device");
+			goto end;
+		}
+	}
+
+	// Append connections
+	blobmsg_for_each_attr(pos, tb[CONNECTIONS], rem) {
+		struct blob_buf *connection_buf = cfg_append_blob_buf(&blob_buff_list, &blob_buff_list_len);
+		if (!connection_buf) {
+			ERROR("Failed to allocate a blob_buf: Out of memory");
+			goto end;
+		}
+
+		struct cfgx_section *connection = cfg_append_connection_blobmsg(ctx, connection_buf, pos);
+		if (!connection) {
+			ERROR("Failed to append connection to context");
+			goto end;
+		}
+
+		connection->id = cfgx_section_get_string(ctx, connection, "id");
+		if (!connection->id) {
+			ERROR("Failed to find option 'id' for connection");
+			goto end;
+		}
+	}
+
+	// Append cosem group
+	cosem_group_id = cfg_pick_unique_config_id(ctx);
+	if (cosem_group_id == -1) {
+		ERROR("Failed to pick a unique id for cosem group");
+		goto end;
+	}
+
+	struct blob_buf *cosem_group_buf = cfg_append_blob_buf(&blob_buff_list, &blob_buff_list_len);
+	if (!cosem_group_buf) {
+		ERROR("Failed to allocate a blob_buf: Out of memory");
+		goto end;
+	}
+
+	struct cfgx_section *cosem_group = cfg_append_cosem_group_blobmsg(ctx, cosem_group_buf);
+	if (!cosem_group) {
+		ERROR("Failed to append cosem group to context");
+		goto end;
+	}
+
+	cosem_group->id = cfg_format_number(cosem_group_id);
+	if (!cosem_group->id) {
+		ERROR("Failed to allocate string: Out of memory");
+		goto end;
+	}
+
+	// Append cosem
+	blobmsg_for_each_attr(pos, tb[OBJECTS], rem) {
+		struct blob_buf *object_buf = cfg_append_blob_buf(&blob_buff_list, &blob_buff_list_len);
+		if (!object_buf) {
+			ERROR("Failed to allocate a blob_buf: Out of memory");
+			goto end;
+		}
+
+		struct cfgx_section *cosem_value = cfg_append_cosem_blobmsg(ctx, object_buf, pos, cosem_group_id);
+		if (!cosem_value) {
+			ERROR("Failed to append cosem to context");
+			goto end;
+		}
+
+		cosem_value->id = cfg_pick_unique_config_id_str(ctx);
+		if (!cosem_value->id) {
+			ERROR("Failed to pick a unique id for cosem");
+			goto end;
+		}
+	}
+
+	cfg = cfg_read_dlms_cfg(ctx);
+	if (!cfg) {
+		log(L_ERROR, "Failed to read configuration file");
+		goto end;
+	}
+
+	SEPARATOR;
+	log(L_INFO, "Configuration read successfully, transfering data to main struct");
+
+	s = cfg_read_service(cfg, shared);
+	if (!s) {
+		log(L_ERROR, "Failed to initiate main struct");
+		goto end;
+	}
+
+	log(L_INFO, "Data transfer to main struct is complete");
+	SEPARATOR;
+
+	result = s;
+end:
+	for (size_t i = 0; i < blob_buff_list_len; i++) {
+		blob_buf_free(&blob_buff_list[i]);
+	}
+	free(blob_buff_list);
+
+	cfg_free_dlms_cfg(cfg);
+	cfgx_context_free(ctx);
+	if (!result) {
+		cfg_free_service(s);
+	}
+	return result;
+}
