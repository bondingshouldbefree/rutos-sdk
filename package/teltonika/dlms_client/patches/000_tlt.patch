-    unsigned char type;
-    //Loop capture columns and get values.
-    for (pos = 0; pos != pg->captureObjects.size; ++pos)
-    {
-        if ((ret = arr_getByIndex(&pg->captureObjects, (uint16_t)pos, (void**)&it)) != 0)
-        {
-            break;
