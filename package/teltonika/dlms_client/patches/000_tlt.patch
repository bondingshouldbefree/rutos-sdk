+void utl_append_to_str(char **destination, const char *source)
+{
+	if (!source) {
+		log(L_ERROR, "Source is NULL");
+		return;
+	}
+
+	if (!(*destination)) {
+		*destination = strdup(source);
+		_check_alloc(*destination);
+		return;
+	}
+
+	size_t source_len = strlen(source);
+	size_t sum_len = strlen(*destination) + source_len + 1;
+
+	*destination = realloc(*destination, sum_len);
+	_check_alloc(*destination);
+
+	// It is safe to call `strncat` because the size of `*destination` string is increase be large enough
+	// for appending `source`
+	strncat(*destination, source, source_len); // nosemgrep
+}
