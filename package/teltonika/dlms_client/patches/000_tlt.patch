-#endif //DLMS_IGNORE_ASSOCIATION_LOGICAL_NAME
-        }
-    }
-#ifndef DLMS_IGNORE_MALLOC
-    vec_clear(&arr);
-#endif //DLMS_IGNORE_MALLOC
-    return ret;
-}
