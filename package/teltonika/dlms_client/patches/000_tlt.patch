-		                 / (2 * baudrate));
-		hri_sercomi2cm_write_BAUD_BAUD_bf(hw, tmp);
-	} else if (i2c_dev->service.mode == I2C_HIGHSPEED_MODE) {
-		tmp = (clkrate - 2 * baudrate) / (2 * baudrate);
-		hri_sercomi2cm_write_BAUD_HSBAUD_bf(hw, tmp);
-	} else {
-		/* error baudrate */
-		return ERR_INVALID_ARG;
-	}
-
-	return ERR_NONE;
-}
