-#endif
-    fclose(f);
-#endif //defined(_WIN32) || defined(_WIN64) || defined(__linux__)
-
-    while ((opt = getopt(argc, argv, "t:p:")) != -1)
-    {
-        switch (opt)
-        {
-        case 't':
-            //Trace.
-            if (strcmp("Error", optarg) == 0)
