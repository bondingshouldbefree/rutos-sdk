-#elif CONF_CPU_FREQUENCY < 10000
-#define CPU_FREQ_POWER 4
-#elif CONF_CPU_FREQUENCY < 100000
-#define CPU_FREQ_POWER 5
-#elif CONF_CPU_FREQUENCY < 1000000
