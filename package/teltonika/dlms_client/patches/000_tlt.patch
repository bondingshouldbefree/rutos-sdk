-	                                ? 3                                                                                                                                                                                                                                                                                                                                                            \
-	                                : ((u) & (1ul << 27))                                                                                                                                                                                                                                                                                                                                          \
-	                                      ? 4                                                                                                                                                                                                                                                                                                                                                      \
