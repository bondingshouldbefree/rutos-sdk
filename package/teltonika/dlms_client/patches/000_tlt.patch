-    message tmp;
-    gxByteBuffer bb;
-    bb_clear(reply);
-    if (type == DLMS_DATA_REQUEST_TYPES_NONE)
-    {
-        return DLMS_ERROR_CODE_INVALID_PARAMETER;
-    }
-#ifndef DLMS_IGNORE_HDLC
-    // Get next frame.
-    if ((type & DLMS_DATA_REQUEST_TYPES_FRAME) != 0)
