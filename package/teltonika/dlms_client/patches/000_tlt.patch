- *  \return Error or baudrate value.
- *  \retval >0 Baudrate value.
- *  \retval ERR_INVALID_ARG Calculation fail.
- */
-int32_t _spi_calc_baud_val(struct spi_dev *dev, const uint32_t clk, const uint32_t baud);
