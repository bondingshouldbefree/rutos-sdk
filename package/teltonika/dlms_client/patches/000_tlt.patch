-unsigned char hlp_getValue(char c)
-{
-    unsigned char value;
-    if (c > '9')
-    {
-        if (c > 'Z')
-        {
-            value = (c - 'a' + 10);
-        }
-        else
-        {
-            value = (c - 'A' + 10);
-        }
-    }
-    else
-    {
-        value = (c - '0');
-    }
-    return value;
