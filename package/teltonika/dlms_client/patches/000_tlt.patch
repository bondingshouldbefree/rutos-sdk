-                    else if (p->data != NULL)
-                    {
-                        ret = bb_set2(reply, p->data, p->data->position, len);
-                    }
-#endif //DLMS_IGNORE_MALLOC
-                }
-            }
-        }
-        // Add data that fits to one block.
-        if (ret == 0 && len == 0)
-        {
-            // Add status if reply.
-            if (p->status != 0xFF)
-            {
-                if (p->status != 0
-                    && (p->command == DLMS_COMMAND_GET_RESPONSE))
-                {
-                    ret = bb_setUInt8(h, 1);
-                }
-                ret = bb_setUInt8(h, p->status);
