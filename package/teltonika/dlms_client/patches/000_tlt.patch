-        bb_setUInt32(data, settings->base.windowSizeTX);
-
-        bb_setUInt8(data, HDLC_INFO_WINDOW_SIZE_RX);
-        bb_setUInt8(data, 4);
-        bb_setUInt32(data, settings->base.windowSizeRX);
