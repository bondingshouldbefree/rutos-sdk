+static char *attr_scripts_to_string(gxArray *scripts)
+{
+	char *result = NULL;
+	gxByteBuffer bb = { 0 };
+	BYTE_BUFFER_INIT(&bb);
+
+	bb_addString(&bb, "[");
+	for (size_t pos = 0; pos != scripts->size; ++pos) {
+		if (pos != 0) {
+			bb_addString(&bb, ", ");
+		}
+
+		gxScript *s = NULL;
+		if (arr_getByIndex(scripts, pos, (void **)&s)) {
+			goto end;
+		}
+
+		bb_addIntAsString(&bb, s->id);
+		// bb_addString(&ba, "\n");
+
+		for (size_t pos2 = 0; pos2 != s->actions.size; ++pos2) {
+			gxScriptAction *sa = NULL;
+			if (arr_getByIndex(&s->actions, pos2, (void **)&sa)) {
+				goto end;
+			}
+			if (pos2 != 0) {
+				bb_addString(&bb, ", ");
+			}
+			bb_addIntAsString(&bb, sa->type);
+			bb_addString(&bb, " ");
+
+			if (sa->target == NULL) {
+				bb_addIntAsString(&bb, 0);
+				bb_addString(&bb, " ");
+				hlp_appendLogicalName(&bb, EMPTY_LN);
+			} else {
+				bb_addIntAsString(&bb, sa->target->objectType);
+				bb_addString(&bb, " ");
+				hlp_appendLogicalName(&bb, sa->target->logicalName);
+			}
+
+			bb_addString(&bb, " ");
+			bb_addIntAsString(&bb, sa->index);
+			bb_addString(&bb, " ");
+
+			if (var_toString(&sa->parameter, &bb)) {
+				goto end;
+			}
+		}
+	}
+	bb_addString(&bb, "]");
+
+	result = bb_toString(&bb);
+end:
+	bb_clear(&bb);
+	return result;
+}
