+// https://www.gurux.fi/Gurux.DLMS.Objects.GXDLMSAssociationLogicalName
+static char *attr_gx_association_logical_name_to_string(attr_ctx *ctx, int attribute)
+{
+	gxAssociationLogicalName *object = (gxAssociationLogicalName*)ctx->object;
+
+	if (attribute == 1) {
+		return attr_obis_to_string(&object->base, ctx->use_ln_ref);
+	} else if (attribute == 2) {
+		return attr_object_list_to_string(&object->objectList);
+	} else if (attribute == 3) {
+		gxByteBuffer bb = { 0 };
+		BYTE_BUFFER_INIT(&bb);
+
+		bb_addIntAsString(&bb, object->clientSAP);
+		bb_addString(&bb, "/");
+		bb_addIntAsString(&bb, object->serverSAP);
+
+		char *result = bb_toString(&bb);
+		bb_clear(&bb);
+		return result;
+	} else if (attribute == 4) {
+		return attr_application_context_name_to_string(&object->applicationContextName);
+	} else if (attribute == 5) {
+		return attr_xdlms_context_type_to_string(&object->xDLMSContextInfo);
+	} else if (attribute == 6) {
+		return attr_authentication_mechanism_name_to_string(&object->authenticationMechanismName);
+	} else if (attribute == 7) {
+		gxByteBuffer bb = { 0 };
+		BYTE_BUFFER_INIT(&bb);
+
+		if (object->secret.data) {
+			bb_attachString(&bb, bb_toString(&object->secret));
+		} else {
+			char *buff = strdup("Access error");
+			_check_alloc(buff);
+			bb_attachString(&bb, buff);
+		}
+
+		char *result = bb_toString(&bb);
+		bb_clear(&bb);
+		return result;
+	} else if (attribute == 8) {
+		return attr_int_to_string(object->associationStatus);
+	} else if (attribute == 9) {
+		//Security Setup Reference is from version 1.
+		if (object->base.version <= 0) {
+			return NULL;
+		}
+
+		gxByteBuffer bb = { 0 };
+		BYTE_BUFFER_INIT(&bb);
+
+		bb_addLogicalName(&bb, obj_getLogicalName((gxObject *)object->securitySetup));
+
+		char *result = bb_toString(&bb);
+		bb_clear(&bb);
+		return result;
+	} else if (attribute == 10) {
+		if (object->base.version <= 1) {
+			return NULL;
+		}
+
+		return attr_user_list_to_string(&object->userList);
+	} else if (attribute == 11) {
+		// Current user isn't reported
+		return NULL;
+	} else {
+		return NULL;
+	}
+}
