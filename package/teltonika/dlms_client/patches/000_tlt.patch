-    if (readObjects != NULL)
-    {
-        if ((ret = com_updateInvocationCounter(connection, invocationCounter)) == 0 &&
-            (ret = com_initializeConnection(connection)) == 0 &&
-            (ret = com_getAssociationView(connection, outputFile)) == 0)
