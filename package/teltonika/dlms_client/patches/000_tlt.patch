-	hri_rtcmode0_write_COUNT_reg(dev->hw, 0);
-	hri_rtcmode0_wait_for_sync(dev->hw, RTC_MODE0_SYNCBUSY_COUNT);
-	hri_rtcmode0_set_CTRLA_ENABLE_bit(dev->hw);
-}
