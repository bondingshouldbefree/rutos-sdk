-        case 8:
-            //Import or export certificate.
-            ret = GET_ATTRIBUTE(6);
-            break;
-        default:
-            break;
-        }
-        break;
-        //SAP assignment is added or removed.
-    case DLMS_OBJECT_TYPE_SAP_ASSIGNMENT:
-        ret = GET_ATTRIBUTE(2);
-        break;
-        //Connection state is changed.
-    case DLMS_OBJECT_TYPE_DISCONNECT_CONTROL:
