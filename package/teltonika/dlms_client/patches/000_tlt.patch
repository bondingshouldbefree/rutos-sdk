-#ifndef DLMS_IGNORE_WRAPPER
-int dlms_getTcpData(
-    dlmsSettings* settings,
-    gxByteBuffer* buff,
-    gxReplyData* data,
-    gxReplyData* notify,
-    unsigned char* isNotify)
-{
-    int ret, pos;
-    uint16_t value;
-    *isNotify = 0;
-    // If whole frame is not received yet.
-    if (buff->size - buff->position < 8)
-    {
-        data->complete = 0;
