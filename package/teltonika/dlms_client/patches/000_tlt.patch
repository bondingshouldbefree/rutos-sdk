-  mes_init(&msg);
-  if ((ret = cl_releaseRequest2(&settings, &msg, 1)) != 0 ||
-      (ret = com_readDataBlock(&msg, &reply)) != 0)
-  {
-    //Show error but continue close.
-  }
-  reply_clear(&reply);
-  mes_clear(&msg);
-
-  if ((ret = cl_disconnectRequest(&settings, &msg)) != 0 ||
-      (ret = com_readDataBlock(&msg, &reply)) != 0)
-  {
-    //Show error but continue close.
-  }
-  reply_clear(&reply);
-  mes_clear(&msg);
-  return ret;
