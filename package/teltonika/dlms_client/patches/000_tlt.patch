-	tmp &= ~TRNG_CTRLA_ENABLE;
-	tmp |= value << TRNG_CTRLA_ENABLE_Pos;
-	((Trng *)hw)->CTRLA.reg = tmp;
-	TRNG_CRITICAL_SECTION_LEAVE();
