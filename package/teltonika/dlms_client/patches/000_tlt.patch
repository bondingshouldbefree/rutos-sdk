-  switch (hdlc.communicationSpeed)
-  {
-    case DLMS_BAUD_RATE_300:
-      ret = 300;
-      break;
-    case DLMS_BAUD_RATE_600:
-      ret = 600;
-      break;
-    case DLMS_BAUD_RATE_1200:
