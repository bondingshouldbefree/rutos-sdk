-                    ret = bb_move(e->value.byteArr, newDataSize, 0, e->value.byteArr->size - newDataSize);
-                    e->value.byteArr->position = 0;
-#ifdef DLMS_IGNORE_MALLOC
-                    ret = cosem_setValue(&settings->base, e);
-                    bb_clear(e->value.byteArr);
