-        unsigned char pduBuff[2];
-        gxByteBuffer pdu;
-        bb_attach(&pdu, pduBuff, 0, sizeof(pduBuff));
-        if (fread(pdu.data, 1, 2, f) == 2)
-        {
-            pdu.size = 2;
-            bb_getUInt16(&pdu, &index);
-            fseek(f, 0, SEEK_SET);
-            bb_empty(&pdu);
-        }
-        fclose(f);
