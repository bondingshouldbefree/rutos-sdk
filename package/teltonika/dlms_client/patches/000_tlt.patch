-                data = notify;
-            }
-            // Get length.
-            if ((ret = bb_getUInt16(buff, &value)) != 0)
-            {
-                return ret;
-            }
-            data->complete = !((buff->size - buff->position) < value);
-            if (!data->complete)
-            {
-                buff->position = pos;
-            }
-            else
-            {
-                data->packetLength = buff->position + value;
-            }
-            break;
-        }
-        else
-        {
-            --buff->position;
-        }
-    }
-    return DLMS_ERROR_CODE_OK;
-}
