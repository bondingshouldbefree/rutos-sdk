+static bool cfg_blobmsg_has_field(struct blob_attr *msg, const char *name)
+{
+	size_t namelen = strlen(name);
+
+	struct blob_attr *attr = NULL;
+	int rem = 0;
+	blobmsg_for_each_attr(attr, msg, rem) {
+		struct blobmsg_hdr *hdr = blob_data(attr);
+		if (blobmsg_namelen(hdr) == namelen && !strcmp(name, (char*)hdr->name)) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static int cfg_copy_blobmsg_fields(struct blob_buf *buf, struct blob_attr *src)
+{
+	if (!src) {
+		return 0;
+	}
+
+	bool is_table = blobmsg_type(src) == BLOBMSG_TYPE_TABLE;
+
+	struct blob_attr *pos = NULL;
+	int rem = 0;
+	blobmsg_for_each_attr(pos, src, rem) {
+		if (is_table && cfg_blobmsg_has_field(buf->head, blobmsg_name(pos))) {
+			continue;
+		}
+
+		int attr_type = blobmsg_type(pos);
+
+		if (attr_type == BLOBMSG_TYPE_TABLE || attr_type == BLOBMSG_TYPE_ARRAY) {
+			void *cookie = blobmsg_open_nested(buf, blobmsg_name(pos), attr_type == BLOBMSG_TYPE_ARRAY);
+			int rc = cfg_copy_blobmsg_fields(buf, pos);
+			blob_nest_end(buf, cookie);
+
+			if (rc) {
+				goto err;
+			}
+		} else {
+			if (blobmsg_add_blob(buf, pos)) {
+				goto err;
+			}
+		}
+	}
+
+	return 0;
+err:
+	return -1;
+}
