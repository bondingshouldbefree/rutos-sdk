+void utl_parse_attributes(char *attributes, cosem_object *co)
+{
+	int max_attribute_index = utl_attribute_count_by_type(co->type);
+	if (max_attribute_index < 0) {
+		log(L_ERROR, "Failed to determine attribute count for data type %d", co->type);
+		return;
+	}
+
+	// By default all attributes are selected
+	if (!attributes) {
+		ASSERT((unsigned int)max_attribute_index <= ARRAY_SIZE(co->attributes.items));
+		for (size_t i = 0; i < (size_t)max_attribute_index; i++) {
+			co->attributes.items[i] = i + 1;
+		}
+		co->attributes.count = max_attribute_index;
+
+		return;
+	}
+
+	char *tok_save = NULL;
+	for (
+		char *tok = strtok_r(attributes, " ", &tok_save);
+		tok && co->attributes.count < (size_t)max_attribute_index;
+		tok = strtok_r(NULL, " ", &tok_save)
+	) {
+		errno = 0;
+		int a = strtol(tok, NULL, 10);
+		if (errno != 0) {
+			log(L_ERROR, "Failed to parse attribute index: '%s'", tok);
+			continue;
+		}
+
+		if (a > max_attribute_index) {
+			log(L_ERROR, "attribute with index %d does not exist", a);
+			continue;
+		}
+
+		co->attributes.items[co->attributes.count++] = a;
+	}
+
+	utl_sort_array(co->attributes.items, co->attributes.count);
+}
+
+void utl_attributes_append(attribute_index_list *list, int attribute)
+{
+	if (utl_attributes_contain(list, attribute)) {
+		return;
+	}
+
+	ASSERT(list->count < ARRAY_SIZE(list->items));
+	list->items[list->count++] = attribute;
+}
+
+void utl_attributes_append_many(attribute_index_list *list, attribute_index_list *appended_list)
+{
+	for (size_t i = 0; i < appended_list->count; i++) {
+		utl_attributes_append(list, appended_list->items[i]);
+	}
+}
+
+int utl_attributes_index_of(attribute_index_list *list, int attribute)
+{
+	for (size_t i = 0; i < list->count; i++) {
+		if (list->items[i] == attribute) {
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+bool utl_attributes_contain(attribute_index_list *list, int attribute)
+{
+	return utl_attributes_index_of(list, attribute) != -1;
+}
+
+void utl_sort_array(int *array, int count)
+{
+	qsort(array, count, sizeof(*array), compare_cb);
+}
+
+static int compare_cb(const void *a, const void *b)
+{
+    return (*(int *)a - *(int *)b);
+}
