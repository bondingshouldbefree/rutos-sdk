-            if ((ret = arr_getByIndex(list, pos, (void**)&it)) != 0)
-            {
-                return ret;
-            }
-#endif //DLMS_IGNORE_MALLOC
-
-            // Add variable type.
-            bb_setUInt8(&bb, 2);
-            sn = ((gxObject*)it->key)->shortName;
-            sn += ((uint16_t)it->value - 1) * 8;
-            bb_setUInt16(&bb, sn);
