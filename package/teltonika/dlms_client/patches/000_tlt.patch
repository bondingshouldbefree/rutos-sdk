-    if (svr_getAttributeAccess(&settings->base, info.item, info.index) == DLMS_ACCESS_MODE_NONE)
-    {
-        e->error = DLMS_ERROR_CODE_READ_WRITE_DENIED;
-        e->handled = 1;
-    }
