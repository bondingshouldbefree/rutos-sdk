+// ------------------------------- Connection opening/closing ------------------------------- //
+
+int com_open_connection(physical_device *dev)
+{
+	int err = DLMS_ERROR_CODE_UNKNOWN;
+	if (ticket_mutex_lock(&dev->connection->lock->mutex)) {
+		log(L_ERROR, "Failed to lock ticket mutex");
+		goto err;
+	}
+	dev->connection->locked = true;
+	tls_connection_mutex_locked = true;
+
+	err = com_open_socket(dev->connection);
+	if (err != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to open connection ('%d', '%s')", dev->connection->id, dev->connection->name);
+		goto err;
+	}
+
+	if (dev->connection->type == SERIAL) {
+		struct libtlt_termios_settings *s = &dev->connection->parameters.serial;
+		if (flock(dev->connection->socket, LOCK_EX)) {
+			log(L_ERROR, "Failed to lock %s file! Reason: %s", s->device, strerror(errno));
+			goto err;
+		}
+		dev->connection->flock = true;
+
+		if (dev->settings.interfaceType == DLMS_INTERFACE_TYPE_HDLC_WITH_MODE_E) {
+			err = com_initialize_mode_e(dev->connection);
+			if (err != DLMS_ERROR_CODE_OK) {
+				log(L_ERROR, "Failed to initialize serial connection '%d' with mode e", dev->connection->id);
+				goto err;
+			}
+		} else {
+			err = com_initialize_serial_settings(dev->connection);
+			if (err != DLMS_ERROR_CODE_OK) {
+				log(L_ERROR, "Failed to initialize serial connection '%d'", dev->connection->id);
+				goto err;
+			}
+		}
+	}
+
+	err = com_update_invocation_counter(dev);
+	if (err != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to update invocation counter");
+		goto err;
+	}
+
+	err = com_initialize_connection(dev);
+	if (err != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to initialize connection");
+		goto err;
+	}
+
+	return 0;
+err:
+	com_close_connection(dev, false);
+	return err;
+}
+
+void com_close_connection(physical_device *dev, bool keep_socket_open)
+{
+	if (!dev) {
+		return;
+	}
+	if (!dev->connection) {
+		return;
+	}
+
+	// Ignore error
+	com_send_release_connection(dev);
+
+	// Ignore error
+	com_send_disconnect_connection(dev);
+
+	if (dev->connection->flock) {
+		struct libtlt_termios_settings *s = &dev->connection->parameters.serial;
+		if (flock(dev->connection->socket, LOCK_UN)) {
+			log(L_ERROR, "Failed to lock %s file! Reason: %s", s->device, strerror(errno));
+		}
+		dev->connection->flock = false;
+	}
+
+	if (!keep_socket_open) {
+		com_close_socket(dev->connection);
+	}
+
+	if (dev->connection->locked && tls_connection_mutex_locked) {
+		dev->connection->locked	    = false;
+		tls_connection_mutex_locked = false;
+		if (ticket_mutex_unlock(&dev->connection->lock->mutex)) {
+			ERROR("Failed to unlock connection mutex");
+		}
+	} else if (dev->connection->locked && !tls_connection_mutex_locked) {
+		log(L_WARNING, "Connection marked as locked but this thread doesn't hold the mutex");
+		dev->connection->locked = false;
+	}
+}
+
+static int com_check_if_connected_to_server(int fd)
+{
+	struct pollfd fds[1] = { [0] = { .fd = fd, .events = POLLOUT } };
+	int tries	     = 0;
+	while (tries < 10) {
+		int rc = poll(fds, 1, 100);
+
+		if (rc < 0) {
+			log(L_ERROR, "Poll error while trying to connect: %s", strerror(errno));
+			break;
+		}
+
+		if ((fds[0].revents & POLLERR) || !fds[0].revents) {
+			usleep(10000);
+			tries++;
+			continue;
+		}
+
+		if (fds[0].revents & POLLOUT) {
+			int err = -1;
+			socklen_t err_size = sizeof(int);
+			getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &err_size);
+			return err;
+		}
+	}
+
+	return 1;
+}
+
+static int com_initialize_serial_settings(connection *c)
+{
+	struct libtlt_termios_settings *s = &c->parameters.serial;
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+
+	if (ltermios_set_settings(s)) {
+		log(L_ERROR, "ltermios_set_settings error: %s", s->error);
+		goto err;
+	}
+
+	tcgetattr(s->fd, &s->termios);
+
+	s->termios.c_cc[VTIME] = 5;
+
+	if (tcsetattr(s->fd, TCSANOW, &s->termios) != 0) {
+		log(L_ERROR, "Failed to set STTY settings");
+		goto err;
+	}
+
+	ret = 0;
+err:
+	return ret;
+}
+
+static int com_initialize_mode_e(connection *c)
+{
+	struct termios options = { 0 };
+	int baudrate = B9600;
+
+	bb_clear(&c->data);
+	bb_init(&c->data);
+	bb_capacity(&c->data, 500);
+
+	options.c_cflag |= PARENB;
+	options.c_cflag &= ~PARODD;
+	options.c_cflag &= ~CSTOPB;
+	options.c_cflag &= ~CSIZE;
+	options.c_cflag |= CS7;
+
+	cfsetospeed(&options, B300);
+	cfsetispeed(&options, B300);
+
+	options.c_lflag = 0;
+	options.c_cc[VMIN] = 1;
+	options.c_cc[VTIME] = 5;
+
+	if (tcsetattr(c->socket, TCSAFLUSH, &options) != 0) {
+		log(L_ERROR, "Failed to set termios settings");
+		return DLMS_ERROR_CODE_INVALID_PARAMETER;
+	}
+
+	int len = strlen(MODE_E_INIT_MESSAGE);
+	if (write(c->socket, MODE_E_INIT_MESSAGE, len) != len) {
+		log(L_ERROR, "Failed to write initialisation message");
+		return DLMS_ERROR_CODE_SEND_FAILED;
+	}
+
+	if (read_data_until(c, '\n') != 0) {
+		// this might fail if device was already initiated with /?!\r\n.
+		log(L_ERROR, "Failed to read from serial port");
+		goto err;
+	}
+
+	unsigned char ch = 0;
+	if (bb_getUInt8(&c->data, &ch) != 0 || ch != '/') {
+		return DLMS_ERROR_CODE_SEND_FAILED;
+	}
+
+	//Get used baud rate.
+	if (bb_getUInt8ByIndex(&c->data, 4, &ch) != 0) {
+		return DLMS_ERROR_CODE_SEND_FAILED;
+	}
+
+	switch (ch) {
+	case '0':
+		baudrate = B300;
+		break;
+	case '1':
+		baudrate = B600;
+		break;
+	case '2':
+		baudrate = B1200;
+		break;
+	case '3':
+		baudrate = B2400;
+		break;
+	case '4':
+		baudrate = B4800;
+		break;
+	case '5':
+		baudrate = B9600;
+		break;
+	case '6':
+		baudrate = B19200;
+		break;
+	default:
+		log(L_ERROR, "Could not parse baudrate");
+		return DLMS_ERROR_CODE_INVALID_PARAMETER;
+	}
+
+err:
+	len = 6;
+	char buff[16] = { 0x06, '2', (char)ch, '2', 0x0D, 0x0A };
+
+	if (write(c->socket, buff, 6) != len) {
+		log(L_ERROR, "Failed to write acknowledgment message");
+		return DLMS_ERROR_CODE_SEND_FAILED;
+	}
+
+	usleep(1000000); // This sleep is in standard. Do not remove.
+	options.c_cflag = CS8 | CREAD | CLOCAL;
+	cfsetospeed(&options, baudrate);
+	cfsetispeed(&options, baudrate);
+
+	if (tcsetattr(c->socket, TCSAFLUSH, &options) != 0) {
+		log(L_ERROR, "Failed to set termios settings");
+		return DLMS_ERROR_CODE_INVALID_PARAMETER;
+	}
+
+	return 0;
+}
+
+static int com_update_invocation_counter(physical_device *dev)
+{
+	int ret = DLMS_ERROR_CODE_OK;
+
+	char *invocationCounter = dev->invocation_counter;
+	dlmsSettings *s = &dev->settings;
+
+	if (invocationCounter == NULL || s->cipher.security == DLMS_SECURITY_NONE) {
+		return ret;
+	}
+
+	gxByteBuffer challenge	 = { 0 };
+	message messages	 = { 0 };
+	gxReplyData reply	 = { 0 };
+	uint16_t addr = s->clientAddress;
+	DLMS_AUTHENTICATION auth = s->authentication;
+	DLMS_SECURITY security	 = s->cipher.security;
+
+	bb_init(&challenge);
+	bb_set(&challenge, s->ctoSChallenge.data, s->ctoSChallenge.size);
+	s->clientAddress   = 16;
+	s->authentication  = DLMS_AUTHENTICATION_NONE;
+	s->cipher.security = DLMS_SECURITY_NONE;
+
+	log(L_DEBUG, "Updating invocation counter");
+
+	ret = com_send_snrm_request(dev, &messages, &reply, &challenge);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "handle_snrm_request failed: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_send_aarq_request(dev, &messages, &reply, &challenge);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "handle_aarq_request failed: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	gxData d = { 0 };
+	cosem_init(BASE(d), DLMS_OBJECT_TYPE_DATA, invocationCounter);
+	if ((ret = com_read(dev, BASE(d), 2)) == 0) {
+		s->cipher.invocationCounter = 1 + var_toInteger(&d.value);
+
+		log(L_DEBUG, "Invocation counter: %u (0x%X)", s->cipher.invocationCounter,
+		    s->cipher.invocationCounter);
+
+		com_send_disconnect_connection(dev);
+		bb_clear(&s->ctoSChallenge);
+		bb_set(&s->ctoSChallenge, challenge.data, challenge.size);
+	}
+
+err:
+	s->clientAddress   = addr;
+	s->authentication  = auth;
+	s->cipher.security = security;
+
+	bb_clear(&challenge);
+	return ret;
+}
+
+static int com_initialize_connection(physical_device *dev)
+{
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+
+	dlmsSettings *s = &dev->settings;
+	connection *c = dev->connection;
+
+	message messages = { 0 };
+	mes_init(&messages);
+
+	gxReplyData reply = { 0 };
+	reply_init(&reply);
+
+	log(L_INFO, "Initializing connection ('%d') ('%s')", c->id, UTL_SAFE_STR(c->name));
+
+	//Get meter's send and receive buffers size.
+	ret = com_send_snrm_request(dev, &messages, &reply, NULL);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to handle SNRM request: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_send_aarq_request(dev, &messages, &reply, NULL);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to handle AARQ request: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	if (s->authentication <= DLMS_AUTHENTICATION_LOW) {
+		goto err;
+	}
+
+	// Get challenge Is HLS authentication is used.
+	ret = cl_getApplicationAssociationRequest(s, &messages);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to get AA request: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_read_data_block(dev, &messages, &reply);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to read data block: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = cl_parseApplicationAssociationResponse(s, &reply.data);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		log(L_ERROR, "Failed to parse AA response: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = DLMS_ERROR_CODE_OK;
+err:
+	log(L_INFO, "Initialization completed");
+	mes_clear(&messages);
+	reply_clear(&reply);
+	return ret;
+}
+
+static int com_send_release_connection(physical_device *dev)
+{
+	dlmsSettings *s = &dev->settings;
+	connection *c = dev->connection;
+
+	if ((s->connected & DLMS_CONNECTION_STATE_DLMS) == 0) {
+		return DLMS_ERROR_CODE_OK;
+	}
+
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+
+	log(L_INFO, "Releasing connection ('%d') ('%s')", c->id, UTL_SAFE_STR(c->name));
+
+	gxReplyData reply = { 0 };
+	reply_init(&reply);
+
+	message msg = { 0 };
+	mes_init(&msg);
+
+	ret = cl_releaseRequest(s, &msg);
+	if (ret != DLMS_ERROR_CODE_OK) {
+		//Show error but continue close.
+		log(L_DEBUG, "Release failed: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = com_read_data_block(dev, &msg, &reply);
+
+	// Ignore "Confimed Service Error", because it just means that the device does not support releasing
+	// connections
+	bool is_confimed_service_error = (ret & DLMS_ERROR_TYPE_CONFIRMED_SERVICE_ERROR) != 0;
+	if (ret != DLMS_ERROR_CODE_OK && !is_confimed_service_error) {
+		log(L_ERROR, "Failed to read data block: %s", hlp_getErrorMessage(ret));
+		goto err;
+	}
+
+	ret = DLMS_ERROR_CODE_OK;
+err:
+	reply_clear(&reply);
+	mes_clear(&msg);
+	return ret;
+}
+
+static int com_send_disconnect_connection(physical_device *dev)
+{
+	dlmsSettings *s = &dev->settings;
+
+	if ((s->connected & DLMS_CONNECTION_STATE_HDLC) == 0) {
+		return DLMS_ERROR_CODE_OK;
+	}
+
+	int ret = DLMS_ERROR_CODE_UNKNOWN;
+
+	log(L_INFO, "Disconnecting");
+
+	gxReplyData reply = { 0 };
+	reply_init(&reply);
+
+	message msg = { 0 };
+	mes_init(&msg);
+
+	// TODO: The function `com_read_data_block` should not be called. In the spec a response for this
+	// request isn't specified. It is expected that the server would just close the connection without
+	// a response. This needs more research.
+	// Check "Table 5 - Control field bit assignments of command and response frames" in green book excerpt 
+	if ((ret = cl_disconnectRequest(s, &msg)) != 0 ||
+	    (ret = com_read_data_block(dev, &msg, &reply)) != 0) {
+		log(L_DEBUG, "Disconnect failed");
+		goto err;
+	}
+
+	if (dev->connection->disconnect_delay_ms > 0) {
+		log(L_DEBUG, "sleeping for %d ms (disconnect delay)", dev->connection->disconnect_delay_ms);
+		usleep(dev->connection->disconnect_delay_ms * 1000);
+	}
+
+	ret = DLMS_ERROR_CODE_OK;
+err:
+	reply_clear(&reply);
+	mes_clear(&msg);
+	return ret;
+}
+
+static int com_open_socket_tcp(connection *c)
+{
+	int flags = 0;
+
+	c->socket = socket(c->tcp_address.sin6_family, SOCK_STREAM, IPPROTO_IP);
+	if (c->socket == -1) {
+		log(L_ERROR, "Socket creation failed: %s", strerror(errno));
+		goto err;
+	}
+
+	struct timeval tv = { IO_TIMEOUT, 0 };
+	setsockopt(c->socket, SOL_SOCKET, SO_RCVTIMEO, (const char *)&tv, sizeof(tv));
+	setsockopt(c->socket, SOL_SOCKET, SO_SNDTIMEO, (const char *)&tv, sizeof(tv));
+
+	flags = fcntl(c->socket, F_GETFL, 0);
+	fcntl(c->socket, F_SETFL, O_NONBLOCK);
+
+	//Connect to the meter.
+	struct sockaddr *addr = (struct sockaddr *)&c->tcp_address;
+	if (connect(c->socket, addr, utl_sockaddr_size(addr)) == -1) {
+		if (errno == EINPROGRESS && com_check_if_connected_to_server(c->socket)) {
+			log(L_ERROR, "Failed to connect to server: %s", strerror(errno));
+			goto err;
+		}
+	}
+
+	fcntl(c->socket, F_SETFL, flags);
+	return DLMS_ERROR_CODE_OK;
+err:
+	com_close_socket(c);
+	return DLMS_ERROR_TYPE_COMMUNICATION_ERROR;
+}
+
+static int com_open_socket_serial(connection *c)
+{
+	struct libtlt_termios_settings *s = &c->parameters.serial;
+
+	// Opening file "should" be safe, because WebUI only allows using correct serial device. And not any path
+	s->fd = open(s->device, O_RDWR | O_NOCTTY | O_NONBLOCK); // nosemgrep
+	if (s->fd == -1) {
+		log(L_DEBUG, "Failed to open serial port: %s", s->device);
+		goto err;
+	}
+
+	c->socket = s->fd;
+
+	return 0;
+err:
+	com_close_socket(c);
+	return DLMS_ERROR_TYPE_COMMUNICATION_ERROR;
+}
+
+static int com_open_socket(connection *c)
+{
+	if (c->socket != -1) {
+		return 0;
+	}
+
+	if (c->type == TCP) {
+		return com_open_socket_tcp(c);
+	} else if (c->type == SERIAL) {
+		return com_open_socket_serial(c);
+	} else {
+		return -1;
+	}
+}
+
+static void com_close_socket(connection *c)
+{
+	if (c->socket == -1) {
+		return;
+	}
+
+	if (c->type == SERIAL) {
+		c->parameters.serial.fd = -1;
+	}
+
+	close(c->socket);
+	c->socket = -1;
+}
+
+// ------------------------------- Connection init/deinit ------------------------------- //
+
+int com_init(connection *conn, shared_memory_ctx *shared)
+{
+	bb_init(&conn->data);
+	conn->shared = shared;
+
+	if (bb_capacity(&conn->data, 500)) {
+		ERROR("Failed to allocate byte buffer for connection");
+		goto err;
+	}
+
+	if (conn->type == TCP) {
+		return com_init_tcp(conn);
+	} else if (conn->type == SERIAL) {
+		return com_init_serial(conn);
+	} else {
+		return -1;
+	}
+
+	return 0;
+err:
+	com_deinit(conn);
+	return -1;
+}
+
+void com_deinit(connection *conn)
+{
+	if (!conn) {
+		return;
+	}
+
+	com_close_socket(conn);
+	bb_clear(&conn->data);
+
+	if (conn->shared != NULL) {
+		shared_connection_lock_release(conn->shared, conn->lock);
+	}
+	conn->lock = NULL;
+	conn->shared = NULL;
+}
+
+static uint8_t com_is_IPv6_address(const char *host)
+{
+	return (strstr(host, ":") != NULL);
+}
+
+static int com_init_tcp(connection *conn)
+{
+	char *address = conn->parameters.tcp.host;
+	int port = conn->parameters.tcp.port;
+
+	if (com_is_IPv6_address(address)) {
+		struct sockaddr_in6 *addr_ipv6 = &conn->tcp_address;
+		memset(addr_ipv6, 0, sizeof(*addr_ipv6));
+
+		addr_ipv6->sin6_family = AF_INET6;
+		addr_ipv6->sin6_port   = htons(port);
+		if (inet_pton(AF_INET6, address, &addr_ipv6->sin6_addr) == -1) {
+			log(L_ERROR, "Failed to get host by name: %s", strerror(errno));
+			goto err;
+		}
+
+	} else {
+		struct sockaddr_in *addr_ipv4 = (struct sockaddr_in *)&conn->tcp_address;
+		memset(addr_ipv4, 0, sizeof(*addr_ipv4));
+
+		addr_ipv4->sin_family      = AF_INET;
+		addr_ipv4->sin_port	       = htons(port);
+		addr_ipv4->sin_addr.s_addr = inet_addr(address);
+
+		if (addr_ipv4->sin_addr.s_addr == INADDR_NONE) {
+			struct hostent *Hostent = gethostbyname(address);
+			if (Hostent == NULL) {
+				log(L_ERROR, "Failed to get host by name: %s", strerror(errno));
+				goto err;
+			};
+			addr_ipv4->sin_addr = *(struct in_addr *)(void *)Hostent->h_addr_list[0];
+		};
+	}
+
+	struct sockaddr *addr = (struct sockaddr *)&conn->tcp_address;
+	conn->lock = shared_connection_lock_acquire_tcp(conn->shared, addr);
+	if (!conn->lock) {
+		log(L_ERROR, "Failed to acquire connection lock");
+		goto err;
+	}
+
+	return 0;
+err:
+	return -1;
+}
+
+static int com_init_serial(connection *conn)
+{
+	struct libtlt_termios_settings *s = &conn->parameters.serial;
+
+	conn->lock = shared_connection_lock_acquire_serial(conn->shared, s->device);
+	if (!conn->lock) {
+		log(L_DEBUG, "Failed to acquire serial lock");
+		goto err;
+	}
+
+	return 0;
+err:
+	return -1;
+}
