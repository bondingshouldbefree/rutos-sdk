-    gxReplyData reply;
-    message msg;
-    reply_init(&reply);
-    mes_init(&msg);
-    if ((ret = cl_disconnectRequest(&clientConnection->settings, &msg)) != 0 ||
-        (ret = com_readDataBlock(clientConnection, &msg, &reply)) != 0)
-    {
