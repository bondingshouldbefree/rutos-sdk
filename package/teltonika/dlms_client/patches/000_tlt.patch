-	spid->callbacks.complete = NULL;
-	spid->callbacks.rx       = NULL;
-	spid->callbacks.tx       = NULL;
-	uint8_t irq              = _sercom_get_irq_num(hw);
-	for (uint32_t i = 0; i < 4; i++) {
-		NVIC_DisableIRQ((IRQn_Type)irq);
-		NVIC_ClearPendingIRQ((IRQn_Type)irq);
-		irq++;
-	}
-
-	return ERR_NONE;
