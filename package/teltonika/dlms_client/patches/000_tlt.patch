+
+static struct cfgx_section *cfg_append_connection_blobmsg(cfgx_context_t *ctx, struct blob_buf *buf, struct blob_attr *msg)
+{
+	struct cfgx_section *result = NULL;
+
+	if (blob_buf_init(buf, 0)) {
+		ERROR("Failed to initialize blob_buf");
+		goto end;
+	}
+
+	if (blobmsg_add_u8(buf, "enabled", true)) {
+		ERROR("Failed to append 'enabled' option");
+		goto end;
+	}
+
+	if (blobmsg_add_u8(buf, "persistent", false)) {
+		ERROR("Failed to append 'persistent' option");
+		goto end;
+	}
+
+	if (blobmsg_add_u32(buf, "timeout", DEFAULT_CONNECTION_TIMEOUT_MS)) {
+		ERROR("Failed to append 'timeout' option");
+		goto end;
+	}
+
+	if (cfg_copy_blobmsg_fields(buf, msg)) {
+		ERROR("Failed to copy all fields from original blobmsg");
+		goto end;
+	}
+
+	struct cfgx_section *section = cfgx_context_append_section_blobmsg(ctx, buf->head);
+	if (!section) {
+		ERROR("Failed to append configuration section to context");
+		goto end;
+	}
+
+	section->type = strdup("connection");
+	if (!section->type) {
+		ERROR("Failed to duplicate string: Out of memory");
+		goto end;
+	}
+
+
+	result = section;
+end:
+	return result;
+}
+
+static struct cfgx_section *cfg_append_physical_device_blobmsg(cfgx_context_t *ctx, struct blob_buf *buf, struct blob_attr *msg, int connection_id)
+{
+	struct cfgx_section *result = NULL;
+
+	if (blob_buf_init(buf, 0)) {
+		ERROR("Failed to initialize blob_buf");
+		goto end;
+	}
+
+	if (blobmsg_add_u8(buf, "enabled", true)) {
+		ERROR("Failed to append 'enabled' option");
+		goto end;
+	}
+
+	if (connection_id != -1 && blobmsg_add_u32(buf, "connection", connection_id)) {
+		ERROR("Failed to append 'connection' option");
+		goto end;
+	}
+
+	if (cfg_copy_blobmsg_fields(buf, msg)) {
+		ERROR("Failed to copy all fields from original blobmsg");
+		goto end;
+	}
+
+	if (!cfg_blobmsg_has_field(buf->head, "name")) {
+		if (blobmsg_add_string(buf, "name", "connection")) {
+			ERROR("Failed to append 'name' option");
+			goto end;
+		}
+	}
+
+	struct cfgx_section *section = cfgx_context_append_section_blobmsg(ctx, buf->head);
+	if (!section) {
+		ERROR("Failed to append configuration section to context");
+		goto end;
+	}
+
+	section->type = strdup("physical_device");
+	if (!section->type) {
+		ERROR("Failed to duplicate string: Out of memory");
+		goto end;
+	}
+
+	result = section;
+end:
+	return result;
+}
+
+static struct cfgx_section *cfg_append_cosem_group_blobmsg(cfgx_context_t *ctx, struct blob_buf *buf)
+{
+	struct cfgx_section *result = NULL;
+
+	if (blobmsg_add_u8(buf, "enabled", true)) {
+		ERROR("Failed to append 'enabled' option");
+		goto end;
+	}
+
+	struct cfgx_section *cosem_group = cfgx_context_append_section_blobmsg(ctx, buf->head);
+	if (!cosem_group) {
+		ERROR("Failed to append configuration section to context");
+		goto end;
+	}
+
+	cosem_group->type = strdup("cosem_group");
+	if (!cosem_group->type) {
+		ERROR("Failed to duplicate string: Out of memory");
+		goto end;
+	}
+
+	result = cosem_group;
+end:
