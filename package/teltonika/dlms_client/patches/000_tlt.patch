-    uint32_t pos;
-    FILE* f = NULL;
-#if _MSC_VER > 1400
-    fopen_s(&f, fileName, "ab");
-#else
-    f = fopen(fileName, "ab");
-#endif
-    if (f != NULL)
-    {
-        fseek(f, 0, SEEK_END);
-        if ((uint32_t)ftell(f) < size)
-        {
-            for (pos = (uint32_t)ftell(f); pos != size; ++pos)
-            {
-                if (fputc(0x00, f) != 0)
-                {
-                    printf("Error Writing to %s\n", fileName);
-                    break;
-                }
-            }
-        }
-        fclose(f);
-    }
-}
