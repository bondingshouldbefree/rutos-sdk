-/**
-    * Parse AARQ request that client send and returns AARE request.
-    *
-    * @return Reply to the client.
-    */
-int svr_HandleAarqRequest(
-    dlmsServerSettings* settings,
-    gxByteBuffer* data)
-{
-    unsigned char command = 0;
-    int ret;
-    unsigned char ERROR_BUFF[4];
-    gxByteBuffer error;
