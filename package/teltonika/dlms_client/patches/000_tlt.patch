+		case DLMS_OBJECT_TYPE_CLOCK:
+			return attr_gx_clock_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_SCRIPT_TABLE:
+			return attr_gx_script_table_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_SPECIAL_DAYS_TABLE:
+			return attr_gx_special_days_table_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_ASSOCIATION_LOGICAL_NAME:
+			return attr_gx_association_logical_name_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_SAP_ASSIGNMENT:
+			return attr_gx_sap_assignment_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IMAGE_TRANSFER:
+			return attr_gx_image_transfer_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IEC_LOCAL_PORT_SETUP:
+			return attr_gx_iec_local_port_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_ACTIVITY_CALENDAR:
+			return attr_gx_activity_calendar_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_REGISTER_MONITOR:
+			return attr_gx_register_monitor_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_ACTION_SCHEDULE:
+			return attr_gx_action_schedule_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IEC_HDLC_SETUP:
+			return attr_gx_iec_hdlc_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_IEC_TWISTED_PAIR_SETUP:
+			return attr_gx_iec_twisted_pair_setup_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_UTILITY_TABLES:
+			return attr_gx_utility_tables_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_MODEM_CONFIGURATION:
+			return attr_gx_modem_configuration_to_string(ctx, attribute);
+		case DLMS_OBJECT_TYPE_AUTO_ANSWER:
