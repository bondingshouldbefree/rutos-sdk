-static int8_t _get_i2cm_index(const void *const hw)
-{
-	uint8_t sercom_offset = _sercom_get_hardware_index(hw);
-	uint8_t i;
-
-	for (i = 0; i < ARRAY_SIZE(_i2cms); i++) {
-		if (_i2cms[i].number == sercom_offset) {
-			return i;
