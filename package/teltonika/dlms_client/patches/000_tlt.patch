+int utl_reply_json(struct ubus_context *ctx, struct ubus_request_data *req, const int err_code, const char *result_json)
+{
+	int rc = 1;
+	struct blob_buf b = { 0 };
+
+	if (blob_buf_init(&b, 0)) {
+		log(L_WARNING, "Failed to initiate blob buffer");
+		goto end;
+	}
+
+	if (blobmsg_add_u32(&b, "error", err_code)) {
+		log(L_WARNING, "Failed to add integer to blob message");
+		goto end;
+	}
+
+	struct blob_attr *resultAttr = blobmsg_open_table(&b, "result");
+
+	if (!blobmsg_add_json_from_string(&b, result_json)) {
+		WARN("Failed to blobmsg_add_json_from_string blob buffer");
+		goto end;
+	}
+
+	blobmsg_close_table(&b, resultAttr);
+
+	if (ubus_send_reply(ctx, req, b.head)) {
+		log(L_WARNING, "Failed to send UBUS reply");
+		goto end;
+	}
+
+	rc = 0;
+end:
+	blob_buf_free(&b);
+	return rc;
+}
