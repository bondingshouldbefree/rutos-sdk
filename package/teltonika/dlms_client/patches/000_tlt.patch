-int32_t _spi_calc_baud_val(struct spi_dev *dev, const uint32_t clk, const uint32_t baud)
-{
-	int32_t rc;
-	ASSERT(dev);
-
-	/* Not accept 0es */
-	if (clk == 0 || baud == 0) {
-		return ERR_INVALID_ARG;
-	}
-
-	/* Check baudrate range of current assigned clock */
-	if (!(baud <= (clk >> 1) && baud >= (clk >> 8))) {
-		return ERR_INVALID_ARG;
-	}
-
-	rc = ((clk >> 1) / baud) - 1;
-	return rc;
-}
