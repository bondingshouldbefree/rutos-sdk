-int cosem_getRow(
-    gxArray* table,
-    int index,
-    gxArray* captureObjects,
-    gxArray* columns,
-    gxByteBuffer* data)
-{
-    int ret, pos;
-    dlmsVARIANT* col;
-    variantArray* row;
