-void dlms_getServerAddress(uint32_t address, uint32_t* logical, uint32_t* physical)
-{
-    if (address < 0x4000)
-    {
-        *logical = address >> 7;
-        *physical = address & 0x7F;
-    }
-    else
-    {
-        *logical = address >> 14;
-        *physical = address & 0x3FFF;
-    }
-}
