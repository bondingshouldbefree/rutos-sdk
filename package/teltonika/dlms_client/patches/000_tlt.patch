-    if (index == 1)
-    {
-#ifdef DLMS_USE_EPOCH_TIME
-        int minutes = time_getMinutes(&object->time);
-#else
-        int minutes = object->time.value.tm_min;
-#endif // DLMS_USE_EPOCH_TIME
-        if (minutes < 8)
-        {
-            minutes = 0;
-        }
-        else if (minutes < 23)
-        {
-            minutes = 15;
-        }
