+physical_device *cfg_read_physical_device_by_id(const char *section_id, shared_memory_ctx *shared)
+{
+	physical_device_cfg *dev_cfg = NULL;
+	physical_device *dev = NULL;
+
+	connection_params_cfg *con_cfg = NULL;
+	connection *con = NULL;
+
+	physical_device *result = NULL;
+
+	struct cfgx_context *ctx = cfgx_context_init_uci(CFG_NAME);
+	if (!ctx) {
+		log(L_ERROR, "Failed to allocate memory for config context");
+		return NULL;
+	}
+
+	struct cfgx_section *device_section = cfgx_context_find_by_id(ctx, section_id);
+	if (!device_section) {
+		log(L_ERROR, "Failed to find section: %s", section_id);
+		goto end;
+	}
+
+	if (strcmp(device_section->type, "physical_device")) {
+		log(L_ERROR, "Given section is not physical_device");
+		goto end;
+	}
+
+	dev_cfg = cfg_read_physical_device(ctx, device_section);
+	if (!dev_cfg) {
+		log(L_ERROR, "Failed to add physical_device_cfg");
+		goto end;
+	}
+
+	char connection_section_id[16] = { 0 };
+	snprintf(connection_section_id, 16, "%d", dev_cfg->connection);
+	struct cfgx_section *connection_section = cfgx_context_find_by_id(ctx, connection_section_id);
+	if (!connection_section) {
+		log(L_ERROR, "Failed to lookup UCI section");
+		goto end;
+	}
+
+	if (strcmp(connection_section->type, "connection")) {
+		log(L_ERROR, "Given section is not connection");
+		goto end;
+	}
+
+	con_cfg = cfg_read_connection(ctx, connection_section);
+	if (!con_cfg) {
+		log(L_ERROR, "Failed to read connection");
+		goto end;
+	}
+
+	con = cfg_get_connection(con_cfg, shared);
+	if (!con) {
+		log(L_ERROR, "Failed to get connection");
+		goto end;
+	}
+
+	dev = cfg_get_physical_device(dev_cfg);
+	if (!dev) {
+		log(L_ERROR, "Failed to get physical device");
+		goto end;
+	}
+
+	dev->connection	= con;
+	dev->id		= strtol(section_id, NULL, 10);
+
+	result = dev;
+end:
+	if (!result) {
+		cfg_free_connection(con);
+		cfg_free_physical_device(dev);
+	}
+	cfg_free_physical_device_cfg(dev_cfg);
+	cfg_free_connection_cfg(con_cfg);
+	cfgx_context_free(ctx);
+	return result;
+}
