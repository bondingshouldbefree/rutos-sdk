+void utl_assert_mutex_lock(pthread_mutex_t *mutex)
+{
+	int err = pthread_mutex_lock(mutex);
+	ASSERT(err == 0);
+}
+
+void utl_assert_mutex_unlock(pthread_mutex_t *mutex)
+{
+	int err = pthread_mutex_unlock(mutex);
+	ASSERT(err == 0);
+}
