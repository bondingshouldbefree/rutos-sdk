+static connection_params_cfg **cfg_read_connections(cfgx_context_t *ctx, size_t *result_count)
+{
+	struct cfgx_section_list section_list = { 0 };
+	connection_params_cfg **connections = NULL;
+	connection_params_cfg **result_connections = NULL;
+	size_t count = 0;
+
+	*result_count = 0;
+
+	size_t connection_count = cfgx_context_count_by_type(ctx, "connection");
+	if (connection_count > MAX_CONNECTIONS_COUNT) {
+		ERROR("Too many connections configured");
+		goto end;
+	}
+
+	if(connection_count == 0) {
+		ERROR("Failed to find any 'connections' sections");
+		goto end;
+	}
+
+	connections = calloc(connection_count, sizeof(*connections));
+	if (!connections) {
+		ERROR("Unable to allocate memory");
+		goto end;
+	}
+
+	section_list = cfgx_context_list_sections(ctx);
+
+	for (size_t i = 0; i < section_list.len; i++) {
+		struct cfgx_section *section = section_list.sections[i];
+		if (strcmp(section->type, "connection")) {
+			continue;
+		}
+
+		connection_params_cfg *conn = cfg_read_connection(ctx, section);
+		if (!conn) {
+			ERROR("Failed to read connection");
+			continue;
+		}
+
+		if (!conn->enabled) {
+			log(L_ERROR, "Connection object ('%s') is disabled", section->id);
+			cfg_free_connection_cfg(conn);
+			continue;
+		}
+
+		connections[count++] = conn;
+	}
+
+	*result_count = count;
+	result_connections = connections;
+
+end:
+	cfgx_section_list_free(section_list);
+	if (!result_connections) {
+		free(connections);
+	}
+	return result_connections;
+}
