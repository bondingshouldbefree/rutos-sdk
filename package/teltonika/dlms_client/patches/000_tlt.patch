-    cl_init(&clientCon.settings, 1, 16, 1, DLMS_AUTHENTICATION_HIGH, "Gurux", DLMS_INTERFACE_TYPE_HDLC);
-    bb_attach(&clientCon.data, CLIENT_PDU, 0, sizeof(CLIENT_PDU));
