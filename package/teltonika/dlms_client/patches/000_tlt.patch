-int cl_getRemainingFrameSize(dlmsSettings* settings, gxByteBuffer* data, uint32_t* size)
-{
-    int ret = cl_getFrameSize(settings, data, size);
-    if (ret == 0)
-    {
-        *size -= bb_available(data);
-    }
-    return ret;
-}
