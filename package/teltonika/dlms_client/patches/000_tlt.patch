+size_t utl_sockaddr_size(struct sockaddr *addr)
+{
+	if (addr->sa_family == AF_INET) {
+		return sizeof(struct sockaddr_in);
+	} else if (addr->sa_family == AF_INET6) {
+		return sizeof(struct sockaddr_in6);
+	} else {
+		return 0;
+	}
+}
+
+bool utl_sockaddr_eql(struct sockaddr *addr1, struct sockaddr *addr2)
+{
+	if (addr1->sa_family != addr2->sa_family) {
+		return false;
+	}
+
+	size_t addr_len = utl_sockaddr_size(addr1);
+	assert(addr_len > 0); // This should never be reached
+
+	return memcmp(addr1, addr2, addr_len) == 0;
+}
