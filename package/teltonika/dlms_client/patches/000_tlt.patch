-// Reserved for internal use.
-const uint32_t CRCPOLY = 0xD3B6BA00;
-uint32_t dlms_countFCS24(unsigned char* buff, int index, int count)
-{
-    unsigned char i, j;
-    uint32_t crcreg = 0;
-    for (j = 0; j < count; ++j)
-    {
-        unsigned char b = buff[index + j];
-        for (i = 0; i < 8; ++i)
-        {
-            crcreg >>= 1;
-            if ((b & 0x80) != 0)
-            {
-                crcreg |= 0x80000000;
-            }
-            if ((crcreg & 0x80) != 0)
-            {
-                crcreg = crcreg ^ CRCPOLY;
-            }
-            b <<= 1;
-        }
-    }
-    return crcreg >> 8;
-}
