-int addAssociationLow(uint16_t serializationVersion)
-{
-    int ret;
-    if (serializationVersion == 0)
-    {
-        memcpy(meterData.association.llsPassword, "Gurux", 5);
-        meterData.association.llsPasswordSize = 5;
