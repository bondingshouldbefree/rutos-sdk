-void GXTRACE(const char* str, const char* data)
-{
-	if (trace == GX_TRACE_LEVEL_VERBOSE)
-	{
-#ifdef __AVR__
-		time_t tm = time(NULL);
-		uart_traceWrite((const char*) "\t:");
-		uart_traceWrite(asctime(gmtime(&tm)));
-		uart_traceWrite((const char*) "\t");
-		uart_traceWrite(str);
-		uart_traceWrite(data);
-		uart_traceWrite((const char*) "\0");
-		_delay_ms(10);		
-#endif //__AVR__
-#ifdef __ASF__
-		delay_ms(10);
-#endif //__ASF__
-	}
-}
