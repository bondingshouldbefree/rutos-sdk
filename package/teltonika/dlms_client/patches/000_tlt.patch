-    }
-    mes_clear(&messages);
-    reply_clear(&reply);
-    if ((ret = cl_aarqRequest(&meterSettings, &messages)) != 0 ||
-        (ret = com_readDataBlock(&messages, &reply)) != 0 ||
-        (ret = cl_parseAAREResponse(&meterSettings, &reply.data)) != 0)
